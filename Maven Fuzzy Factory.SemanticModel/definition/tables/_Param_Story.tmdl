	partition _Param_Story = calculated
		mode: import
		source = DATATABLE("ChapterID", INTEGER, "ChapterName", STRING, "Timeframe", STRING, "Headline", STRING, "Commentary", STRING, "StartDate", DATETIME, "EndDate", DATETIME, {{0, "All 3 Years", "Mar 2012 – Mar 2015", "3-Year Historical Growth Journey (Mar 2012 – Mar 2015)", "Scaled from a single-product bootstrap (3.5% CVR) into an omnichannel brand with 40K+ orders, 8.44% peak CVR, and $1.85M+ net revenue.", dt"2012-03-19", dt"2015-03-19"}, {1, "Ch1 Search Launch", "Mar 2012 – Aug 2012", "Bootstrapping on Google Paid Search (Mar 2012 – Aug 2012)", "Single product (Mr. Fuzzy), high desktop dependency, baseline conversion ~3.5%.", dt"2012-03-19", dt"2012-08-31"}, {2, "Ch2 Billing Breakthrough", "Sep 2012 – Dec 2012", "Fixing the Leaky Checkout Bucket (Sep 2012 – Dec 2012)", "Billing-2 A/B test launched, lifting checkout completion from 44.8% to 63.4%.", dt"2012-09-01", dt"2012-12-31"}, {3, "Ch3 Diversification", "Jan 2013 – Jan 2014", "Expanding Search & Introducing Love Bear (Jan 2013 – Jan 2014)", "Bing paid search launched, Love Bear added, conversion crossed 6.6%.", dt"2013-01-01", dt"2014-01-31"}, {4, "Ch4 Cross-Sell Revolution", "Feb 2014 – Dec 2014", "The Hudson Mini Bear Basket Multiplier (Feb 2014 – Dec 2014)", "Mini Bear launched as cross-sell add-on, lifting AOV from $50 to $60 and pushing revenue past $1M.", dt"2014-02-01", dt"2014-12-31"}, {5, "Ch5 Scaled Maturity", "Jan 2015 – Mar 2015", "The Omnichannel High-Conversion Machine (Jan 2015 – Mar 2015)", "Conversion peaks at 8.44%, organic/direct traffic compounds, $1.85M net revenue reached.", dt"2015-01-01", dt"2015-03-19"}})

