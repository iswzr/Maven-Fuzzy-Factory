	partition Dim_Date = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2012, 1, 1), DATE(2015, 12, 31)), "Year", YEAR([Date]), "Year Label", SWITCH(YEAR([Date]), 2012, "2012*", 2015, "2015 YTD", FORMAT(YEAR([Date]), "0")), "YearMonth", FORMAT([Date], "yyyy-MM"), "MonthName", FORMAT([Date], "mmm"), "MonthNumber", MONTH([Date]), "MonthSort", YEAR([Date]) * 100 + MONTH([Date]), "Quarter", "Q" & QUARTER([Date]), "YearQuarter", YEAR([Date]) & " Q" & QUARTER([Date]), "DayOfWeek", FORMAT([Date], "ddd"), "DayOfWeekNumber", WEEKDAY([Date], 2), "IsWeekend", IF(WEEKDAY([Date], 2) >= 6, "Weekend", "Weekday"), "WeekOfYear", WEEKNUM([Date], 2), "Month Start", DATE(YEAR([Date]), MONTH([Date]), 1), "Chapter ID", SWITCH(TRUE(), [Date] > DATE(2015, 3, 31), BLANK(), [Date] >= DATE(2015, 1, 1), 5, [Date] >= DATE(2014, 2, 1), 4, [Date] >= DATE(2013, 1, 1), 3, [Date] >= DATE(2012, 9, 1), 2, [Date] >= DATE(2012, 3, 1), 1, BLANK()), "Chapter Name", SWITCH(TRUE(), [Date] > DATE(2015, 3, 31), BLANK(), [Date] >= DATE(2015, 1, 1), "Ch 5", [Date] >= DATE(2014, 2, 1), "Ch 4", [Date] >= DATE(2013, 1, 1), "Ch 3", [Date] >= DATE(2012, 9, 1), "Ch 2", [Date] >= DATE(2012, 3, 1), "Ch 1", BLANK()), "Chapter Color", SWITCH(TRUE(), [Date] > DATE(2015, 3, 31), BLANK(), [Date] >= DATE(2015, 1, 1), "#34D399", [Date] >= DATE(2014, 2, 1), "#FBBF24", [Date] >= DATE(2013, 1, 1), "#A78BFA", [Date] >= DATE(2012, 9, 1), "#22D3EE", [Date] >= DATE(2012, 3, 1), "#38BDF8", BLANK()))

