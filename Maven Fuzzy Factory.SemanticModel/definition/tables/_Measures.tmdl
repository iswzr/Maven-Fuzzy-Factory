	measure 'Header P2 HTML' =
			VAR titleText = [Page Title P2]
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #F8FAFC; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #8B95B0; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>" & titleText & "</div>
			  <div class='hdr-sub'>Sample output of the dynamic title measure " & UNICHAR(183) & " data through 19 Mar 2015</div>
			</div>"
		displayFolder: 04 Page 2 - Acquisition
		lineageTag: 15409b23-1d64-47c5-8bc7-cbcb4f4a4c19

	measure 'KPI Strip P2 HTML' =
			VAR sess = [Total Sessions]
			VAR unpSess = [Unpaid Sessions]
			VAR unpPct = [Unpaid Session %]
			VAR unpRev = [Unpaid Revenue]
			VAR mobPct = [Mobile Traffic %]
			VAR mobOrdPct = [Mobile Order %]
			VAR cvrDesk = [CVR Desktop]
			VAR cvrMob = [CVR Mobile]
			VAR cvrRatio = DIVIDE(cvrDesk, cvrMob, 0)
			
			VAR sessStr = FORMAT(sess, "#,0")
			VAR unpPctStr = IF(ISBLANK(unpPct) || unpPct = 0, "0.0%", FORMAT(unpPct, "0.0%"))
			VAR unpSessStr = IF(ISBLANK(unpSess) || unpSess = 0, "0 sessions", FORMAT(unpSess, "#,0") & " sessions")
			VAR unpRevStr = IF(ISBLANK(unpRev) || unpRev = 0, "$0", IF(unpRev >= 1000000, "$" & FORMAT(unpRev / 1000000, "0.00") & "M", "$" & FORMAT(unpRev / 1000, "0.0") & "K"))
			VAR mobPctStr = IF(ISBLANK(mobPct), "0.0%", FORMAT(mobPct, "0.0%"))
			VAR mobSubStr = "but " & FORMAT(mobOrdPct, "0.0%") & " of orders"
			VAR cvrStr = FORMAT(cvrDesk, "0.00%") & " | " & FORMAT(cvrMob, "0.00%")
			VAR cvrSubStr = IF(cvrRatio > 0, FORMAT(cvrRatio, "0.0") & UNICHAR(215) & " gap", "—")
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; width: 100%; height: 100%; }
			  .kpi-card {
			    position: relative; overflow: hidden; min-width: 0; height: 100%;
			    padding: 14px 16px 12px 16px; border-radius: 12px;
			    display: flex; flex-direction: column; justify-content: space-between;
			    background: radial-gradient(120% 100% at 100% 0%, var(--glow), transparent 62%),
			                linear-gradient(160deg, #151F3F 0%, #0A1125 100%);
			    border: 1px solid rgba(255,255,255,0.08);
			    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 8px 20px rgba(0,0,0,0.35);
			    transition: border-color .2s ease, box-shadow .2s ease;
			  }
			  .kpi-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px;
			    background: linear-gradient(90deg, var(--acc), transparent 85%); }
			  .kpi-card:hover { border-color: var(--acc); box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 22px var(--glow); }
			  .kpi-top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
			  .kpi-label { font-size:10px; color:#8FA0BC; font-weight:700; text-transform:uppercase;
			    letter-spacing:0.8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; }
			  .kpi-ico { flex:0 0 auto; width:30px; height:30px; border-radius:9px; display:flex; align-items:center; justify-content:center;
			    color:var(--acc); background: linear-gradient(145deg, var(--glow), rgba(255,255,255,0.02));
			    border:1px solid var(--glow); box-shadow: 0 0 14px var(--glow); }
			  .kpi-ico svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
			  .kpi-value { font-size: clamp(23px, 2.3vw, 30px); font-weight:800; color:var(--val-col, #F8FAFC); line-height:1.1;
			    letter-spacing:-.6px; font-variant-numeric:tabular-nums; white-space:nowrap;
			    overflow:hidden; text-overflow:ellipsis; margin:6px 0 4px; text-shadow: 0 0 18px var(--glow); }
			  .kpi-sub { align-self:flex-start; max-width:100%; font-size:10px; font-weight:600; color:var(--val-col);
			    background:var(--glow); padding:2px 8px; border-radius:999px;
			    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			</style>
			<div class='kpi-grid'>
			  <div class='kpi-card' style='--acc:#38BDF8;--glow:rgba(56,189,248,.16);--val-col:#38BDF8;'>
			    <div class='kpi-top'><div class='kpi-label'>TOTAL SESSIONS</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M3 12h4l3-8 4 16 3-8h4'/></svg></div></div>
			    <div class='kpi-value'>" & sessStr & "</div>
			    <div class='kpi-sub' style='visibility:hidden'>&nbsp;</div>
			  </div>
			  <div class='kpi-card' style='--acc:#34D399;--glow:rgba(52,211,153,.16);--val-col:#34D399;'>
			    <div class='kpi-top'><div class='kpi-label'>UNPAID TRAFFIC</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18'/></svg></div></div>
			    <div class='kpi-value'>" & unpPctStr & "</div>
			    <div class='kpi-sub'>" & unpSessStr & "</div>
			  </div>
			  <div class='kpi-card' style='--acc:#34D399;--glow:rgba(52,211,153,.16);--val-col:#34D399;'>
			    <div class='kpi-top'><div class='kpi-label'>UNPAID REVENUE</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/></svg></div></div>
			    <div class='kpi-value'>" & unpRevStr & "</div>
			    <div class='kpi-sub'>zero ad spend</div>
			  </div>
			  <div class='kpi-card' style='--acc:#FB7185;--glow:rgba(251,113,133,.16);--val-col:#FB7185;'>
			    <div class='kpi-top'><div class='kpi-label'>MOBILE SHARE OF TRAFFIC</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><rect x='7' y='2' width='10' height='20' rx='2'/><path d='M11 18h2'/></svg></div></div>
			    <div class='kpi-value'>" & mobPctStr & "</div>
			    <div class='kpi-sub'>" & mobSubStr & "</div>
			  </div>
			  <div class='kpi-card' style='--acc:#FBBF24;--glow:rgba(251,191,36,.16);--val-col:#FBBF24;'>
			    <div class='kpi-top'><div class='kpi-label'>CVR DESKTOP | MOBILE</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M22 7l-8.5 8.5-5-5L2 17M16 7h6v6'/></svg></div></div>
			    <div class='kpi-value'>" & cvrStr & "</div>
			    <div class='kpi-sub'>" & cvrSubStr & "</div>
			  </div>
			</div>"
		displayFolder: 04 Page 2 - Acquisition
		lineageTag: 045956e6-807a-48a0-a554-34b3caf6b4ff

	measure 'Channel Orders' = [Matrix Orders]
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: e996cf63-4ee5-457c-89f8-0db4c5af2cf9

	measure 'Channel Revenue' = [Matrix Revenue]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: 70108808-f46a-436c-949e-b29f487bf3ef

	measure 'Channel CVR' = [Matrix CVR %]
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: b21c9b4f-b7bc-4b8f-89ea-b65c620a7837

	measure 'Brand Sessions' = CALCULATE([Total Sessions], website_sessions[utm_campaign] = "brand")
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition
		lineageTag: a7b8c9d0-1e2f-4a5b-6c7d-8e9f0a1b2c3d

	measure 'Blended Benchmark CVR' = 0.0683
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition
		lineageTag: b8c9d0e1-2f3a-5b6c-7d8e-9f0a1b2c3d4e

	measure 'Revenue per Session' = [Matrix Rev per Session]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: f1a2b3c4-d5e6-7890-abcd-ef0123456789

	measure 'Session Share %' = [Matrix Session Share %]
		formatString: 0.0%
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: e2f3a4b5-c6d7-8901-bcde-f0123456789a

	measure 'Ref Line CVR %' =
			CALCULATE(
				VAR SessIDs = VALUES(website_sessions[website_session_id])
				VAR SessOrders =
					CALCULATE(
						COUNTROWS(orders),
						TREATAS(SessIDs, orders[website_session_id])
					)
				VAR SessCount = COUNTROWS(website_sessions)
				RETURN
				DIVIDE(SessOrders, SessCount, 0),
				ISBLANK(website_sessions[Social Experiment Segment])
			)
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 5 - Social Experiment
		lineageTag: dfff530d-3596-445c-b6f8-31f3a23c4026

	measure 'Dumbbell CVR %' =
			VAR SessIDs = VALUES(website_sessions[website_session_id])
			VAR SessOrders =
				CALCULATE(
					COUNTROWS(orders),
					TREATAS(SessIDs, orders[website_session_id])
				)
			VAR SessCount = COUNTROWS(website_sessions)
			RETURN
			DIVIDE(SessOrders, SessCount, 0)
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 3 - Dumbbell Gap
		lineageTag: c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f

	measure 'Social Experiment CVR %' =
			VAR SessIDs = VALUES(website_sessions[website_session_id])
			VAR SessOrders =
				CALCULATE(
					COUNTROWS(orders),
					TREATAS(SessIDs, orders[website_session_id])
				)
			VAR SessCount = COUNTROWS(website_sessions)
			RETURN
			DIVIDE(SessOrders, SessCount, 0)
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 5 - Social Experiment
		lineageTag: d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a

	measure 'Matrix Sessions' =
			IF(
				ISINSCOPE(_Param_Dim[Member]),
				VAR ActiveDim = SELECTEDVALUE(_Param_Dim[DimensionName], "Channel")
				VAR CurMember = SELECTEDVALUE(_Param_Dim[Member])
				VAR RowDim = SELECTEDVALUE(_Param_Dim[DimensionName])
				VAR ShouldShow = ISFILTERED(_Param_Dim[DimensionName]) || RowDim = "Channel"
				RETURN
				IF(
					NOT(ShouldShow),
					BLANK(),
					SWITCH(
						ActiveDim,
						"Channel", CALCULATE(COUNTROWS(website_sessions), website_sessions[Channel] = CurMember),
						"Device", CALCULATE(COUNTROWS(website_sessions), website_sessions[Device] = CurMember),
						"Product",
							VAR ProdUrl =
								SWITCH(
									CurMember,
									"The Original Mr. Fuzzy", "/the-original-mr-fuzzy",
									"The Forever Love Bear", "/the-forever-love-bear",
									"The Birthday Sugar Panda", "/the-birthday-sugar-panda",
									"The Hudson River Mini bear", "/the-hudson-river-mini-bear",
									BLANK()
								)
							VAR PvSess =
								CALCULATETABLE(
									VALUES(website_pageviews[website_session_id]),
									website_pageviews[pageview_url] = ProdUrl
								)
							VAR OrderSess =
								CALCULATETABLE(
									VALUES(orders[website_session_id]),
									TREATAS({CurMember}, products[product_name]),
									TREATAS(
										CALCULATETABLE(VALUES(website_sessions[website_session_id])),
										orders[website_session_id]
									)
								)
							VAR CombinedSess = DISTINCT(UNION(PvSess, OrderSess))
							RETURN
							COUNTROWS(CombinedSess),
						"Landing page", CALCULATE(COUNTROWS(website_sessions), website_sessions[Landing Page] = CurMember),
						"Campaign", CALCULATE(COUNTROWS(website_sessions), website_sessions[Campaign] = CurMember),
						CALCULATE(COUNTROWS(website_sessions), website_sessions[Channel] = CurMember)
					)
				),
				COUNTROWS(website_sessions)
			)
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8a9b

	measure 'Matrix Orders' =
			IF(
				ISINSCOPE(_Param_Dim[Member]),
				VAR ActiveDim = SELECTEDVALUE(_Param_Dim[DimensionName], "Channel")
				VAR CurMember = SELECTEDVALUE(_Param_Dim[Member])
				VAR RowDim = SELECTEDVALUE(_Param_Dim[DimensionName])
				VAR ShouldShow = ISFILTERED(_Param_Dim[DimensionName]) || RowDim = "Channel"
				RETURN
				IF(
					NOT(ShouldShow),
					BLANK(),
					SWITCH(
						ActiveDim,
						"Channel",
							CALCULATE(
								COUNTROWS(orders),
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Channel] = CurMember),
									orders[website_session_id]
								)
							),
						"Device",
							CALCULATE(
								COUNTROWS(orders),
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Device] = CurMember),
									orders[website_session_id]
								)
							),
						"Product",
							CALCULATE(
								DISTINCTCOUNT(order_items[order_id]),
								TREATAS({CurMember}, products[product_name])
							),
						"Landing page",
							CALCULATE(
								COUNTROWS(orders),
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Landing Page] = CurMember),
									orders[website_session_id]
								)
							),
						"Campaign",
							CALCULATE(
								COUNTROWS(orders),
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Campaign] = CurMember),
									orders[website_session_id]
								)
							),
						CALCULATE(
							COUNTROWS(orders),
							TREATAS(
								CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Channel] = CurMember),
								orders[website_session_id]
							)
						)
					)
				),
				CALCULATE(
					COUNTROWS(orders),
					TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id])
				)
			)
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8a9b0c

	measure 'Matrix Revenue' =
			IF(
				ISINSCOPE(_Param_Dim[Member]),
				VAR ActiveDim = SELECTEDVALUE(_Param_Dim[DimensionName], "Channel")
				VAR CurMember = SELECTEDVALUE(_Param_Dim[Member])
				VAR RowDim = SELECTEDVALUE(_Param_Dim[DimensionName])
				VAR ShouldShow = ISFILTERED(_Param_Dim[DimensionName]) || RowDim = "Channel"
				RETURN
				IF(
					NOT(ShouldShow),
					BLANK(),
					SWITCH(
						ActiveDim,
						"Channel",
							CALCULATE(
								[Gross Revenue],
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Channel] = CurMember),
									orders[website_session_id]
								)
							),
						"Device",
							CALCULATE(
								[Gross Revenue],
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Device] = CurMember),
									orders[website_session_id]
								)
							),
						"Product",
							CALCULATE(
								[Gross Revenue],
								TREATAS({CurMember}, products[product_name])
							),
						"Landing page",
							CALCULATE(
								[Gross Revenue],
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Landing Page] = CurMember),
									orders[website_session_id]
								)
							),
						"Campaign",
							CALCULATE(
								[Gross Revenue],
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Campaign] = CurMember),
									orders[website_session_id]
								)
							),
						CALCULATE(
							[Gross Revenue],
							TREATAS(
								CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Channel] = CurMember),
								orders[website_session_id]
							)
						)
					)
				),
				CALCULATE(
					[Gross Revenue],
					TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id])
				)
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: a7b8c9d0-e1f2-4a3b-4c5d-6e7f8a9b0c1d

	measure 'Matrix CVR %' = DIVIDE([Matrix Orders], [Matrix Sessions], 0)
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: b8c9d0e1-f2a3-4b4c-5d6e-7f8a9b0c1d2e

	measure 'Matrix Rev per Session' = DIVIDE([Matrix Revenue], [Matrix Sessions], 0)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: c9d0e1f2-a3b4-4c5d-6e7f-8a9b0c1d2e3f

	measure 'Matrix Session Share %' =
			IF(
				ISINSCOPE(_Param_Dim[Member]),
				VAR Tot = [Matrix Sessions]
				VAR ActiveDim = SELECTEDVALUE(_Param_Dim[DimensionName], "Channel")
				VAR ProductTotal =
					VAR S1 =
						CALCULATE(
							VAR ProdUrl = "/the-original-mr-fuzzy"
							VAR PvSess = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = ProdUrl)
							VAR OrderSess = CALCULATETABLE(VALUES(orders[website_session_id]), products[product_name] = "The Original Mr. Fuzzy", TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id]))
							RETURN COUNTROWS(DISTINCT(UNION(PvSess, OrderSess))),
							ALLSELECTED(_Param_Dim)
						)
					VAR S2 =
						CALCULATE(
							VAR ProdUrl = "/the-forever-love-bear"
							VAR PvSess = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = ProdUrl)
							VAR OrderSess = CALCULATETABLE(VALUES(orders[website_session_id]), products[product_name] = "The Forever Love Bear", TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id]))
							RETURN COUNTROWS(DISTINCT(UNION(PvSess, OrderSess))),
							ALLSELECTED(_Param_Dim)
						)
					VAR S3 =
						CALCULATE(
							VAR ProdUrl = "/the-birthday-sugar-panda"
							VAR PvSess = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = ProdUrl)
							VAR OrderSess = CALCULATETABLE(VALUES(orders[website_session_id]), products[product_name] = "The Birthday Sugar Panda", TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id]))
							RETURN COUNTROWS(DISTINCT(UNION(PvSess, OrderSess))),
							ALLSELECTED(_Param_Dim)
						)
					VAR S4 =
						CALCULATE(
							VAR ProdUrl = "/the-hudson-river-mini-bear"
							VAR PvSess = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = ProdUrl)
							VAR OrderSess = CALCULATETABLE(VALUES(orders[website_session_id]), products[product_name] = "The Hudson River Mini bear", TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id]))
							RETURN COUNTROWS(DISTINCT(UNION(PvSess, OrderSess))),
							ALLSELECTED(_Param_Dim)
						)
					RETURN
					S1 + S2 + S3 + S4
				VAR ChannelTotal =
					CALCULATE(
						[Matrix Sessions],
						ALLSELECTED(_Param_Dim[Member]),
						ALLSELECTED(_Param_Dim[MemberSort])
					)
				VAR AllTot =
					IF(ActiveDim = "Product", ProductTotal, ChannelTotal)
				RETURN
				IF(ISBLANK(Tot), BLANK(), DIVIDE(Tot, AllTot, 0)),
				1.0
			)
		formatString: 0.0%
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: d0e1f2a3-b4c5-4d6e-7f8a-9b0c1d2e3f4a

	measure 'Page Title P3' =
			VAR BlendedCVR = FORMAT([Conversion Rate %], "0.00%")
			VAR BestLander = [Best Lander Name]
			VAR BestCVR = FORMAT([Best Lander CVR], "0.00%")
			VAR YearPart =
			    IF(
			        ISFILTERED(Dim_Date[Year]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(Dim_Date[Year], "Multi-Year"),
			        ""
			    )
			VAR DevicePart =
			    IF(
			        ISFILTERED(website_sessions[Device]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(website_sessions[Device], "All Devices"),
			        ""
			    )
			VAR TrafficPart =
			    IF(
			        ISFILTERED(website_sessions[Traffic Type]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(website_sessions[Traffic Type], "All Traffic"),
			        ""
			    )
			RETURN
			    "CRO Lab " & UNICHAR(183) & " " & BlendedCVR & " blended CVR " & UNICHAR(183) & " best lander " & BestLander & " (" & BestCVR & ")" & YearPart & DevicePart & TrafficPart
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: cbbc7922-703f-4ae7-8d29-9aa6ddac15a8

	measure 'Header P3 HTML' =
			VAR titleText = [Page Title P3]
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #F8FAFC; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #8B95B0; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>" & titleText & "</div>
			  <div class='hdr-sub'>Sample output of the dynamic title measure " & UNICHAR(183) & " data through 19 Mar 2015</div>
			</div>"
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 4577f806-5809-4d3e-bf26-dbc884d14d4f

	measure 'Lander Sessions' = [Total Sessions]
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 161b62c3-8786-4a68-8423-06dd25183ffc

	measure 'Lander Orders' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE([Total Orders], TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: a761da2a-ff05-4ea8-9359-55548e1d2a04

	measure 'Lander CVR' = DIVIDE([Lander Orders], [Lander Sessions])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 35398a93-be70-4b1f-bf4b-a3a681a388e4

	measure 'Lander Bounces' = CALCULATE(COUNTROWS(website_sessions), website_sessions[Is Bounce] = 1)
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 82c18da4-167c-4912-a551-3fae2d1ffff3

	measure 'Lander Bounce Rate' = DIVIDE([Lander Bounces], [Lander Sessions])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 793acbce-1d8d-4004-b0a7-c4a6cdd0ba4f

	measure 'Best Lander Name' =
			VAR Landers =
			    ADDCOLUMNS(
			        VALUES(website_sessions[Landing Page]),
			        "L_CVR", [Lander CVR]
			    )
			VAR TopL = TOPN(1, Landers, [L_CVR], DESC)
			RETURN MAXX(TopL, website_sessions[Landing Page])
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 205aa887-c258-4453-98f8-15d0616cb4b7

	measure 'Best Lander CVR' =
			VAR Landers =
			    ADDCOLUMNS(
			        VALUES(website_sessions[Landing Page]),
			        "L_CVR", [Lander CVR]
			    )
			RETURN MAXX(Landers, [L_CVR])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 700fa8ad-42a3-4cff-982f-f6cdc301a1d4

	measure 'Lowest Bounce %' =
			VAR Landers =
			    ADDCOLUMNS(
			        VALUES(website_sessions[Landing Page]),
			        "L_Bounce", [Lander Bounce Rate]
			    )
			RETURN MINX(Landers, [L_Bounce])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: f97e5b93-3e27-4aca-b3bc-056f0f7a6b33

	measure 'Lowest Bounce Lander' =
			VAR Landers =
			    ADDCOLUMNS(
			        VALUES(website_sessions[Landing Page]),
			        "L_Bounce", [Lander Bounce Rate]
			    )
			VAR LowB = TOPN(1, Landers, [L_Bounce], ASC)
			RETURN MAXX(LowB, website_sessions[Landing Page])
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: d06bcf01-9039-41f8-87a3-269c5cb517e3

	measure 'Billing Baseline CVR' =
			VAR b1_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing")
			VAR n1 = COUNTROWS(b1_sessions)
			VAR x1 = CALCULATE([Total Orders], TREATAS(b1_sessions, orders[website_session_id]))
			RETURN DIVIDE(x1, n1)
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 20a13200-4fed-41ca-9d8e-38889b773963

	measure 'Billing Variant CVR' =
			VAR b2_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing-2")
			VAR n2 = COUNTROWS(b2_sessions)
			VAR x2 = CALCULATE([Total Orders], TREATAS(b2_sessions, orders[website_session_id]))
			RETURN DIVIDE(x2, n2)
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: e6c3f018-a66d-448c-9aee-b2fa5eca8d61

	measure 'Billing Lift pp' =
			VAR p1 = [Billing Baseline CVR]
			VAR p2 = [Billing Variant CVR]
			RETURN p2 - p1
		formatString: +0.00 pp;-0.00 pp;0.00 pp
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 37ef0623-518d-43c2-b022-1bdeb9b11f51

	measure 'Billing Z-Score' =
			VAR b1_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing")
			VAR b2_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing-2")
			VAR n1 = COUNTROWS(b1_sessions)
			VAR n2 = COUNTROWS(b2_sessions)
			VAR x1 = CALCULATE([Total Orders], TREATAS(b1_sessions, orders[website_session_id]))
			VAR x2 = CALCULATE([Total Orders], TREATAS(b2_sessions, orders[website_session_id]))
			VAR p1 = DIVIDE(x1, n1)
			VAR p2 = DIVIDE(x2, n2)
			VAR p = DIVIDE(x1 + x2, n1 + n2)
			VAR se = SQRT(p * (1 - p) * (DIVIDE(1, n1) + DIVIDE(1, n2)))
			RETURN DIVIDE(p2 - p1, se)
		formatString: 0.0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 8072b331-7c27-4fb1-a0f9-59063501b558

	measure 'Checkout Completion %' =
			VAR b_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] IN { "/billing", "/billing-2" })
			VAR n = COUNTROWS(b_sessions)
			VAR x = CALCULATE([Total Orders], TREATAS(b_sessions, orders[website_session_id]))
			RETURN DIVIDE(x, n)
		formatString: 0.0%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 1c08b40f-ff4a-4614-9f5a-000362a37c3d

	measure 'KPI Strip P3 HTML' =
			VAR bestCvr = [Best Lander CVR]
			VAR bestName = [Best Lander Name]
			VAR lowBounce = [Lowest Bounce %]
			VAR lowBounceName = [Lowest Bounce Lander]
			VAR bLift = [Billing Lift pp]
			VAR bBase = [Billing Baseline CVR]
			VAR bVar = [Billing Variant CVR]
			VAR bZ = [Billing Z-Score]
			VAR chkComp = [Checkout Completion %]
			
			VAR card1Val = IF(ISBLANK(bestCvr), "-", FORMAT(bestCvr, "0.00%"))
			VAR card1Sub = IF(ISBLANK(bestName), "-", bestName)
			
			VAR card2Val = IF(ISBLANK(lowBounce), "-", FORMAT(lowBounce, "0.00%"))
			VAR card2Sub = IF(ISBLANK(lowBounceName), "-", lowBounceName)
			
			VAR card3Val = IF(ISBLANK(bLift), "+18.57 pp", "+" & FORMAT(bLift * 100, "0.00") & " pp")
			VAR card3Sub = IF(ISBLANK(bBase) || ISBLANK(bVar), "44.79% " & UNICHAR(8594) & " 63.36%", FORMAT(bBase, "0.00%") & " " & UNICHAR(8594) & " " & FORMAT(bVar, "0.00%"))
			
			VAR card4Val = IF(ISBLANK(bZ), UNICHAR(8776) & " 22", UNICHAR(8776) & " " & FORMAT(ROUND(bZ, 0), "0"))
			VAR card4Sub = "p < 0.0001"
			
			VAR card5Val = IF(ISBLANK(chkComp), "62.1%", FORMAT(chkComp, "0.0%"))
			VAR card5Sub = "billing " & UNICHAR(8594) & " order"
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; width: 100%; height: 100%; }
			  .kpi-card {
			    position: relative; overflow: hidden; min-width: 0; height: 100%;
			    padding: 14px 16px 12px 16px; border-radius: 12px;
			    display: flex; flex-direction: column; justify-content: space-between;
			    background: radial-gradient(120% 100% at 100% 0%, var(--glow), transparent 62%),
			                linear-gradient(160deg, #151F3F 0%, #0A1125 100%);
			    border: 1px solid rgba(255,255,255,0.08);
			    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 8px 20px rgba(0,0,0,0.35);
			    transition: border-color .2s ease, box-shadow .2s ease;
			  }
			  .kpi-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px;
			    background: linear-gradient(90deg, var(--acc), transparent 85%); }
			  .kpi-card:hover { border-color: var(--acc); box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 22px var(--glow); }
			  .kpi-top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
			  .kpi-label { font-size:10px; color:#8FA0BC; font-weight:700; text-transform:uppercase;
			    letter-spacing:0.8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; }
			  .kpi-ico { flex:0 0 auto; width:30px; height:30px; border-radius:9px; display:flex; align-items:center; justify-content:center;
			    color:var(--acc); background: linear-gradient(145deg, var(--glow), rgba(255,255,255,0.02));
			    border:1px solid var(--glow); box-shadow: 0 0 14px var(--glow); }
			  .kpi-ico svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
			  .kpi-value { font-size: clamp(23px, 2.3vw, 30px); font-weight:800; color:var(--val-col, #F8FAFC); line-height:1.1;
			    letter-spacing:-.6px; font-variant-numeric:tabular-nums; white-space:nowrap;
			    overflow:hidden; text-overflow:ellipsis; margin:6px 0 4px; text-shadow: 0 0 18px var(--glow); }
			  .kpi-sub { align-self:flex-start; max-width:100%; font-size:10px; font-weight:600; color:var(--val-col);
			    background:var(--glow); padding:2px 8px; border-radius:999px;
			    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			</style>
			<div class='kpi-grid'>
			  <div class='kpi-card' style='--acc:#34D399;--glow:rgba(52,211,153,.16);--val-col:#34D399;'>
			    <div class='kpi-top'><div class='kpi-label'>BEST LANDER CVR</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3'/></svg></div></div>
			    <div class='kpi-value'>" & card1Val & "</div>
			    <div class='kpi-sub'>" & card1Sub & "</div>
			  </div>
			  <div class='kpi-card' style='--acc:#38BDF8;--glow:rgba(56,189,248,.16);--val-col:#38BDF8;'>
			    <div class='kpi-top'><div class='kpi-label'>LOWEST BOUNCE</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z'/><path d='M9 12l2 2 4-4'/></svg></div></div>
			    <div class='kpi-value'>" & card2Val & "</div>
			    <div class='kpi-sub'>" & card2Sub & "</div>
			  </div>
			  <div class='kpi-card' style='--acc:#2DD4BF;--glow:rgba(45,212,191,.16);--val-col:#2DD4BF;'>
			    <div class='kpi-top'><div class='kpi-label'>BILLING LIFT</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M22 7l-8.5 8.5-5-5L2 17M16 7h6v6'/></svg></div></div>
			    <div class='kpi-value'>" & card3Val & "</div>
			    <div class='kpi-sub'>" & card3Sub & "</div>
			  </div>
			  <div class='kpi-card' style='--acc:#38BDF8;--glow:rgba(56,189,248,.16);--val-col:#38BDF8;'>
			    <div class='kpi-top'><div class='kpi-label'>BILLING Z-SCORE</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M3 20h18M4 20c2-1 3-4 5-9 1-3 2-5 3-5s2 2 3 5c2 5 3 8 5 9'/></svg></div></div>
			    <div class='kpi-value'>" & card4Val & "</div>
			    <div class='kpi-sub'>" & card4Sub & "</div>
			  </div>
			  <div class='kpi-card' style='--acc:#FBBF24;--glow:rgba(251,191,36,.16);--val-col:#FBBF24;'>
			    <div class='kpi-top'><div class='kpi-label'>CHECKOUT COMPLETION</div>
			      <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='9' cy='20' r='1.5'/><circle cx='18' cy='20' r='1.5'/><path d='M2 3h3l2.7 11.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 7H6'/></svg></div></div>
			    <div class='kpi-value'>" & card5Val & "</div>
			    <div class='kpi-sub'>" & card5Sub & "</div>
			  </div>
			</div>"
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: f038361e-5ff2-4d3a-996c-5f97b69aa856

	measure 'VIZ-03 SESSIONS' = [Lander Sessions]
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 5b6a7c8d-9e0f-4123-b456-7a8b9c0d1e2f

	measure 'VIZ-03 BOUNCE' = [Lander Bounce Rate]
		formatString: 0.0%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 6c7d8e9f-0a1b-4234-c567-8b9c0d1e2f3a

	measure 'VIZ-03 CVR' = [Lander CVR]
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 7d8e9f0a-1b2c-4345-d678-9c0d1e2f3a4b

	measure 'VIZ-03 ORDERS' = [Lander Orders]
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 8e9f0a1b-2c3d-4456-e789-0d1e2f3a4b5c

	measure 'VIZ-03 VERDICT' =
			VAR CurrentLander = SELECTEDVALUE(website_sessions[Landing Page])
			VAR CurrentSessions = [VIZ-03 SESSIONS]
			VAR CurrentOrders = [VIZ-03 ORDERS]
			VAR CurrentCVR = [VIZ-03 CVR]
			VAR CurrentBounce = [VIZ-03 BOUNCE]
			VAR IsSingleLander = HASONEVALUE(website_sessions[Landing Page])
			
			-- Baseline metrics (/home in current filter context)
			VAR BaseSessions = CALCULATE([VIZ-03 SESSIONS], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			VAR BaseOrders = CALCULATE([VIZ-03 ORDERS], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			VAR BaseCVR = DIVIDE(BaseOrders, BaseSessions)
			VAR BaseBounce = CALCULATE([VIZ-03 BOUNCE], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			
			-- Two-proportion Z-test for A/B testing
			VAR p1 = BaseCVR
			VAR p2 = CurrentCVR
			VAR n1 = BaseSessions
			VAR n2 = CurrentSessions
			VAR p_pool = DIVIDE(BaseOrders + CurrentOrders, BaseSessions + CurrentSessions)
			VAR se = SQRT(p_pool * (1 - p_pool) * (DIVIDE(1, n1) + DIVIDE(1, n2)))
			VAR z_score = DIVIDE(p2 - p1, se)
			VAR lift = DIVIDE(p2 - p1, p1)
			VAR delta_bounce = CurrentBounce - BaseBounce
			
			RETURN
				IF(
					NOT IsSingleLander || ISBLANK(CurrentSessions) || CurrentSessions = 0,
					BLANK(),
					IF(
						CurrentLander = "/home",
						"Baseline",
						SWITCH(
							TRUE(),
							-- Low sample size test (underpowered)
							n2 < 10000 && ABS(z_score) < 1.96, "Short test",
							-- Strong statistical champion: z >= 2.58 (p < 0.01), substantial lift >= 20%, lower bounce
							z_score >= 2.58 && lift >= 0.20 && delta_bounce <= 0.01, "Champion",
							-- Statistically significant winner (z >= 1.96, p < 0.05)
							z_score >= 1.96, "Won, scaled",
							-- Statistically significant loser (z <= -1.96, p < 0.05)
							z_score <= -1.96, "Lost",
							-- Adequately powered, but no significant difference from baseline
							"Neutral / Tied"
						)
					)
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 9f0a1b2c-3d4e-4567-f890-1e2f3a4b5c6d

	measure 'VIZ-03 VERDICT Color' =
			VAR V = [VIZ-03 VERDICT]
			RETURN
				SWITCH(
					V,
					"Champion", "#34D399",
					"Won, scaled", "#60A5FA",
					"Baseline", "#94A3B8",
					"Lost", "#FB7185",
					"Short test", "#A78BFA",
					"Neutral / Tied", "#94A3B8",
					BLANK()
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 0a1b2c3d-4e5f-4678-0901-2e3f4a5b6c7d

	measure 'VIZ-03 LANDER Color' =
			VAR S = [VIZ-03 SESSIONS]
			VAR LanderName = SELECTEDVALUE(website_sessions[Landing Page])
			RETURN
				IF(
					ISBLANK(S) || S = 0,
					BLANK(),
					SWITCH(
						LanderName,
						"/home", "#94A3B8",
						"/lander-1", "#FB7185",
						"/lander-2", "#60A5FA",
						"/lander-3", "#FBBF24",
						"/lander-4", "#A78BFA",
						"/lander-5", "#34D399",
						"#94A3B8"
					)
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 1b2c3d4e-5f60-4789-1012-3e4f5a6b7c8d

	measure 'VIZ-03 LANDER Dot' =
			VAR S = [VIZ-03 SESSIONS]
			VAR LanderName = SELECTEDVALUE(website_sessions[Landing Page])
			RETURN
				IF(
					ISBLANK(S) || S = 0 || ISBLANK(LanderName),
					BLANK(),
					"●  " & LanderName
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 2c3d4e5f-6071-4890-2123-4e5f6a7b8c9d

	measure 'VIZ-03 BOUNCE Color' =
			VAR S = [VIZ-03 SESSIONS]
			VAR B = [VIZ-03 BOUNCE]
			RETURN
				IF(
					ISBLANK(S) || S = 0,
					BLANK(),
					SWITCH(
						TRUE(),
						ISBLANK(B), BLANK(),
						B >= 0.52, "#6E2232",
						B >= 0.49, "#541E2B",
						B >= 0.45, "#3D1F2B",
						B >= 0.40, "#262235",
						"#14262E"
					)
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 3d4e5f60-7182-4901-3234-5e6f7a8b9c0e

	measure 'VIZ-03 BOUNCE Font Color' =
			VAR S = [VIZ-03 SESSIONS]
			VAR B = [VIZ-03 BOUNCE]
			RETURN
				IF(ISBLANK(S) || S = 0 || ISBLANK(B), BLANK(), "#E6E9F2")
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 4e5f6071-8293-4012-4345-6e7f8a9b0c1f

	measure 'VIZ-03 CVR Bar Color' = "#176A60"
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 5f607182-93a4-4123-5456-7e8f9a0b1c20

	measure 'VIZ-03 SESSIONS Bar Color' = "#176A60"
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 60718293-a4b5-4234-6567-8e9f0a1b2c31

	measure 'VIZ-03 CVR LIFT vs Baseline' =
			VAR CurrentLander = SELECTEDVALUE(website_sessions[Landing Page])
			VAR CurrentSessions = [VIZ-03 SESSIONS]
			VAR CurrentCVR = [VIZ-03 CVR]
			VAR BaseSessions = CALCULATE([VIZ-03 SESSIONS], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			VAR BaseOrders = CALCULATE([VIZ-03 ORDERS], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			VAR p1 = DIVIDE(BaseOrders, BaseSessions)
			RETURN
				IF(
					CurrentLander = "/home" || ISBLANK(CurrentSessions) || CurrentSessions = 0 || ISBLANK(p1) || p1 = 0,
					BLANK(),
					DIVIDE(CurrentCVR - p1, p1)
				)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 718293a4-b5c6-4345-7678-9e0f1a2b3c42

	measure 'VIZ-03 BOUNCE DIFF pp' =
			VAR CurrentLander = SELECTEDVALUE(website_sessions[Landing Page])
			VAR CurrentSessions = [VIZ-03 SESSIONS]
			VAR CurrentBounce = [VIZ-03 BOUNCE]
			VAR BaseBounce = CALCULATE([VIZ-03 BOUNCE], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			RETURN
				IF(
					CurrentLander = "/home" || ISBLANK(CurrentSessions) || CurrentSessions = 0,
					BLANK(),
					CurrentBounce - BaseBounce
				)
		formatString: +0.0 pp;-0.0 pp;0.0 pp
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 8293a4b5-c6d7-4456-8789-0e1f2a3b4c53

	measure 'VIZ-03 Z-SCORE' =
			VAR CurrentLander = SELECTEDVALUE(website_sessions[Landing Page])
			VAR CurrentSessions = [VIZ-03 SESSIONS]
			VAR CurrentOrders = [VIZ-03 ORDERS]
			VAR CurrentCVR = [VIZ-03 CVR]
			VAR BaseSessions = CALCULATE([VIZ-03 SESSIONS], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			VAR BaseOrders = CALCULATE([VIZ-03 ORDERS], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			VAR p1 = DIVIDE(BaseOrders, BaseSessions)
			VAR p2 = CurrentCVR
			VAR n1 = BaseSessions
			VAR n2 = CurrentSessions
			VAR p_pool = DIVIDE(BaseOrders + CurrentOrders, BaseSessions + CurrentSessions)
			VAR se = SQRT(p_pool * (1 - p_pool) * (DIVIDE(1, n1) + DIVIDE(1, n2)))
			RETURN
				IF(
					CurrentLander = "/home" || ISBLANK(CurrentSessions) || CurrentSessions = 0 || se = 0,
					BLANK(),
					DIVIDE(p2 - p1, se)
				)
		formatString: 0.00
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: a1b2c3d4-e5f6-4789-8012-3e4f5a6b7c89

	measure 'VIZ-03 P-VALUE' =
			VAR z = ABS([VIZ-03 Z-SCORE])
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(z), BLANK(),
					z >= 2.58, "p < 0.01 (99% conf.)",
					z >= 1.96, "p < 0.05 (95% conf.)",
					z >= 1.64, "p < 0.10 (90% conf.)",
					"p >= 0.10 (Not sig.)"
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: b2c3d4e5-f6a7-4890-9123-4f5a6b7c8d90

