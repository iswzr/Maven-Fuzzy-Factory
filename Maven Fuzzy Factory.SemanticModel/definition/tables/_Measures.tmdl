	measure 'Scn Gross Revenue' = [Gross Revenue] + [Scn CVR Revenue] + [Scn Cross-Sell Revenue]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 09 Page 7 - What-If
		lineageTag: e8f1a2b3-c4d5-4678-90e5-123456789099

	measure 'Scn Gross Revenue Delta' = [Scn Gross Revenue] - [Gross Revenue]
		formatString: +\$#,0;-\$#,0;\$0
		displayFolder: 09 Page 7 - What-If
		lineageTag: e9f1a2b3-c4d5-4678-90e5-123456789098

	measure 'Scn Orders Delta' = [Scn Orders] - [Total Orders]
		formatString: +#,0;-#,0;0
		displayFolder: 09 Page 7 - What-If
		lineageTag: eaf1a2b3-c4d5-4678-90e5-123456789097

	measure 'Baseline Summary P7 HTML' =
			VAR baseOrders = [Total Orders]
			VAR baseGross = [Gross Revenue]
			VAR baseNet = [Net Revenue]
			VAR baseCVR = [Conversion Rate %]
			VAR baseAOV = [Average Order Value]
			VAR baseAttach = [Cross-Sell Attach %]
			VAR baseRefundRate = [Refund Rate %]
			VAR avgXSellPrice = [Avg Cross-Sell Price]
			
			VAR cvrLift = [CVR Lift Value]
			VAR xsellUplift = [XSell Uplift Value]
			VAR refCut = [Refund Reduction Value]
			
			VAR scnOrders = [Scn Orders]
			VAR scnOrdersDelta = scnOrders - baseOrders
			VAR scnNetRev = [Scn Net Revenue]
			VAR scnNetDelta = [Scn Net Revenue Delta]
			VAR scnCVR = [Scn CVR]
			
			VAR cvrGain = [Scn CVR Revenue]
			VAR xsellGain = [Scn Cross-Sell Revenue]
			VAR netRefGain = [Scn Refund Savings] - [Scn Incr Refunds]
			
			VAR cvrGainStr = IF(cvrGain >= 1000, "+$" & FORMAT(cvrGain / 1000, "#,0") & "K", "+$" & FORMAT(cvrGain, "#,0"))
			VAR xsellGainStr = IF(xsellGain >= 1000, "+$" & FORMAT(xsellGain / 1000, "#,0") & "K", "+$" & FORMAT(xsellGain, "#,0"))
			VAR refGainStr = IF(netRefGain >= 0, "+$", "-$") & IF(ABS(netRefGain) >= 1000, FORMAT(ABS(netRefGain) / 1000, "#,0") & "K", FORMAT(ABS(netRefGain), "#,0"))
			
			VAR cvrBps = ROUND((scnCVR - baseCVR) * 10000, 0)
			VAR cvrBpsStr = IF(cvrBps >= 0, "+", "") & FORMAT(cvrBps, "#,0") & " bps"
			
			VAR presetName =
				IF(
					ISFILTERED(_Param_ScenarioPreset[Preset]),
					SELECTEDVALUE(_Param_ScenarioPreset[Preset], "Custom sliders"),
					"Custom sliders"
				)
			VAR isTuningActive = ISFILTERED(_Param_CVR_Tuning[Label]) || ISFILTERED(_Param_Attach_Tuning[Label]) || ISFILTERED(_Param_Refund_Tuning[Label])
			VAR isPresetActive = presetName <> "Custom sliders"
			VAR badgeLabel = IF(isTuningActive, "CUSTOM TUNED", IF(isPresetActive, UPPER(presetName), "CUSTOM SLIDERS"))
			VAR badgeBg = IF(isTuningActive, "#EFF6FF", IF(isPresetActive, "#EEF2FF", "#F1F5F9"))
			VAR badgeColor = IF(isTuningActive, "#1D4ED8", IF(isPresetActive, "#4F46E5", "#64748B"))
			VAR badgeBorder = IF(isTuningActive, "#BFDBFE", IF(isPresetActive, "#C7D2FE", "#CBD5E1"))
			
			VAR cvrStr = IF(cvrLift >= 0, "+", "") & FORMAT(cvrLift, "0%")
			VAR cvrPct = MAX(4, MIN(96, (cvrLift - (-0.20)) / 0.70 * 100))
			
			VAR attachVal = ROUND(xsellUplift * 100, 0)
			VAR attachStr = IF(attachVal >= 0, "+", "") & FORMAT(attachVal, "0") & " pp"
			VAR attachPct = MAX(4, MIN(96, xsellUplift / 0.40 * 100))
			
			VAR refCutStr = IF(refCut >= 0, "+", "") & FORMAT(refCut, "0%")
			VAR refCutPct = MAX(4, MIN(96, refCut / 0.50 * 100))
			
			VAR netDeltaStr =
				IF(
					ABS(scnNetDelta) >= 1000000,
					(IF(scnNetDelta >= 0, "+$", "-$") & FORMAT(ABS(scnNetDelta) / 1000000, "0.00") & "M"),
					IF(
						ABS(scnNetDelta) >= 1000,
						(IF(scnNetDelta >= 0, "+$", "-$") & FORMAT(ABS(scnNetDelta) / 1000, "#,0") & "K"),
						IF(scnNetDelta >= 0, "+$", "-$") & FORMAT(ABS(scnNetDelta), "#,0")
					)
				)
			VAR netPctGrowth = DIVIDE(scnNetDelta, baseNet, 0)
			VAR totGain = MAX(1, ABS(cvrGain) + ABS(xsellGain) + ABS(netRefGain))
			VAR cvrShare = FORMAT(ABS(cvrGain) / totGain * 100, "0")
			VAR attShare = FORMAT(ABS(xsellGain) / totGain * 100, "0")
			VAR refShare = FORMAT(ABS(netRefGain) / totGain * 100, "0")
			VAR growthStr = IF(netPctGrowth >= 0, "+", "") & FORMAT(netPctGrowth, "0.0%")
			
			VAR basePct = MIN(100, DIVIDE(baseNet, scnNetRev, 1) * 100)
			VAR basePctStr = FORMAT(basePct, "0.0")
			VAR upPctStr = FORMAT(100 - basePct, "0.0")
			VAR baseNetStr = "$" & FORMAT(baseNet / 1000000, "0.00") & "M"
			
			RETURN
			"<style>
			* { box-sizing:border-box; margin:0; padding:0; font-family:'Segoe UI Variable','Segoe UI',-apple-system,sans-serif; }
			html,body { width:100%; height:100vh; overflow:hidden; background:transparent; user-select:none; }
			svg { fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
			.wrap { width:100%; height:100vh; min-height:420px; padding:16px 18px; display:flex; flex-direction:column; gap:12px; position:relative; overflow:hidden;
			  background:#FFFFFF; border:1px solid #CBD5E1; border-radius:12px; box-shadow:0 2px 8px rgba(15,23,42,.06); }
			.wrap::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#1D4ED8,#D97706 50%,#E11D48); }
			.hdr { display:flex; align-items:center; justify-content:space-between; flex:0 0 auto; }
			.hl { display:flex; align-items:center; gap:10px; }
			.hi { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; color:#1D4ED8; background:#EFF6FF; border:1px solid #BFDBFE; }
			.hi svg { width:17px; height:17px; }
			.ht { font-size:15px; font-weight:800; color:#0F172A; letter-spacing:-.2px; line-height:1.1; }
			.hs { font-size:9.5px; color:#64748B; font-weight:600; margin-top:2px; }
			.badge { padding:4px 10px; border-radius:999px; font-size:9.5px; font-weight:800; letter-spacing:.6px; background:" & badgeBg & "; color:" & badgeColor & "; border:1px solid " & badgeBorder & "; }
			.sl { display:flex; flex-direction:column; gap:10px; flex:0 0 auto; }
			.s { padding:10px 12px; border-radius:8px; background:#F8FAFC; border:1px solid #E2E8F0; }
			.sm { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
			.sl-l { display:flex; align-items:center; gap:7px; font-size:11.5px; font-weight:700; color:#1E293B; }
			.sl-l i { width:8px; height:8px; border-radius:50%; background:var(--c); }
			.sv { font-size:16px; font-weight:900; color:var(--c); letter-spacing:-.3px; }
			.tw { position:relative; height:16px; display:flex; align-items:center; }
			.tb { position:absolute; left:0; right:0; height:8px; border-radius:999px; background:#E2E8F0; }
			.tk { position:absolute; left:0; right:0; height:8px; border-radius:999px; background:repeating-linear-gradient(90deg, transparent 0 calc(10% - 1px), rgba(15,23,42,.06) calc(10% - 1px) 10%); }
			.tf { position:absolute; left:0; height:8px; border-radius:999px; background:var(--c); }
			.th { position:absolute; top:50%; width:18px; height:18px; border-radius:50%; transform:translate(-50%,-50%); background:#FFFFFF; border:3px solid var(--c); box-shadow:0 1px 4px rgba(15,23,42,.2); }
			.dr { flex:0 0 auto; display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
			.d { padding:9px 10px; border-radius:8px; background:var(--bg); border:1px solid var(--bd); }
			.dl { display:flex; align-items:center; gap:5px; font-size:9px; font-weight:750; color:#475569; text-transform:uppercase; letter-spacing:.5px; }
			.dl svg { width:12px; height:12px; color:var(--c); }
			.dv { font-size:18px; font-weight:900; color:var(--c); margin:3px 0 6px; letter-spacing:-.4px; }
			.db { height:5px; border-radius:999px; background:#E2E8F0; overflow:hidden; }
			.db i { display:block; height:100%; border-radius:999px; background:var(--c); }
			.dp { font-size:8.5px; color:#64748B; font-weight:600; margin-top:3px; }
			.bt { flex:0 0 auto; font-size:9.5px; font-weight:800; color:#475569; letter-spacing:.8px; text-transform:uppercase; margin-bottom:-4px; }
			.bs { flex:0 0 auto; display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
			.bc { padding:6px 8px; border-radius:6px; background:#F8FAFC; border:1px solid #E2E8F0; }
			.bc span { display:block; font-size:8.5px; color:#64748B; font-weight:700; letter-spacing:.5px; text-transform:uppercase; }
			.bc b { font-size:12.5px; color:#0F172A; font-weight:800; }
			.hero { flex:1 1 auto; min-height:110px; padding:14px 16px; border-radius:10px; display:flex; flex-direction:column; justify-content:space-between; position:relative; overflow:hidden;
			  background:linear-gradient(135deg, #ECFDF5 0%, #FFFFFF 100%);
			  border:1px solid #A7F3D0; box-shadow:0 2px 8px rgba(5,150,105,.08); }
			.ht2 { display:flex; justify-content:space-between; align-items:flex-start; }
			.hl2 { font-size:10.5px; font-weight:800; color:#065F46; letter-spacing:.8px; text-transform:uppercase; }
			.gp { padding:3px 10px; border-radius:999px; font-size:11px; font-weight:800; color:#059669; background:#D1FAE5; border:1px solid #A7F3D0; }
			.hv { font-size:38px; font-weight:900; line-height:1; letter-spacing:-1.2px; color:#059669; margin:6px 0; }
			.mx { margin:2px 0 0; }
			.mxl { display:flex; justify-content:space-between; font-size:9px; font-weight:800; color:#475569; letter-spacing:.7px; text-transform:uppercase; margin-bottom:5px; }
			.mxb { display:flex; gap:3px; height:10px; }
			.mxb i { display:block; height:100%; border-radius:999px; min-width:6px; }
			.lgd { display:flex; justify-content:space-between; margin-top:5px; font-size:9.5px; font-weight:700; color:#475569; }
			.lgd u { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:5px; text-decoration:none; }
			.bd { display:flex; height:14px; border-radius:999px; overflow:hidden; background:#E2E8F0; }
			.bd i { display:block; height:100%; }
			.bdl { display:flex; justify-content:space-between; margin-top:5px; font-size:9.5px; font-weight:700; color:#475569; }
			.bdl b { color:#0F172A; }
			.hm { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
			.hm div { padding:6px 8px; border-radius:6px; background:#FFFFFF; border:1px solid #CBD5E1; font-size:8.5px; color:#64748B; font-weight:700; text-transform:uppercase; letter-spacing:.5px; }
			.hm b { display:block; font-size:13px; color:#0F172A; font-weight:800; letter-spacing:0; text-transform:none; margin-top:1px; }
			.hm small { font-size:9.5px; font-weight:700; }
			.ft { flex:0 0 auto; display:flex; align-items:center; gap:7px; font-size:9.5px; color:#64748B; }
			.pd { width:7px; height:7px; border-radius:50%; background:#059669; }
			</style>
			<div class='wrap'>
			<div class='hdr'><div class='hl'><div class='hi'><svg viewBox='0 0 24 24'><path d='M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6'/></svg></div>
			<div><div class='ht'>What-if controls</div><div class='hs'>Scenario simulator & lever model</div></div></div>
			<span class='badge'>" & badgeLabel & "</span></div>
			
			<div class='sl'>
			<div class='s' style='--c:#1D4ED8'><div class='sm'><span class='sl-l'><i></i>CVR lift (relative)</span><span class='sv'>" & cvrStr & "</span></div>
			<div class='tw'><div class='tb'></div><div class='tf' style='width:" & FORMAT(cvrPct, "0.0") & "%'></div><div class='tk'></div><div class='th' style='left:" & FORMAT(cvrPct, "0.0") & "%'></div></div></div>
			<div class='s' style='--c:#D97706'><div class='sm'><span class='sl-l'><i></i>Cross-sell attach uplift</span><span class='sv'>" & attachStr & "</span></div>
			<div class='tw'><div class='tb'></div><div class='tf' style='width:" & FORMAT(attachPct, "0.0") & "%'></div><div class='tk'></div><div class='th' style='left:" & FORMAT(attachPct, "0.0") & "%'></div></div></div>
			<div class='s' style='--c:#E11D48'><div class='sm'><span class='sl-l'><i></i>Refund reduction (relative)</span><span class='sv'>" & refCutStr & "</span></div>
			<div class='tw'><div class='tb'></div><div class='tf' style='width:" & FORMAT(refCutPct, "0.0") & "%'></div><div class='tk'></div><div class='th' style='left:" & FORMAT(refCutPct, "0.0") & "%'></div></div></div>
			</div>
			
			<div class='dr'>
			<div class='d' style='--c:#1D4ED8;--bg:#EFF6FF;--bd:#BFDBFE'><div class='dl'><svg viewBox='0 0 24 24'><path d='M22 7l-8.5 8.5-5-5L2 17M16 7h6v6'/></svg>CVR lift</div><div class='dv'>" & cvrGainStr & "</div><div class='db'><i style='width:" & cvrShare & "%'></i></div><div class='dp'>" & cvrShare & "% of upside</div></div>
			<div class='d' style='--c:#D97706;--bg:#FEF3C7;--bd:#FDE68A'><div class='dl'><svg viewBox='0 0 24 24'><circle cx='9' cy='20' r='1.5'/><circle cx='18' cy='20' r='1.5'/><path d='M2 3h3l2.7 11.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 7H6'/></svg>Attach</div><div class='dv'>" & xsellGainStr & "</div><div class='db'><i style='width:" & attShare & "%'></i></div><div class='dp'>" & attShare & "% of upside</div></div>
			<div class='d' style='--c:#E11D48;--bg:#FFE4E6;--bd:#FECDD3'><div class='dl'><svg viewBox='0 0 24 24'><path d='M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5'/></svg>Refund cut</div><div class='dv'>" & refGainStr & "</div><div class='db'><i style='width:" & refShare & "%'></i></div><div class='dp'>" & refShare & "% of upside</div></div>
			</div>
			
			<div class='bt'>Baseline (full period)</div>
			<div class='bs'>
			<div class='bc'><span>CVR</span><b>" & FORMAT(baseCVR, "0.00%") & "</b></div>
			<div class='bc'><span>AOV</span><b>$" & FORMAT(baseAOV, "0.00") & "</b></div>
			<div class='bc'><span>Attach</span><b>" & FORMAT(baseAttach, "0.00%") & "</b></div>
			<div class='bc'><span>Refunds</span><b>" & FORMAT(baseRefundRate, "0.00%") & "</b></div>
			</div>
			
			<div class='hero'>
			<div><div class='ht2'><span class='hl2'>Scenario net upside</span><span class='gp'>" & growthStr & " vs base</span></div>
			<div class='hv'>" & netDeltaStr & "</div></div>
			
			<div class='mx'><div class='mxl'><span>Upside mix</span><span>Share of gain</span></div>
			<div class='mxb'><i style='flex:" & cvrShare & ";background:#1D4ED8'></i><i style='flex:" & attShare & ";background:#D97706'></i><i style='flex:" & refShare & ";background:#E11D48'></i></div>
			<div class='lgd'><span><u style='background:#1D4ED8'></u>CVR " & cvrShare & "%</span><span><u style='background:#D97706'></u>Attach " & attShare & "%</span><span><u style='background:#E11D48'></u>Refund " & refShare & "%</span></div></div>
			
			<div class='mx'><div class='mxl'><span>Net revenue build</span><span>Baseline + upside</span></div>
			<div class='bd'><i style='width:" & basePctStr & "%;background:#94A3B8'></i><i style='width:" & upPctStr & "%;background:#059669'></i></div>
			<div class='bdl'><span>Base <b>" & baseNetStr & "</b></span><span>Scenario <b style='color:#059669'>$" & FORMAT(scnNetRev / 1000000, "0.00") & "M</b></span></div></div>
			
			<div class='hm'>
			<div>Net revenue<b>$" & FORMAT(scnNetRev / 1000000, "0.00") & "M</b></div>
			<div>Scenario CVR<b style='color:#1D4ED8'>" & FORMAT(scnCVR, "0.00%") & " <small>" & cvrBpsStr & "</small></b></div>
			<div>Orders<b>" & FORMAT(scnOrders, "#,0") & " <small style='color:#059669'>" & IF(scnOrdersDelta >= 0, "+", "") & FORMAT(scnOrdersDelta, "#,0") & "</small></b></div>
			</div></div>
			
			<div class='ft'><div class='pd'></div><span>Active simulation &bull; data through 19 Mar 2015</span></div>
			</div>"
		displayFolder: 09 Page 7 - What-If
		lineageTag: ebf1a2b3-c4d5-4678-90e5-123456789096

	measure 'Scenario KPI Strip P7 HTML' =
			VAR baseOrders = [Total Orders]
			VAR scnOrders = [Scn Orders]
			VAR deltaOrders = scnOrders - baseOrders
			VAR pctOrders = DIVIDE(deltaOrders, baseOrders, 0)
			
			VAR baseGross = [Gross Revenue]
			VAR scnGross = [Scn Gross Revenue]
			VAR deltaGross = scnGross - baseGross
			VAR pctGross = DIVIDE(deltaGross, baseGross, 0)
			
			VAR baseNet = [Net Revenue]
			VAR scnNet = [Scn Net Revenue]
			VAR deltaNet = scnNet - baseNet
			VAR pctNet = DIVIDE(deltaNet, baseNet, 0)
			
			VAR baseCVR = [Conversion Rate %]
			VAR scnCVR = [Scn CVR]
			VAR bpsCVR = ROUND((scnCVR - baseCVR) * 10000, 0)
			
			VAR scnOrdersStr = FORMAT(scnOrders, "#,0")
			VAR baseOrdersStr = FORMAT(baseOrders, "#,0")
			VAR deltaOrdersStr = IF(deltaOrders >= 0, "+", "") & FORMAT(deltaOrders, "#,0")
			VAR pctOrdersStr = IF(pctOrders >= 0, "+", "") & FORMAT(pctOrders, "0.0%")
			
			VAR scnGrossStr = "$" & FORMAT(scnGross / 1000000, "0.00") & "M"
			VAR baseGrossStr = "$" & FORMAT(baseGross / 1000000, "0.00") & "M"
			VAR deltaGrossStr =
				IF(
					ABS(deltaGross) >= 1000000,
					IF(deltaGross >= 0, "+$", "-$") & FORMAT(ABS(deltaGross) / 1000000, "0.00") & "M",
					IF(
						ABS(deltaGross) >= 1000,
						IF(deltaGross >= 0, "+$", "-$") & FORMAT(ABS(deltaGross) / 1000, "#,0") & "K",
						IF(deltaGross >= 0, "+$", "-$") & FORMAT(ABS(deltaGross), "#,0")
					)
				)
			VAR pctGrossStr = IF(pctGross >= 0, "+", "") & FORMAT(pctGross, "0.0%")
			
			VAR scnNetStr = "$" & FORMAT(scnNet / 1000000, "0.00") & "M"
			VAR baseNetStr = "$" & FORMAT(baseNet / 1000000, "0.00") & "M"
			VAR deltaNetStr =
				IF(
					ABS(deltaNet) >= 1000000,
					IF(deltaNet >= 0, "+$", "-$") & FORMAT(ABS(deltaNet) / 1000000, "0.00") & "M",
					IF(
						ABS(deltaNet) >= 1000,
						IF(deltaNet >= 0, "+$", "-$") & FORMAT(ABS(deltaNet) / 1000, "#,0") & "K",
						IF(deltaNet >= 0, "+$", "-$") & FORMAT(ABS(deltaNet), "#,0")
					)
				)
			VAR pctNetStr = IF(pctNet >= 0, "+", "") & FORMAT(pctNet, "0.0%")
			
			VAR scnCVRStr = FORMAT(scnCVR, "0.00%")
			VAR baseCVRStr = FORMAT(baseCVR, "0.00%")
			VAR bpsCVRStr = IF(bpsCVR >= 0, "+", "") & FORMAT(bpsCVR, "#,0") & " bps"
			
			VAR tgtCVR = [Benchmark CVR Target]
			VAR tgtName = [Benchmark Target Name]
			VAR tgtDiffBps = ROUND((scnCVR - tgtCVR) * 10000, 0)
			VAR tgtDiffStr = IF(tgtDiffBps >= 0, "+", "") & FORMAT(tgtDiffBps, "#,0") & " bps"
			VAR tgtColor = IF(tgtDiffBps >= 0, "#059669", "#E11D48")
			
			RETURN
			"<style>
			* { box-sizing:border-box; margin:0; padding:0; font-family:'Segoe UI Variable','Segoe UI',-apple-system,sans-serif; }
			html,body { width:100%; height:100vh; overflow:hidden; background:transparent; user-select:none; }
			svg { fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
			.cards-grid { width:100%; height:100vh; display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
			.card { height:100%; border-radius:8px; padding:13px 16px 14px; display:flex; flex-direction:column; justify-content:space-between; position:relative; overflow:hidden;
			  background:#FFFFFF;
			  border:1px solid #CBD5E1; border-top:3px solid var(--c);
			  box-shadow:0 2px 6px rgba(15,23,42,.06);
			  transition:transform .18s ease, border-color .18s ease; }
			.card:hover { transform:translateY(-2px); border-color:var(--c); }
			.hd { display:flex; align-items:center; justify-content:space-between; gap:8px; }
			.hl { display:flex; align-items:center; gap:9px; min-width:0; }
			.ico { flex:0 0 auto; width:30px; height:30px; border-radius:8px; display:flex; align-items:center; justify-content:center; color:var(--c);
			  background:var(--bg); border:1px solid var(--bd); }
			.ico svg { width:16px; height:16px; }
			.lbl { font-size:10.5px; font-weight:750; color:#475569; letter-spacing:.7px; text-transform:uppercase; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			.pill { flex:0 0 auto; display:flex; align-items:center; gap:3px; font-size:9.5px; font-weight:800; padding:3px 8px; border-radius:999px; color:var(--c);
			  background:var(--bg); border:1px solid var(--bd); }
			.pill svg { width:9px; height:9px; stroke-width:3; }
			.val { font-size:30px; font-weight:900; color:#0F172A; letter-spacing:-.8px; line-height:1.1; margin:4px 0 2px; white-space:nowrap; font-variant-numeric:tabular-nums; }
			.sub { display:flex; align-items:center; gap:7px; font-size:11px; font-weight:600; color:#64748B; padding-top:8px; border-top:1px solid #E2E8F0; }
			.sub em { font-style:normal; font-size:8.5px; font-weight:700; color:#475569; letter-spacing:.6px; text-transform:uppercase; }
			.sub .dl { font-weight:800; color:var(--c); margin-left:auto; }
			</style>
			<div class='cards-grid'>
			
			<div class='card' style='--c:#4F46E5;--bg:#EEF2FF;--bd:#C7D2FE'>
			  <div class='hd'><div class='hl'><div class='ico'><svg viewBox='0 0 24 24'><path d='M21 8l-9-5-9 5v8l9 5 9-5V8z'/><path d='M3 8l9 5 9-5M12 13v8'/></svg></div><span class='lbl'>Orders</span></div>
			  <span class='pill'><svg viewBox='0 0 24 24'><path d='M12 19V5M5 12l7-7 7 7'/></svg>" & pctOrdersStr & "</span></div>
			  <div class='val'>" & scnOrdersStr & "</div>
			  <div class='sub'><em>Base</em><span>" & baseOrdersStr & "</span><span class='dl'>" & deltaOrdersStr & "</span></div>
			</div>
			
			<div class='card' style='--c:#0284C7;--bg:#F0F9FF;--bd:#BAE6FD'>
			  <div class='hd'><div class='hl'><div class='ico'><svg viewBox='0 0 24 24'><rect x='2' y='6' width='20' height='12' rx='2'/><circle cx='12' cy='12' r='3'/><path d='M6 12h.01M18 12h.01'/></svg></div><span class='lbl'>Gross revenue</span></div>
			  <span class='pill'><svg viewBox='0 0 24 24'><path d='M12 19V5M5 12l7-7 7 7'/></svg>" & pctGrossStr & "</span></div>
			  <div class='val'>" & scnGrossStr & "</div>
			  <div class='sub'><em>Base</em><span>" & baseGrossStr & "</span><span class='dl'>" & deltaGrossStr & "</span></div>
			</div>
			
			<div class='card' style='--c:#059669;--bg:#D1FAE5;--bd:#A7F3D0'>
			  <div class='hd'><div class='hl'><div class='ico'><svg viewBox='0 0 24 24'><circle cx='8' cy='8' r='6'/><path d='M18.09 10.37A6 6 0 1 1 10.34 18M7 6h1v4M16.71 13.88l.7.71-2.82 2.82'/></svg></div><span class='lbl'>Net revenue</span></div>
			  <span class='pill'><svg viewBox='0 0 24 24'><path d='M12 19V5M5 12l7-7 7 7'/></svg>" & pctNetStr & "</span></div>
			  <div class='val'>" & scnNetStr & "</div>
			  <div class='sub'><em>Base</em><span>" & baseNetStr & "</span><span class='dl'>" & deltaNetStr & "</span></div>
			</div>
			
			<div class='card' style='--c:#1D4ED8;--bg:#EFF6FF;--bd:#BFDBFE'>
			  <div class='hd'><div class='hl'><div class='ico'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><circle cx='12' cy='12' r='6'/><circle cx='12' cy='12' r='2'/></svg></div><span class='lbl'>Scenario CVR</span></div>
			  <span class='pill'><svg viewBox='0 0 24 24'><path d='M12 19V5M5 12l7-7 7 7'/></svg>" & bpsCVRStr & "</span></div>
			  <div class='val'>" & scnCVRStr & "</div>
			  <div class='sub'><em>Base</em><span>" & baseCVRStr & "</span><span class='dl' style='color:" & tgtColor & "'>vs " & tgtName & " " & tgtDiffStr & "</span></div>
			</div>
			
			</div>"
		displayFolder: 09 Page 7 - What-If
		lineageTag: f1a2b3c4-d5e6-4789-a012-345678901234

	measure 'What-If Deep Dive P7 HTML' =
			-- Levers
			VAR cvrLift = [CVR Lift Value]
			VAR xsellUplift = [XSell Uplift Value]
			VAR refCutVal = [Refund Reduction Value]
			
			-- Base KPIs
			VAR baseOrders = [Total Orders]
			VAR baseGross = [Gross Revenue]
			VAR baseNet = [Net Revenue]
			VAR baseCVR = [Conversion Rate %]
			VAR baseAOV = [Average Order Value]
			VAR baseAttach = [Cross-Sell Attach %]
			VAR baseRefunds = [Total Refunds]
			VAR avgPrice = [Avg Cross-Sell Price]
			VAR rfRate = [Refund Rate %]
			
			-- Scenario KPIs
			VAR scnOrders = [Scn Orders]
			VAR scnNet = [Scn Net Revenue]
			VAR scnCVR = [Scn CVR]
			
			-- Benchmark
			VAR tgtCVR = [Benchmark CVR Target]
			VAR tgtName = [Benchmark Target Name]
			VAR tgtDiffPp = (scnCVR - tgtCVR) * 100
			VAR tgtDiffBps = ROUND((scnCVR - tgtCVR) * 10000, 0)
			VAR tgtColor = IF(tgtDiffBps >= 0, "#059669", "#E11D48")
			
			-- Waterfall Values
			VAR cvrGain = [Scn CVR Revenue]
			VAR xsellGain = [Scn Cross-Sell Revenue]
			VAR refSav = [Scn Refund Savings]
			VAR incrRef = [Scn Incr Refunds]
			VAR netRefCutGain = refSav - incrRef
			VAR netDelta = [Scn Net Revenue Delta]
			
			-- Axis scaling (Q1)
			VAR scnNetCalc = baseNet + cvrGain + xsellGain + netRefCutGain
			VAR maxVal = MAX(baseNet, scnNetCalc) * 1.06
			VAR minVal = baseNet * 0.70
			VAR vRange = maxVal - minVal
			VAR plotH = 220.0
			VAR baseNetH = MAX(10.0, (baseNet - minVal) / vRange * plotH)
			VAR y1 = 245.0 - baseNetH
			VAR h1 = baseNetH
			
			VAR y2_top = 245.0 - (baseNet + cvrGain - minVal) / vRange * plotH
			VAR y2_bot = y1
			VAR h2 = MAX(4.0, ABS(y2_bot - y2_top))
			
			VAR y3_top = 245.0 - (baseNet + cvrGain + xsellGain - minVal) / vRange * plotH
			VAR y3_bot = y2_top
			VAR h3 = MAX(4.0, ABS(y3_bot - y3_top))
			
			VAR y4_next = 245.0 - (scnNetCalc - minVal) / vRange * plotH
			VAR y4_bot = y3_top
			VAR y4_top = MIN(y4_bot, y4_next)
			VAR h4 = MAX(4.0, ABS(y4_bot - y4_next))
			
			VAR scnNetH = MAX(10.0, (scnNet - minVal) / vRange * plotH)
			VAR y5 = 245.0 - scnNetH
			VAR h5 = scnNetH
			
			-- Formatted strings (Q1)
			VAR baseNetFmt = "$" & FORMAT(baseNet / 1000000, "0.00") & "M"
			VAR cvrGainFmt = IF(cvrGain >= 1000, "+$" & FORMAT(cvrGain / 1000, "#,0") & "K", "+$" & FORMAT(cvrGain, "#,0"))
			VAR xsellGainFmt = IF(xsellGain >= 1000, "+$" & FORMAT(xsellGain / 1000, "#,0") & "K", "+$" & FORMAT(xsellGain, "#,0"))
			VAR netRefFmt = IF(netRefCutGain >= 0, "+$", "-$") & IF(ABS(netRefCutGain) >= 1000, FORMAT(ABS(netRefCutGain) / 1000, "#,0") & "K", FORMAT(ABS(netRefCutGain), "#,0"))
			VAR scnNetFmt = "$" & FORMAT(scnNet / 1000000, "0.00") & "M"
			VAR netRefGrad = IF(netRefCutGain >= 0, "url(#rGrad)", "url(#rGrad)")
			VAR netRefColor = IF(netRefCutGain >= 0, "#E11D48", "#E11D48")
			
			-- Q2: TORNADO / LEVER IMPACT
			VAR cvrAbs = ABS(cvrGain)
			VAR xsellAbs = ABS(xsellGain)
			VAR refAbs = ABS(netRefCutGain)
			VAR maxLever = MAX(1.0, MAX(cvrAbs, MAX(xsellAbs, refAbs)))
			
			VAR cvrBarPct = MIN(100.0, cvrAbs / maxLever * 100.0)
			VAR xsellBarPct = MIN(100.0, xsellAbs / maxLever * 100.0)
			VAR refBarPct = MIN(100.0, refAbs / maxLever * 100.0)
			
			VAR cvrValFmt = IF(cvrGain >= 0, "+$", "-$") & IF(cvrAbs >= 1000, FORMAT(cvrAbs / 1000, "#,0") & "K", FORMAT(cvrAbs, "#,0"))
			VAR xsellValFmt = IF(xsellGain >= 0, "+$", "-$") & IF(xsellAbs >= 1000, FORMAT(xsellAbs / 1000, "#,0") & "K", FORMAT(xsellAbs, "#,0"))
			VAR refValFmt = IF(netRefCutGain >= 0, "+$", "-$") & IF(refAbs >= 1000, FORMAT(refAbs / 1000, "#,0") & "K", FORMAT(refAbs, "#,0"))
			
			VAR cvrLbl = "CVR Lift (" & (IF(cvrLift >= 0, "+", "") & FORMAT(cvrLift, "0%")) & ")"
			VAR xsellLbl = "Cross-Sell (" & (IF(xsellUplift >= 0, "+", "") & FORMAT(ROUND(xsellUplift * 100, 0), "0") & "pp") & ")"
			VAR refLbl = "Refund Cut (" & (IF(refCutVal >= 0, "-", "") & FORMAT(refCutVal, "0%")) & ")"
			VAR totNetUpsideFmt = IF(netDelta >= 0, "+$", "-$") & IF(ABS(netDelta) >= 1000000, FORMAT(ABS(netDelta) / 1000000, "0.00") & "M", IF(ABS(netDelta) >= 1000, FORMAT(ABS(netDelta) / 1000, "#,0") & "K", FORMAT(ABS(netDelta), "#,0")))
			
			-- Q3: SENSITIVITY GRID
			VAR o0 = baseOrders * (1.0 - 0.10)
			VAR o1 = baseOrders * (1.0 + 0.00)
			VAR o2 = baseOrders * (1.0 + 0.10)
			VAR o3 = baseOrders * (1.0 + 0.20)
			VAR o4 = baseOrders * (1.0 + 0.30)
			
			VAR cg0 = (o0 - baseOrders) * baseAOV
			VAR cg1 = (o1 - baseOrders) * baseAOV
			VAR cg2 = (o2 - baseOrders) * baseAOV
			VAR cg3 = (o3 - baseOrders) * baseAOV
			VAR cg4 = (o4 - baseOrders) * baseAOV
			
			VAR g00 = cg0 + (o0 * 0.00 * avgPrice) - ((cg0 + o0 * 0.00 * avgPrice) * rfRate) + ((baseRefunds + (cg0 + o0 * 0.00 * avgPrice) * rfRate) * refCutVal)
			VAR g01 = cg1 + (o1 * 0.00 * avgPrice) - ((cg1 + o1 * 0.00 * avgPrice) * rfRate) + ((baseRefunds + (cg1 + o1 * 0.00 * avgPrice) * rfRate) * refCutVal)
			VAR g02 = cg2 + (o2 * 0.00 * avgPrice) - ((cg2 + o2 * 0.00 * avgPrice) * rfRate) + ((baseRefunds + (cg2 + o2 * 0.00 * avgPrice) * rfRate) * refCutVal)
			VAR g03 = cg3 + (o3 * 0.00 * avgPrice) - ((cg3 + o3 * 0.00 * avgPrice) * rfRate) + ((baseRefunds + (cg3 + o3 * 0.00 * avgPrice) * rfRate) * refCutVal)
			VAR g04 = cg4 + (o4 * 0.00 * avgPrice) - ((cg4 + o4 * 0.00 * avgPrice) * rfRate) + ((baseRefunds + (cg4 + o4 * 0.00 * avgPrice) * rfRate) * refCutVal)
			
			VAR g10 = cg0 + (o0 * 0.05 * avgPrice) - ((cg0 + o0 * 0.05 * avgPrice) * rfRate) + ((baseRefunds + (cg0 + o0 * 0.05 * avgPrice) * rfRate) * refCutVal)
			VAR g11 = cg1 + (o1 * 0.05 * avgPrice) - ((cg1 + o1 * 0.05 * avgPrice) * rfRate) + ((baseRefunds + (cg1 + o1 * 0.05 * avgPrice) * rfRate) * refCutVal)
			VAR g12 = cg2 + (o2 * 0.05 * avgPrice) - ((cg2 + o2 * 0.05 * avgPrice) * rfRate) + ((baseRefunds + (cg2 + o2 * 0.05 * avgPrice) * rfRate) * refCutVal)
			VAR g13 = cg3 + (o3 * 0.05 * avgPrice) - ((cg3 + o3 * 0.05 * avgPrice) * rfRate) + ((baseRefunds + (cg3 + o3 * 0.05 * avgPrice) * rfRate) * refCutVal)
			VAR g14 = cg4 + (o4 * 0.05 * avgPrice) - ((cg4 + o4 * 0.05 * avgPrice) * rfRate) + ((baseRefunds + (cg4 + o4 * 0.05 * avgPrice) * rfRate) * refCutVal)
			
			VAR g20 = cg0 + (o0 * 0.10 * avgPrice) - ((cg0 + o0 * 0.10 * avgPrice) * rfRate) + ((baseRefunds + (cg0 + o0 * 0.10 * avgPrice) * rfRate) * refCutVal)
			VAR g21 = cg1 + (o1 * 0.10 * avgPrice) - ((cg1 + o1 * 0.10 * avgPrice) * rfRate) + ((baseRefunds + (cg1 + o1 * 0.10 * avgPrice) * rfRate) * refCutVal)
			VAR g22 = cg2 + (o2 * 0.10 * avgPrice) - ((cg2 + o2 * 0.10 * avgPrice) * rfRate) + ((baseRefunds + (cg2 + o2 * 0.10 * avgPrice) * rfRate) * refCutVal)
			VAR g23 = cg3 + (o3 * 0.10 * avgPrice) - ((cg3 + o3 * 0.10 * avgPrice) * rfRate) + ((baseRefunds + (cg3 + o3 * 0.10 * avgPrice) * rfRate) * refCutVal)
			VAR g24 = cg4 + (o4 * 0.10 * avgPrice) - ((cg4 + o4 * 0.10 * avgPrice) * rfRate) + ((baseRefunds + (cg4 + o4 * 0.10 * avgPrice) * rfRate) * refCutVal)
			
			VAR g30 = cg0 + (o0 * 0.15 * avgPrice) - ((cg0 + o0 * 0.15 * avgPrice) * rfRate) + ((baseRefunds + (cg0 + o0 * 0.15 * avgPrice) * rfRate) * refCutVal)
			VAR g31 = cg1 + (o1 * 0.15 * avgPrice) - ((cg1 + o1 * 0.15 * avgPrice) * rfRate) + ((baseRefunds + (cg1 + o1 * 0.15 * avgPrice) * rfRate) * refCutVal)
			VAR g32 = cg2 + (o2 * 0.15 * avgPrice) - ((cg2 + o2 * 0.15 * avgPrice) * rfRate) + ((baseRefunds + (cg2 + o2 * 0.15 * avgPrice) * rfRate) * refCutVal)
			VAR g33 = cg3 + (o3 * 0.15 * avgPrice) - ((cg3 + o3 * 0.15 * avgPrice) * rfRate) + ((baseRefunds + (cg3 + o3 * 0.15 * avgPrice) * rfRate) * refCutVal)
			VAR g34 = cg4 + (o4 * 0.15 * avgPrice) - ((cg4 + o4 * 0.15 * avgPrice) * rfRate) + ((baseRefunds + (cg4 + o4 * 0.15 * avgPrice) * rfRate) * refCutVal)
			
			VAR g40 = cg0 + (o0 * 0.20 * avgPrice) - ((cg0 + o0 * 0.20 * avgPrice) * rfRate) + ((baseRefunds + (cg0 + o0 * 0.20 * avgPrice) * rfRate) * refCutVal)
			VAR g41 = cg1 + (o1 * 0.20 * avgPrice) - ((cg1 + o1 * 0.20 * avgPrice) * rfRate) + ((baseRefunds + (cg1 + o1 * 0.20 * avgPrice) * rfRate) * refCutVal)
			VAR g42 = cg2 + (o2 * 0.20 * avgPrice) - ((cg2 + o2 * 0.20 * avgPrice) * rfRate) + ((baseRefunds + (cg2 + o2 * 0.20 * avgPrice) * rfRate) * refCutVal)
			VAR g43 = cg3 + (o3 * 0.20 * avgPrice) - ((cg3 + o3 * 0.20 * avgPrice) * rfRate) + ((baseRefunds + (cg3 + o3 * 0.20 * avgPrice) * rfRate) * refCutVal)
			VAR g44 = cg4 + (o4 * 0.20 * avgPrice) - ((cg4 + o4 * 0.20 * avgPrice) * rfRate) + ((baseRefunds + (cg4 + o4 * 0.20 * avgPrice) * rfRate) * refCutVal)
			
			VAR maxG = MAX(1000.0, g44)
			VAR minG = MIN(0.0, g00)
			
			-- Active cell index
			VAR actCol = ROUND(cvrLift / 0.10, 0)
			VAR actRow = ROUND(xsellUplift / 0.05, 0)
			
			-- Q4: BULLET GRAPH
			VAR bMin = 0.040
			VAR bMax = 0.095
			VAR bRange = bMax - bMin
			
			VAR baseCVRPct = MIN(100, MAX(0, (baseCVR - bMin) / bRange * 100))
			VAR scnCVRPct = MIN(100, MAX(0, (scnCVR - bMin) / bRange * 100))
			VAR tgtCVRPct = MIN(100, MAX(0, (tgtCVR - bMin) / bRange * 100))
			
			VAR baseCVRFmt = FORMAT(baseCVR, "0.00%")
			VAR scnCVRFmt = FORMAT(scnCVR, "0.00%")
			VAR tgtCVRFmt = FORMAT(tgtCVR, "0.00%")
			VAR tgtDeltaFmt = IF(tgtDiffPp >= 0, "+", "") & FORMAT(tgtDiffPp, "0.00") & " pp vs target"
			
			RETURN
			"<style>
			* { box-sizing:border-box; margin:0; padding:0; font-family:'Segoe UI Variable','Segoe UI',-apple-system,sans-serif; }
			html,body { width:100%; height:100vh; overflow:hidden; background:transparent; user-select:none; }
			svg { overflow:visible; }
			.deep-grid { width:100%; height:100vh; display:grid; grid-template-columns:1.08fr 0.92fr; grid-template-rows:1fr 1fr; gap:14px; }
			.qc { height:100%; border-radius:8px; padding:14px 16px 12px; display:flex; flex-direction:column; justify-content:space-between;
			  background:#FFFFFF; border:1px solid #CBD5E1; position:relative; overflow:hidden;
			  box-shadow:0 2px 6px rgba(15,23,42,.06); transition:border-color .18s ease; }
			.qc:hover { border-color:#94A3B8; }
			.qc-hdr { display:flex; align-items:center; justify-content:flex-start; flex:0 0 auto; margin-bottom:8px; }
			.qc-title { font-size:13px; font-weight:750; color:#0F172A; letter-spacing:-.15px; }
			
			/* Q1 Waterfall */
			.wf-wrap { flex:1 1 auto; width:100%; display:flex; align-items:center; justify-content:center; }
			.wl { font-size:11px; font-weight:800; font-variant-numeric:tabular-nums; }
			.xl { font-size:10px; font-weight:600; fill:#475569; }
			.xs { font-size:8px; font-weight:600; fill:#64748B; font-style:italic; }
			.wcl { stroke:#CBD5E1; stroke-dasharray:3 3; stroke-width:1; }
			
			/* Q2 Lever Impact */
			.t-wrap { flex:1 1 auto; display:flex; flex-direction:column; justify-content:center; gap:16px; padding:4px 6px; }
			.t-row { display:flex; align-items:center; gap:12px; }
			.t-lbl { flex:0 0 135px; font-size:11.5px; font-weight:700; color:#1E293B; }
			.t-track { flex:1 1 auto; height:24px; border-radius:6px; background:#E2E8F0; overflow:hidden; position:relative; }
			.t-bar { height:100%; border-radius:5px; transition:width .3s ease; }
			.t-val { flex:0 0 65px; font-size:13px; font-weight:900; text-align:right; font-variant-numeric:tabular-nums; }
			.t-foot { font-size:9.5px; color:#64748B; padding-top:6px; border-top:1px solid #E2E8F0; display:flex; justify-content:space-between; }
			
			/* Q3 Heatmap */
			.h-table { width:100%; border-collapse:separate; border-spacing:3px; flex:1 1 auto; }
			.h-table th { font-size:9.5px; font-weight:750; color:#475569; text-align:center; padding:4px 2px; text-transform:uppercase; letter-spacing:.4px; }
			.h-table th.rh { text-align:left; font-size:9px; color:#475569; white-space:nowrap; padding-right:6px; }
			.h-table td { font-size:11px; font-weight:800; text-align:center; padding:7px 2px; border-radius:6px; font-variant-numeric:tabular-nums; border:1px solid #E2E8F0; transition:transform .15s ease; color:#0F172A; }
			.h-table td:hover { transform:scale(1.05); z-index:5; box-shadow:0 2px 8px rgba(5,150,105,.3); border-color:#059669; }
			.h-table td.act { border:2px solid #059669 !important; outline:2px solid #059669 !important; background:#D1FAE5 !important; position:relative; font-weight:900; }
			
			/* Q4 Bullet */
			.b-wrap { flex:1 1 auto; display:flex; flex-direction:column; justify-content:center; gap:22px; padding:8px 8px; }
			.b-row { display:flex; flex-direction:column; gap:6px; }
			.b-info { display:flex; justify-content:space-between; align-items:center; }
			.b-lbl { font-size:11.5px; font-weight:700; color:#475569; }
			.b-val { font-size:14px; font-weight:900; color:#0F172A; font-variant-numeric:tabular-nums; }
			.b-track { width:100%; height:14px; border-radius:999px; background:#E2E8F0; position:relative; }
			.b-fill { height:100%; border-radius:999px; }
			.b-fill.base { background:#94A3B8; }
			.b-fill.scn { background:linear-gradient(90deg,#1D4ED8,#3B82F6); }
			.b-tgt { position:absolute; top:-6px; bottom:-6px; width:3px; border-radius:2px; background:#4F46E5; transform:translateX(-50%); z-index:3; }
			.b-sub { display:flex; align-items:center; gap:8px; font-size:11px; padding-top:10px; border-top:1px solid #E2E8F0; color:#64748B; }
			.b-pip { width:3px; height:14px; border-radius:2px; background:#4F46E5; }
			</style>
			
			<div class='deep-grid'>
			
			  <!-- Q1: NET REVENUE BRIDGE -->
			  <div class='qc'>
			    <div class='qc-hdr'>
			      <div class='qc-title'>Net revenue bridge: baseline &rarr; scenario</div>
			    </div>
			    <div class='wf-wrap'>
			      <svg viewBox='0 0 540 282' width='100%' height='100%'>
			        <defs>
			          <linearGradient id='baseGrad' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='#64748B'/><stop offset='100%' stop-color='#334155'/></linearGradient>
			          <linearGradient id='cvrGrad' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='#3B82F6'/><stop offset='100%' stop-color='#1D4ED8'/></linearGradient>
			          <linearGradient id='attGrad' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='#F59E0B'/><stop offset='100%' stop-color='#D97706'/></linearGradient>
			          <linearGradient id='rGrad' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='#FB7185'/><stop offset='100%' stop-color='#E11D48'/></linearGradient>
			          <linearGradient id='scnGrad' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='#10B981'/><stop offset='100%' stop-color='#059669'/></linearGradient>
			        </defs>
			        <line x1='16' y1='245' x2='518' y2='245' stroke='#E2E8F0' stroke-width='1'/>
			
			        <!-- Bar 1: Base -->
			        <rect x='28' y='" & y1 & "' width='64' height='" & h1 & "' rx='4' fill='url(#baseGrad)'/>
			        <text x='60' y='" & (y1 - 7) & "' text-anchor='middle' class='wl' fill='#334155'>" & baseNetFmt & "</text>
			        <line x1='92' y1='" & y1 & "' x2='132' y2='" & y1 & "' class='wcl'/>
			
			        <!-- Bar 2: CVR Lift -->
			        <rect x='132' y='" & y2_top & "' width='64' height='" & h2 & "' rx='4' fill='url(#cvrGrad)'/>
			        <text x='164' y='" & (y2_top - 7) & "' text-anchor='middle' class='wl' fill='#1D4ED8'>" & cvrGainFmt & "</text>
			        <line x1='196' y1='" & y2_top & "' x2='236' y2='" & y2_top & "' class='wcl'/>
			
			        <!-- Bar 3: Cross-sell Attach -->
			        <rect x='236' y='" & y3_top & "' width='64' height='" & h3 & "' rx='4' fill='url(#attGrad)'/>
			        <text x='268' y='" & (y3_top - 7) & "' text-anchor='middle' class='wl' fill='#D97706'>" & xsellGainFmt & "</text>
			        <line x1='300' y1='" & y3_top & "' x2='340' y2='" & y3_top & "' class='wcl'/>
			
			        <!-- Bar 4: Refund Cut -->
			        <rect x='340' y='" & y4_top & "' width='64' height='" & h4 & "' rx='4' fill='url(#rGrad)'/>
			        <text x='372' y='" & (y4_top - 7) & "' text-anchor='middle' class='wl' fill='#E11D48'>" & netRefFmt & "</text>
			        <line x1='404' y1='" & y4_next & "' x2='444' y2='" & y4_next & "' class='wcl'/>
			
			        <!-- Bar 5: Scenario -->
			        <rect x='444' y='" & y5 & "' width='64' height='" & h5 & "' rx='4' fill='url(#scnGrad)'/>
			        <text x='476' y='" & (y5 - 7) & "' text-anchor='middle' class='wl' fill='#059669'>" & scnNetFmt & "</text>
			
			        <!-- X Labels -->
			        <text x='60' y='262' text-anchor='middle' class='xl'>Baseline</text>
			        <text x='164' y='262' text-anchor='middle' class='xl'>CVR lift</text>
			        <text x='268' y='262' text-anchor='middle' class='xl'>Cross-sell</text>
			        <text x='372' y='262' text-anchor='middle' class='xl'>Refund cut</text>
			        <text x='476' y='262' text-anchor='middle' class='xl'>Scenario</text>
			        <text x='476' y='275' text-anchor='middle' class='xs'>axis truncated</text>
			      </svg>
			    </div>
			  </div>
			
			  <!-- Q2: LEVER IMPACT -->
			  <div class='qc'>
			    <div class='qc-hdr'>
			      <div class='qc-title'>Lever impact</div>
			    </div>
			    <div class='t-wrap'>
			      <div class='t-row'>
			        <span class='t-lbl'>" & cvrLbl & "</span>
			        <div class='t-track'><div class='t-bar' style='width:" & FORMAT(cvrBarPct, "0.0") & "%;background:linear-gradient(90deg,#1D4ED8,#3B82F6)'></div></div>
			        <span class='t-val' style='color:#1D4ED8'>" & cvrValFmt & "</span>
			      </div>
			      <div class='t-row'>
			        <span class='t-lbl'>" & xsellLbl & "</span>
			        <div class='t-track'><div class='t-bar' style='width:" & FORMAT(xsellBarPct, "0.0") & "%;background:linear-gradient(90deg,#D97706,#F59E0B)'></div></div>
			        <span class='t-val' style='color:#D97706'>" & xsellValFmt & "</span>
			      </div>
			      <div class='t-row'>
			        <span class='t-lbl'>" & refLbl & "</span>
			        <div class='t-track'><div class='t-bar' style='width:" & FORMAT(refBarPct, "0.0") & "%;background:linear-gradient(90deg,#E11D48,#FB7185)'></div></div>
			        <span class='t-val' style='color:#E11D48'>" & refValFmt & "</span>
			      </div>
			    </div>
			    <div class='t-foot'><span>Active slider net contribution</span><span>Net upside: <b style='color:#059669'>" & totNetUpsideFmt & "</b></span></div>
			  </div>
			
			  <!-- Q3: SENSITIVITY GRID -->
			  <div class='qc'>
			    <div class='qc-hdr'>
			      <div class='qc-title'>Sensitivity grid: CVR lift &times; cross-sell uplift</div>
			    </div>
			    <table class='h-table'>
			      <tr><th></th><th>CVR -10%</th><th>CVR +0%</th><th>CVR +10%</th><th>CVR +20%</th><th>CVR +30%</th></tr>
			
			      <!-- Row 0 -->
			      <tr><th class='rh'>XSell +0pp</th>
			        <td class='" & IF(actRow=0 && actCol=0, "act", "") & "' style='background:rgba(5,150,105," & FORMAT(MIN(0.65, MAX(0.08, g00/maxG * 0.65)), "0.00") & ")'>" & IF(g00>=1000000, "$" & FORMAT(g00/1000000, "0.00") & "M", "$" & FORMAT(g00/1000, "0.0") & "K") & "</td>
			        <td class='" & IF(actRow=0 && actCol=1, "act", "") & "' style='background:rgba(5,150,105," & FORMAT(MIN(0.65, MAX(0.08, g01/maxG * 0.65)), "0.00") & ")'>" & IF(g01>=1000000, "$" & FORMAT(g01/1000000, "0.00") & "M", "$" & FORMAT(g01/1000, "#,0") & "K") & "</td>
			        <td class='" & IF(actRow=0 && actCol=2, "act", "") & "' style='background:rgba(5,150,105," & FORMAT(MIN(0.65, MAX(0.08, g02/maxG * 0.65)), "0.00") & ")'>" & IF(g02>=1000000, "$" & FORMAT(g02/1000000, "0.00") & "M", "$" & FORMAT(g02/1000, "#,0") & "K") & "</td>
