	measure 'VIZ-05 SESSIONS' =
			VAR StepNum = SELECTEDVALUE(_Dim_FunnelStep[StepNumber])
			RETURN
				SWITCH(
					StepNum,
					1, COUNTROWS(website_sessions),
					2, CALCULATE(DISTINCTCOUNT(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/products"),
					3, CALCULATE(DISTINCTCOUNT(website_pageviews[website_session_id]), website_pageviews[Page Category] = "Product Detail"),
					4, CALCULATE(DISTINCTCOUNT(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/cart"),
					5, CALCULATE(DISTINCTCOUNT(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/shipping"),
					6, CALCULATE(DISTINCTCOUNT(website_pageviews[website_session_id]), website_pageviews[pageview_url] IN {"/billing", "/billing-2"}),
					7, CALCULATE(DISTINCTCOUNT(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/thank-you-for-your-order"),
					COUNTROWS(website_sessions)
				)
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: 10a65f17-733d-4a28-96ee-42a4f41cfe77

	measure 'VIZ-05 PREVIOUS SESSIONS' =
			VAR StepNum = SELECTEDVALUE(_Dim_FunnelStep[StepNumber])
			RETURN
				IF(
					StepNum <= 1,
					BLANK(),
					CALCULATE(
						[VIZ-05 SESSIONS],
						_Dim_FunnelStep[StepNumber] = StepNum - 1,
						ALLSELECTED(_Dim_FunnelStep)
					)
				)
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: cf9b7ce6-2621-4700-9b8e-d2428243a917

	measure 'VIZ-05 SESSIONS % OF TOTAL' =
			VAR Curr = [VIZ-05 SESSIONS]
			VAR TotalSess = CALCULATE([VIZ-05 SESSIONS], _Dim_FunnelStep[StepNumber] = 1, ALLSELECTED(_Dim_FunnelStep))
			RETURN
				DIVIDE(Curr, TotalSess)
		formatString: 0.0%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: 82194be2-75ba-40d9-b28f-ab56851a9c1c

	measure 'VIZ-05 SESSIONS LABEL' =
			VAR S = [VIZ-05 SESSIONS]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(S), BLANK(),
					S >= 1000000, FORMAT(S / 1000000, "0.0") & "M",
					S >= 100000, FORMAT(S / 1000, "0") & "K",
					S >= 1000, FORMAT(S / 1000, "0.0") & "K",
					FORMAT(S, "#,0")
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: a7e171da-3a55-4b7b-8e9c-548437eff9ff

	measure 'VIZ-05 STEP CVR' =
			VAR StepNum = SELECTEDVALUE(_Dim_FunnelStep[StepNumber])
			VAR Curr = [VIZ-05 SESSIONS]
			VAR Prev = [VIZ-05 PREVIOUS SESSIONS]
			RETURN
				IF(
					StepNum = 1,
					BLANK(),
					DIVIDE(Curr, Prev)
				)
		formatString: 0.0%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: 41091c1c-9b78-4f66-8481-dac8803ebd1d

	measure 'VIZ-05 STEP CVR LABEL' =
			VAR StepNum = SELECTEDVALUE(_Dim_FunnelStep[StepNumber])
			VAR CVR = [VIZ-05 STEP CVR]
			RETURN
				IF(
					StepNum = 1,
					"—",
					FORMAT(CVR, "0.0%")
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: 5f464bd8-41d5-4924-99ca-c8a66f777e00

	measure 'VIZ-05 DROP OFF %' =
			VAR StepNum = SELECTEDVALUE(_Dim_FunnelStep[StepNumber])
			VAR CVR = [VIZ-05 STEP CVR]
			RETURN
				IF(StepNum = 1, BLANK(), 1 - CVR)
		formatString: 0.0%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: 7345e87d-1cdf-4005-822a-2c6f75d4fec7

	measure 'VIZ-05 DROP OFF LABEL' =
			VAR D = [VIZ-05 DROP OFF %]
			RETURN
				IF(ISBLANK(D), BLANK(), FORMAT(D, "0.0%"))
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: 014b6014-3119-4a77-a46d-4c768c7ea290

	measure 'VIZ-05 BAR COLOR' =
			VAR StepNum = SELECTEDVALUE(_Dim_FunnelStep[StepNumber])
			VAR StepCVR = [VIZ-05 STEP CVR]
			VAR MinCVR =
				MINX(
					FILTER(ALLSELECTED(_Dim_FunnelStep), _Dim_FunnelStep[StepNumber] >= 2),
					[VIZ-05 STEP CVR]
				)
			RETURN
				IF(StepNum >= 2 && StepCVR = MinCVR, "#FB7185", "#60A5FA")
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: ba881f1f-4cf9-42cb-88f7-661e0e059d1a

	measure 'VIZ-05 CVR COLOR' =
			VAR StepNum = SELECTEDVALUE(_Dim_FunnelStep[StepNumber])
			VAR StepCVR = [VIZ-05 STEP CVR]
			VAR MinCVR =
				MINX(
					FILTER(ALLSELECTED(_Dim_FunnelStep), _Dim_FunnelStep[StepNumber] >= 2),
					[VIZ-05 STEP CVR]
				)
			RETURN
				IF(StepNum >= 2 && StepCVR = MinCVR, "#FB7185", "#8B95B0")
		displayFolder: 05 Page 3 - CRO Lab\VIZ-05 Checkout Funnel
		lineageTag: bbc16e3b-9f23-4e46-bf31-c67ea9ef7fb0

	measure 'VIZ-06 SESSIONS' =
