			CALCULATE(
				[Gross Revenue],
				TREATAS(
					CALCULATETABLE(
						VALUES(website_sessions[website_session_id]),
						KEEPFILTERS(website_sessions[Traffic Type] IN {"Organic", "Direct"})
					),
					orders[website_session_id]
				)
			)
