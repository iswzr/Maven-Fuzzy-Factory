	measure 'VIZ-06 BAR COLOR' =
			VAR VariantName = SELECTEDVALUE(_Dim_BillingVariant[Billing Variant])
			RETURN
				SWITCH(
					VariantName,
					"/billing", "#FB7185",
					"/billing-2", "#34D399",
					"#64748B"
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-06 Billing AB Test
		lineageTag: eb99b316-09b4-4f80-831f-7dbeb40c4298

	measure 'VIZ-06 LIFT ANNOTATION' =
			VAR b1_cvr = CALCULATE([VIZ-06 CVR], _Dim_BillingVariant[Billing Variant] = "/billing", ALL(_Dim_BillingVariant))
			VAR b2_cvr = CALCULATE([VIZ-06 CVR], _Dim_BillingVariant[Billing Variant] = "/billing-2", ALL(_Dim_BillingVariant))
			VAR absLift = b2_cvr - b1_cvr
			VAR relLift = DIVIDE(absLift, b1_cvr)
			RETURN
				"+" & FORMAT(absLift * 100, "0.00") & " pp · +" & FORMAT(relLift, "0.0%") & " relative"
		displayFolder: 05 Page 3 - CRO Lab\VIZ-06 Billing AB Test
		lineageTag: a67387c8-2798-4687-9cd9-2a4bfdf52313

