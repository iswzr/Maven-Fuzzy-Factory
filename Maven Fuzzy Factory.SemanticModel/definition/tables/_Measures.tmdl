			  <!-- Q4: SCENARIO CVR VS BENCHMARK -->
			  <div class='qc'>
			    <div class='qc-hdr'>
			      <div class='qc-title'>Scenario CVR vs benchmark</div>
			    </div>
			    <div class='b-wrap'>
			      <div class='b-row'>
			        <div class='b-info'><span class='b-lbl'>Baseline CVR</span><b class='b-val'>" & baseCVRFmt & "</b></div>
			        <div class='b-track'>
			          <div class='b-fill base' style='width:" & FORMAT(baseCVRPct, "0.0") & "%'></div>
			          <div class='b-tgt' style='left:" & FORMAT(tgtCVRPct, "0.0") & "%'></div>
			        </div>
			      </div>
			      <div class='b-row'>
			        <div class='b-info'><span class='b-lbl'>Scenario CVR</span><b class='b-val' style='color:#1D4ED8'>" & scnCVRFmt & "</b></div>
			        <div class='b-track'>
			          <div class='b-fill scn' style='width:" & FORMAT(scnCVRPct, "0.0") & "%'></div>
			          <div class='b-tgt' style='left:" & FORMAT(tgtCVRPct, "0.0") & "%'></div>
			        </div>
			      </div>
			      <div class='b-sub'><span class='b-pip'></span><span><b style='color:#4F46E5'>" & tgtName & " " & tgtCVRFmt & "</b> &bull; <b style='color:" & tgtColor & "'>" & tgtDeltaFmt & " (" & (IF(tgtDiffBps >= 0, "+", "") & FORMAT(tgtDiffBps, "#,0") & " bps)") & "</b></span></div>
			    </div>
			  </div>
			
			</div>"
		displayFolder: 09 Page 7 - What-If
		lineageTag: c1d2e3f4-a5b6-4789-9012-345678909876

	measure 'Header P1 HTML' =
			VAR ch = SELECTEDVALUE(_Param_Story[ChapterName], "All 3 Years")
			VAR isAll = (ch = "All 3 Years" || ISBLANK(ch))
			
			VAR rev = [Revenue (Chapter)]
			VAR cvr = [Conversion Rate % (Chapter)]
			VAR ords = [Orders (Chapter)]
			VAR sess = [Sessions (Chapter)]
			VAR aov = [AOV (Chapter)]
			VAR margin = [Gross Margin % (Chapter)]
			
			VAR revStr = IF(rev >= 1000000, "$" & FORMAT(rev / 1000000, "0.00") & "M", "$" & FORMAT(rev / 1000, "#,0") & "K")
			VAR cvrStr = FORMAT(cvr, "0.00%")
			VAR ordsStr = FORMAT(ords, "#,0")
			VAR sessStr = FORMAT(sess, "#,0")
			VAR aovStr = FORMAT(aov, "$#,0.00")
			VAR marginStr = FORMAT(margin, "0.0%")
			
			VAR ChapterPart =
				IF(
					NOT isAll,
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#D97706;font-weight:700'>" & ch & "</span>",
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#4F46E5;font-weight:700'>2012–2015</span>"
				)
			
			VAR Headline = [Story Headline Text]
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #0F172A; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #475569; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>Storyboard <span style='color:#CBD5E1'>&bull;</span> <span style='color:#0D9488;font-weight:800'>" & revStr & "</span> <span style='font-size:16px;font-weight:500;color:#64748B'>net rev</span> <span style='color:#CBD5E1'>&bull;</span> <span style='color:#1D4ED8;font-weight:800'>" & cvrStr & "</span> <span style='font-size:16px;font-weight:500;color:#64748B'>CVR</span>" & ChapterPart & "</div>
			  <div class='hdr-sub'>" & ordsStr & " orders (" & aovStr & " AOV) &bull; " & sessStr & " sessions &bull; " & marginStr & " margin &bull; " & Headline & "</div>
			</div>"
		displayFolder: 02 Page 1 - Storyboard
		lineageTag: e1a2b3c4-5d6e-4789-9012-345678901201

	column Dummy
		lineageTag: 3ce5026e-32f8-4521-831e-9fe6f7d36d85
		isNameInferred
		sourceColumn: [Dummy]

	partition _Measures = calculated
		mode: import
		source = ROW("Dummy", 1)

	annotation PBI_Id = df809e40-3777-4b37-9982-dd29e3d502c8

