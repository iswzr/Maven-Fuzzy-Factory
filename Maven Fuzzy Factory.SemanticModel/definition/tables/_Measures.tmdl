	measure 'Revenue per Session' = [Matrix Rev per Session]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: f1a2b3c4-d5e6-7890-abcd-ef0123456789

	measure 'Session Share %' = [Matrix Session Share %]
		formatString: 0.0%
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: e2f3a4b5-c6d7-8901-bcde-f0123456789a

	measure 'Ref Line CVR %' =
			CALCULATE(
				VAR SessIDs = VALUES(website_sessions[website_session_id])
				VAR SessOrders =
					CALCULATE(
						COUNTROWS(orders),
						TREATAS(SessIDs, orders[website_session_id])
					)
				VAR SessCount = COUNTROWS(website_sessions)
				RETURN
				DIVIDE(SessOrders, SessCount, 0),
				ISBLANK(website_sessions[Social Experiment Segment])
			)
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 5 - Social Experiment
		lineageTag: dfff530d-3596-445c-b6f8-31f3a23c4026

	measure 'Dumbbell CVR %' =
			VAR SessIDs = VALUES(website_sessions[website_session_id])
			VAR SessOrders =
				CALCULATE(
					COUNTROWS(orders),
					TREATAS(SessIDs, orders[website_session_id])
				)
			VAR SessCount = COUNTROWS(website_sessions)
			RETURN
			DIVIDE(SessOrders, SessCount, 0)
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 3 - Dumbbell Gap
		lineageTag: c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f

	measure 'Social Experiment CVR %' =
			VAR SessIDs = VALUES(website_sessions[website_session_id])
			VAR SessOrders =
				CALCULATE(
					COUNTROWS(orders),
					TREATAS(SessIDs, orders[website_session_id])
				)
			VAR SessCount = COUNTROWS(website_sessions)
			RETURN
			DIVIDE(SessOrders, SessCount, 0)
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 5 - Social Experiment
		lineageTag: d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a

	measure 'Matrix Sessions' =
			IF(
				ISINSCOPE(_Param_Dim[Member]),
				VAR ActiveDim = SELECTEDVALUE(_Param_Dim[DimensionName], "Channel")
				VAR CurMember = SELECTEDVALUE(_Param_Dim[Member])
				VAR RowDim = SELECTEDVALUE(_Param_Dim[DimensionName])
				VAR ShouldShow = ISFILTERED(_Param_Dim[DimensionName]) || RowDim = "Channel"
				RETURN
				IF(
					NOT(ShouldShow),
					BLANK(),
					SWITCH(
						ActiveDim,
						"Channel", CALCULATE(COUNTROWS(website_sessions), website_sessions[Channel] = CurMember),
						"Device", CALCULATE(COUNTROWS(website_sessions), website_sessions[Device] = CurMember),
						"Product",
							VAR ProdUrl =
								SWITCH(
									CurMember,
									"The Original Mr. Fuzzy", "/the-original-mr-fuzzy",
									"The Forever Love Bear", "/the-forever-love-bear",
									"The Birthday Sugar Panda", "/the-birthday-sugar-panda",
									"The Hudson River Mini bear", "/the-hudson-river-mini-bear",
									BLANK()
								)
							VAR PvSess =
								CALCULATETABLE(
									VALUES(website_pageviews[website_session_id]),
									website_pageviews[pageview_url] = ProdUrl
								)
							VAR OrderSess =
								CALCULATETABLE(
									VALUES(orders[website_session_id]),
									TREATAS({CurMember}, products[product_name]),
									TREATAS(
										CALCULATETABLE(VALUES(website_sessions[website_session_id])),
										orders[website_session_id]
									)
								)
							VAR CombinedSess = DISTINCT(UNION(PvSess, OrderSess))
							RETURN
							COUNTROWS(CombinedSess),
						"Landing page", CALCULATE(COUNTROWS(website_sessions), website_sessions[Landing Page] = CurMember),
						"Campaign", CALCULATE(COUNTROWS(website_sessions), website_sessions[Campaign] = CurMember),
						CALCULATE(COUNTROWS(website_sessions), website_sessions[Channel] = CurMember)
					)
				),
				COUNTROWS(website_sessions)
			)
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8a9b

	measure 'Matrix Orders' =
			IF(
				ISINSCOPE(_Param_Dim[Member]),
				VAR ActiveDim = SELECTEDVALUE(_Param_Dim[DimensionName], "Channel")
				VAR CurMember = SELECTEDVALUE(_Param_Dim[Member])
				VAR RowDim = SELECTEDVALUE(_Param_Dim[DimensionName])
				VAR ShouldShow = ISFILTERED(_Param_Dim[DimensionName]) || RowDim = "Channel"
				RETURN
				IF(
					NOT(ShouldShow),
					BLANK(),
					SWITCH(
						ActiveDim,
						"Channel",
							CALCULATE(
								COUNTROWS(orders),
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Channel] = CurMember),
									orders[website_session_id]
								)
							),
						"Device",
							CALCULATE(
								COUNTROWS(orders),
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Device] = CurMember),
									orders[website_session_id]
								)
							),
						"Product",
							CALCULATE(
								DISTINCTCOUNT(order_items[order_id]),
								TREATAS({CurMember}, products[product_name])
							),
						"Landing page",
							CALCULATE(
								COUNTROWS(orders),
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Landing Page] = CurMember),
									orders[website_session_id]
								)
							),
						"Campaign",
							CALCULATE(
								COUNTROWS(orders),
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Campaign] = CurMember),
									orders[website_session_id]
								)
							),
						CALCULATE(
							COUNTROWS(orders),
							TREATAS(
								CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Channel] = CurMember),
								orders[website_session_id]
							)
						)
					)
				),
				CALCULATE(
					COUNTROWS(orders),
					TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id])
				)
			)
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8a9b0c

	measure 'Matrix Revenue' =
			IF(
				ISINSCOPE(_Param_Dim[Member]),
				VAR ActiveDim = SELECTEDVALUE(_Param_Dim[DimensionName], "Channel")
				VAR CurMember = SELECTEDVALUE(_Param_Dim[Member])
				VAR RowDim = SELECTEDVALUE(_Param_Dim[DimensionName])
				VAR ShouldShow = ISFILTERED(_Param_Dim[DimensionName]) || RowDim = "Channel"
				RETURN
				IF(
					NOT(ShouldShow),
					BLANK(),
					SWITCH(
						ActiveDim,
						"Channel",
							CALCULATE(
								[Gross Revenue],
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Channel] = CurMember),
									orders[website_session_id]
								)
							),
						"Device",
							CALCULATE(
								[Gross Revenue],
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Device] = CurMember),
									orders[website_session_id]
								)
							),
						"Product",
							CALCULATE(
								[Gross Revenue],
								TREATAS({CurMember}, products[product_name])
							),
						"Landing page",
							CALCULATE(
								[Gross Revenue],
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Landing Page] = CurMember),
									orders[website_session_id]
								)
							),
						"Campaign",
							CALCULATE(
								[Gross Revenue],
								TREATAS(
									CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Campaign] = CurMember),
									orders[website_session_id]
								)
							),
						CALCULATE(
							[Gross Revenue],
							TREATAS(
								CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[Channel] = CurMember),
								orders[website_session_id]
							)
						)
					)
				),
				CALCULATE(
					[Gross Revenue],
					TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id])
				)
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: a7b8c9d0-e1f2-4a3b-4c5d-6e7f8a9b0c1d

	measure 'Matrix CVR %' = DIVIDE([Matrix Orders], [Matrix Sessions], 0)
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: b8c9d0e1-f2a3-4b4c-5d6e-7f8a9b0c1d2e

	measure 'Matrix Rev per Session' = DIVIDE([Matrix Revenue], [Matrix Sessions], 0)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: c9d0e1f2-a3b4-4c5d-6e7f-8a9b0c1d2e3f

	measure 'Matrix Session Share %' =
			IF(
				ISINSCOPE(_Param_Dim[Member]),
				VAR Tot = [Matrix Sessions]
				VAR ActiveDim = SELECTEDVALUE(_Param_Dim[DimensionName], "Channel")
				VAR ProductTotal =
					VAR S1 =
						CALCULATE(
							VAR ProdUrl = "/the-original-mr-fuzzy"
							VAR PvSess = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = ProdUrl)
							VAR OrderSess = CALCULATETABLE(VALUES(orders[website_session_id]), products[product_name] = "The Original Mr. Fuzzy", TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id]))
							RETURN COUNTROWS(DISTINCT(UNION(PvSess, OrderSess))),
							ALLSELECTED(_Param_Dim)
						)
					VAR S2 =
						CALCULATE(
							VAR ProdUrl = "/the-forever-love-bear"
							VAR PvSess = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = ProdUrl)
							VAR OrderSess = CALCULATETABLE(VALUES(orders[website_session_id]), products[product_name] = "The Forever Love Bear", TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id]))
							RETURN COUNTROWS(DISTINCT(UNION(PvSess, OrderSess))),
							ALLSELECTED(_Param_Dim)
						)
					VAR S3 =
						CALCULATE(
							VAR ProdUrl = "/the-birthday-sugar-panda"
							VAR PvSess = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = ProdUrl)
							VAR OrderSess = CALCULATETABLE(VALUES(orders[website_session_id]), products[product_name] = "The Birthday Sugar Panda", TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id]))
							RETURN COUNTROWS(DISTINCT(UNION(PvSess, OrderSess))),
							ALLSELECTED(_Param_Dim)
						)
					VAR S4 =
						CALCULATE(
							VAR ProdUrl = "/the-hudson-river-mini-bear"
							VAR PvSess = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = ProdUrl)
							VAR OrderSess = CALCULATETABLE(VALUES(orders[website_session_id]), products[product_name] = "The Hudson River Mini bear", TREATAS(CALCULATETABLE(VALUES(website_sessions[website_session_id])), orders[website_session_id]))
							RETURN COUNTROWS(DISTINCT(UNION(PvSess, OrderSess))),
							ALLSELECTED(_Param_Dim)
						)
					RETURN
					S1 + S2 + S3 + S4
				VAR ChannelTotal =
					CALCULATE(
						[Matrix Sessions],
						ALLSELECTED(_Param_Dim[Member]),
						ALLSELECTED(_Param_Dim[MemberSort])
					)
				VAR AllTot =
					IF(ActiveDim = "Product", ProductTotal, ChannelTotal)
				RETURN
				IF(ISBLANK(Tot), BLANK(), DIVIDE(Tot, AllTot, 0)),
				1.0
			)
		formatString: 0.0%
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: d0e1f2a3-b4c5-4d6e-7f8a-9b0c1d2e3f4a

	measure 'Page Title P3' =
			VAR BlendedCVR = FORMAT([Conversion Rate %], "0.00%")
			VAR BestLander = [Best Lander Name]
			VAR BestCVR = FORMAT([Best Lander CVR], "0.00%")
			VAR YearPart =
			    IF(
			        ISFILTERED(Dim_Date[Year]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(Dim_Date[Year], "Multi-Year"),
			        ""
			    )
			VAR DevicePart =
			    IF(
			        ISFILTERED(website_sessions[Device]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(website_sessions[Device], "All Devices"),
			        ""
			    )
			VAR TrafficPart =
			    IF(
			        ISFILTERED(website_sessions[Traffic Type]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(website_sessions[Traffic Type], "All Traffic"),
			        ""
			    )
			RETURN
			    "CRO Lab " & UNICHAR(183) & " " & BlendedCVR & " blended CVR " & UNICHAR(183) & " best lander " & BestLander & " (" & BestCVR & ")" & YearPart & DevicePart & TrafficPart
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: cbbc7922-703f-4ae7-8d29-9aa6ddac15a8

	measure 'Header P3 HTML' =
			VAR titleText = [Page Title P3]
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #F8FAFC; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #8B95B0; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>" & titleText & "</div>
			  <div class='hdr-sub'>Sample output of the dynamic title measure " & UNICHAR(183) & " data through 19 Mar 2015</div>
			</div>"
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 4577f806-5809-4d3e-bf26-dbc884d14d4f

	measure 'Lander Sessions' = [Total Sessions]
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 161b62c3-8786-4a68-8423-06dd25183ffc

	measure 'Lander Orders' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE([Total Orders], TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: a761da2a-ff05-4ea8-9359-55548e1d2a04

	measure 'Lander CVR' = DIVIDE([Lander Orders], [Lander Sessions])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 35398a93-be70-4b1f-bf4b-a3a681a388e4

	measure 'Lander Bounces' = CALCULATE(COUNTROWS(website_sessions), website_sessions[Is Bounce] = 1)
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 82c18da4-167c-4912-a551-3fae2d1ffff3

	measure 'Lander Bounce Rate' = DIVIDE([Lander Bounces], [Lander Sessions])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 793acbce-1d8d-4004-b0a7-c4a6cdd0ba4f

	measure 'Best Lander Name' =
			VAR Landers =
			    ADDCOLUMNS(
			        VALUES(website_sessions[Landing Page]),
			        "L_CVR", [Lander CVR]
			    )
			VAR TopL = TOPN(1, Landers, [L_CVR], DESC)
			RETURN MAXX(TopL, website_sessions[Landing Page])
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 205aa887-c258-4453-98f8-15d0616cb4b7

	measure 'Best Lander CVR' =
			VAR Landers =
			    ADDCOLUMNS(
			        VALUES(website_sessions[Landing Page]),
			        "L_CVR", [Lander CVR]
			    )
			RETURN MAXX(Landers, [L_CVR])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 700fa8ad-42a3-4cff-982f-f6cdc301a1d4

	measure 'Lowest Bounce %' =
			VAR Landers =
			    ADDCOLUMNS(
			        VALUES(website_sessions[Landing Page]),
			        "L_Bounce", [Lander Bounce Rate]
			    )
			RETURN MINX(Landers, [L_Bounce])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: f97e5b93-3e27-4aca-b3bc-056f0f7a6b33

	measure 'Lowest Bounce Lander' =
			VAR Landers =
			    ADDCOLUMNS(
			        VALUES(website_sessions[Landing Page]),
			        "L_Bounce", [Lander Bounce Rate]
			    )
			VAR LowB = TOPN(1, Landers, [L_Bounce], ASC)
			RETURN MAXX(LowB, website_sessions[Landing Page])
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: d06bcf01-9039-41f8-87a3-269c5cb517e3

	measure 'Billing Baseline CVR' =
			VAR b1_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing")
			VAR n1 = COUNTROWS(b1_sessions)
			VAR x1 = CALCULATE([Total Orders], TREATAS(b1_sessions, orders[website_session_id]))
			RETURN DIVIDE(x1, n1)
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 20a13200-4fed-41ca-9d8e-38889b773963

	measure 'Billing Variant CVR' =
			VAR b2_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing-2")
			VAR n2 = COUNTROWS(b2_sessions)
			VAR x2 = CALCULATE([Total Orders], TREATAS(b2_sessions, orders[website_session_id]))
			RETURN DIVIDE(x2, n2)
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: e6c3f018-a66d-448c-9aee-b2fa5eca8d61

	measure 'Billing Lift pp' =
			VAR p1 = [Billing Baseline CVR]
			VAR p2 = [Billing Variant CVR]
			RETURN p2 - p1
		formatString: +0.00 pp;-0.00 pp;0.00 pp
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 37ef0623-518d-43c2-b022-1bdeb9b11f51

	measure 'Billing Z-Score' =
			VAR b1_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing")
			VAR b2_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing-2")
			VAR n1 = COUNTROWS(b1_sessions)
			VAR n2 = COUNTROWS(b2_sessions)
			VAR x1 = CALCULATE([Total Orders], TREATAS(b1_sessions, orders[website_session_id]))
			VAR x2 = CALCULATE([Total Orders], TREATAS(b2_sessions, orders[website_session_id]))
			VAR p1 = DIVIDE(x1, n1)
			VAR p2 = DIVIDE(x2, n2)
			VAR p = DIVIDE(x1 + x2, n1 + n2)
			VAR se = SQRT(p * (1 - p) * (DIVIDE(1, n1) + DIVIDE(1, n2)))
			RETURN DIVIDE(p2 - p1, se)
		formatString: 0.0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 8072b331-7c27-4fb1-a0f9-59063501b558

	measure 'Checkout Completion %' =
			VAR b_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] IN { "/billing", "/billing-2" })
			VAR n = COUNTROWS(b_sessions)
			VAR x = CALCULATE([Total Orders], TREATAS(b_sessions, orders[website_session_id]))
			RETURN DIVIDE(x, n)
		formatString: 0.0%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 1c08b40f-ff4a-4614-9f5a-000362a37c3d

	measure 'KPI Strip P3 HTML' =
			VAR bestCvr = [Best Lander CVR]
			VAR bestName = [Best Lander Name]
			VAR lowBounce = [Lowest Bounce %]
			VAR lowBounceName = [Lowest Bounce Lander]
			VAR bLift = [Billing Lift pp]
			VAR bBase = [Billing Baseline CVR]
			VAR bVar = [Billing Variant CVR]
			VAR bZ = [Billing Z-Score]
			VAR chkComp = [Checkout Completion %]
			
			VAR card1Val = IF(ISBLANK(bestCvr), "-", FORMAT(bestCvr, "0.00%"))
			VAR card1Sub = IF(ISBLANK(bestName), "-", bestName)
			
			VAR card2Val = IF(ISBLANK(lowBounce), "-", FORMAT(lowBounce, "0.00%"))
			VAR card2Sub = IF(ISBLANK(lowBounceName), "-", lowBounceName)
			
			VAR card3Val = IF(ISBLANK(bLift), "+18.57 pp", "+" & FORMAT(bLift * 100, "0.00") & " pp")
			VAR card3Sub = IF(ISBLANK(bBase) || ISBLANK(bVar), "44.79% " & UNICHAR(8594) & " 63.36%", FORMAT(bBase, "0.00%") & " " & UNICHAR(8594) & " " & FORMAT(bVar, "0.00%"))
			
			VAR card4Val = IF(ISBLANK(bZ), UNICHAR(8776) & " 22", UNICHAR(8776) & " " & FORMAT(ROUND(bZ, 0), "0"))
			VAR card4Sub = "p < 0.0001"
			
			VAR card5Val = IF(ISBLANK(chkComp), "62.1%", FORMAT(chkComp, "0.0%"))
			VAR card5Sub = "billing " & UNICHAR(8594) & " order"
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; width: 100%; height: 100%; }
			  .kpi-card {
			    position: relative; overflow: hidden; min-width: 0; height: 100%;
			    padding: 12px 16px 10px 16px; border-radius: 10px;
			    display: flex; flex-direction: column; justify-content: space-between;
			    background: radial-gradient(120% 100% at 100% 0%, var(--glow), transparent 62%),
			                linear-gradient(160deg, #151F3F 0%, #0A1125 100%);
			    border: 1px solid rgba(255,255,255,0.08);
			    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 8px 20px rgba(0,0,0,0.35);
			    transition: border-color .2s ease, box-shadow .2s ease;
			  }
			  .kpi-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px;
			    background: linear-gradient(90deg, var(--acc), transparent 85%); }
			  .kpi-card:hover { border-color: var(--acc); box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 22px var(--glow); }
			  .kpi-label { font-size:10px; color:#8FA0BC; font-weight:700; text-transform:uppercase;
			    letter-spacing:0.8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-value { font-size: clamp(21px, 2.1vw, 27px); font-weight:800; color:var(--val-col, #F8FAFC); line-height:1.1;
			    letter-spacing:-.6px; font-variant-numeric:tabular-nums; white-space:nowrap;
			    overflow:hidden; text-overflow:ellipsis; margin:3px 0 2px;
			    text-shadow: 0 0 18px var(--glow); }
			  .kpi-sub { align-self:flex-start; max-width:100%; font-size:9.5px; font-weight:600; color:#94A3B8;
			    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			</style>
			<div class='kpi-grid'>
			  <div class='kpi-card' style='--acc:#34D399;--glow:rgba(52,211,153,.16);--val-col:#34D399;'>
