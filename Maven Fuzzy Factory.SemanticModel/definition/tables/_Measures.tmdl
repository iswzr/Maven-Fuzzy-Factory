	measure 'VIZ-06 CVR' = DIVIDE([VIZ-06 ORDERS], [VIZ-06 SESSIONS])
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-06 Billing AB Test
