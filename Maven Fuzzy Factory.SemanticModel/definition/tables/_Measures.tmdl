	measure 'Scn Net Revenue' = [Net Revenue] + [Scn CVR Revenue] + [Scn Cross-Sell Revenue] - [Scn Incr Refunds] + [Scn Refund Savings]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 09 Page 7 - What-If
		lineageTag: e7f1a2b3-c4d5-4678-90e5-123456789012

	measure 'Scn Net Revenue Delta' = [Scn Net Revenue] - [Net Revenue]
		formatString: +\$#,0;-\$#,0;\$0
		displayFolder: 09 Page 7 - What-If
		lineageTag: f8a2b3c4-d5e6-4789-01f6-234567890123

	measure 'Scn CVR' = DIVIDE([Scn Orders], [Total Sessions], 0)
		formatString: 0.00%
		displayFolder: 09 Page 7 - What-If
		lineageTag: a9b3c4d5-e6f7-4890-12a7-345678901234

	measure 'Header P7 HTML' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR grossRev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			VAR netRev = CALCULATE([Net Revenue], TREATAS(sid, orders[website_session_id]))
			VAR totalOrders = CALCULATE([Total Orders], TREATAS(sid, orders[website_session_id]))
			VAR cvrVal = CALCULATE([Conversion Rate %], TREATAS(sid, orders[website_session_id]))
			
			VAR delta = [Scn Net Revenue Delta]
			VAR deltaStr =
				IF(
					ABS(delta) >= 1000000,
					(IF(delta >= 0, "+$", "-$") & FORMAT(ABS(delta) / 1000000, "0.00") & "M"),
					IF(
						ABS(delta) >= 1000,
						(IF(delta >= 0, "+$", "-$") & FORMAT(ABS(delta) / 1000, "#,0") & "K"),
						IF(delta >= 0, "+$", "-$") & FORMAT(ABS(delta), "#,0")
					)
				)
			VAR deltaColor = IF(delta >= 0, "#059669", "#E11D48")
			VAR upsideText =
				IF(
					delta = 0,
					"net revenue upside vs baseline",
					"<span style='color:" & deltaColor & ";font-weight:800'>" & deltaStr & "</span> net revenue upside vs baseline"
				)
			
			VAR cvrLiftVal = [CVR Lift Value]
			VAR attachVal = [XSell Uplift Value]
			VAR refCutVal = [Refund Reduction Value]
			
			VAR cvrPart =
				IF(
					cvrLiftVal <> 0,
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#1D4ED8;font-weight:700'>CVR " & IF(cvrLiftVal > 0, "+", "") & FORMAT(cvrLiftVal, "0%") & "</span>",
					""
				)
			VAR attachPoints = ROUND(attachVal * 100, 0)
			VAR attachPart =
				IF(
					attachVal <> 0,
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#D97706;font-weight:700'>Attach " & IF(attachPoints >= 0, "+", "") & FORMAT(attachPoints, "0") & " pp</span>",
					""
				)
			VAR refundPart =
				IF(
					refCutVal <> 0,
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#E11D48;font-weight:700'>Refunds -" & FORMAT(refCutVal, "0%") & "</span>",
					""
				)
			VAR targetPart =
				IF(
					ISFILTERED(_Param_BenchmarkTarget[ModeName]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#4F46E5;font-weight:700'>" & SELECTEDVALUE(_Param_BenchmarkTarget[ModeName]) & "</span>",
					""
				)
			
			VAR baselineNetRevStr =
				IF(netRev >= 1000000,
				   "$" & FORMAT(netRev / 1000000, "0.00") & "M",
				   "$" & FORMAT(netRev / 1000, "#,0") & "K")
			VAR baselineCVRStr = FORMAT(cvrVal, "0.00%")
			VAR scnCVRStr = FORMAT([Scn CVR], "0.00%")
			VAR scnOrdersStr = FORMAT([Scn Orders], "#,0")
			
			VAR subStats =
				IF(
					delta <> 0,
					" &bull; scenario net rev <b style='color:#059669'>" & IF([Scn Net Revenue] >= 1000000, "$" & FORMAT([Scn Net Revenue] / 1000000, "0.00") & "M", "$" & FORMAT([Scn Net Revenue] / 1000, "#,0") & "K") & "</b> &bull; scn CVR <b style='color:#1D4ED8'>" & scnCVRStr & "</b> &bull; orders <b style='color:#0F172A'>" & scnOrdersStr & "</b>",
					""
				)
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #0F172A; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #475569; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>What-if <span style='color:#CBD5E1'>&bull;</span> " & upsideText & cvrPart & attachPart & refundPart & targetPart & "</div>
			  <div class='hdr-sub'>Sample output of the dynamic title measure &bull; data through 19 Mar 2015" & subStats & "</div>
			</div>"
		displayFolder: 09 Page 7 - What-If
		lineageTag: b0c4d5e6-f7a8-4901-23b8-456789012345

	measure 'Selected Benchmark Mode' = SELECTEDVALUE(_Param_BenchmarkTarget[ModeID], 1)
		formatString: 0
		displayFolder: 09 Page 7 - What-If
		lineageTag: da123456-7890-4abc-def1-234567890123

	measure 'Benchmark CVR Target' =
			VAR m = [Selected Benchmark Mode]
			RETURN
				SWITCH(
					m,
					1, 0.075,
					2, 0.0722,
					3, 0.050,
					0.075
				)
		formatString: 0.00%
		displayFolder: 09 Page 7 - What-If
		lineageTag: eb234567-8901-4bcd-ef12-345678901234

	measure 'Benchmark Target Name' = SELECTEDVALUE(_Param_BenchmarkTarget[ModeName], "Company budget")
		displayFolder: 09 Page 7 - What-If
