	measure 'Avg Cross-Sell Price' =
			VAR xsellRev = CALCULATE(SUM(order_items[price_usd]), order_items[is_primary_item] = 0)
			VAR xsellUnits = CALCULATE(COUNTROWS(order_items), order_items[is_primary_item] = 0)
			RETURN DIVIDE(xsellRev, xsellUnits, 38.78)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 09 Page 7 - What-If
