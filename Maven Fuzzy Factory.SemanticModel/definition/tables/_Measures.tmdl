					ISBLANK(S), BLANK(),
					S >= 1000000, FORMAT(S / 1000000, "0.0") & "M",
					S >= 100000, FORMAT(S / 1000, "0") & "K",
					S >= 1000, FORMAT(S / 1000, "0.0") & "K",
					FORMAT(S, "#,0")
