	measure 'Billing Variant CVR' =
			VAR b2_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing-2")
			VAR n2 = COUNTROWS(b2_sessions)
			VAR x2 = CALCULATE([Total Orders], TREATAS(b2_sessions, orders[website_session_id]))
			RETURN DIVIDE(x2, n2)
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: e6c3f018-a66d-448c-9aee-b2fa5eca8d61

	measure 'Billing Lift pp' =
			VAR p1 = [Billing Baseline CVR]
			VAR p2 = [Billing Variant CVR]
			RETURN p2 - p1
		formatString: +0.00 pp;-0.00 pp;0.00 pp
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 37ef0623-518d-43c2-b022-1bdeb9b11f51

	measure 'Billing Z-Score' =
			VAR b1_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing")
			VAR b2_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] = "/billing-2")
			VAR n1 = COUNTROWS(b1_sessions)
			VAR n2 = COUNTROWS(b2_sessions)
			VAR x1 = CALCULATE([Total Orders], TREATAS(b1_sessions, orders[website_session_id]))
			VAR x2 = CALCULATE([Total Orders], TREATAS(b2_sessions, orders[website_session_id]))
			VAR p1 = DIVIDE(x1, n1)
			VAR p2 = DIVIDE(x2, n2)
			VAR p = DIVIDE(x1 + x2, n1 + n2)
			VAR se = SQRT(p * (1 - p) * (DIVIDE(1, n1) + DIVIDE(1, n2)))
			RETURN DIVIDE(p2 - p1, se)
		formatString: 0.0
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 8072b331-7c27-4fb1-a0f9-59063501b558

	measure 'Checkout Completion %' =
			VAR b_sessions = CALCULATETABLE(VALUES(website_pageviews[website_session_id]), website_pageviews[pageview_url] IN { "/billing", "/billing-2" })
			VAR n = COUNTROWS(b_sessions)
			VAR x = CALCULATE([Total Orders], TREATAS(b_sessions, orders[website_session_id]))
			RETURN DIVIDE(x, n)
		formatString: 0.0%
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: 1c08b40f-ff4a-4614-9f5a-000362a37c3d

	measure 'KPI Strip P3 HTML' =
			
			VAR bestCvr       = [Best Lander CVR]
			VAR bestName      = [Best Lander Name]
			VAR lowBounce     = [Lowest Bounce %]
			VAR lowBounceName = [Lowest Bounce Lander]
			VAR bBase         = [Billing Baseline CVR]
			VAR bVar          = [Billing Variant CVR]
			VAR bZ            = [Billing Z-Score]
			VAR chkComp       = [Checkout Completion %]
			
			-- Lift computed from the two CVRs so it always matches the subtitle
			VAR liftPP = IF(ISBLANK(bBase) || ISBLANK(bVar), BLANK(), (bVar - bBase) * 100)
			
			VAR card1Val = IF(ISBLANK(bestCvr), "-", FORMAT(bestCvr, "0.00%"))
			VAR card1Sub = IF(ISBLANK(bestName), "-", bestName)
			VAR card2Val = IF(ISBLANK(lowBounce), "-", FORMAT(lowBounce, "0.0%"))
			VAR card2Sub = IF(ISBLANK(lowBounceName), "-", lowBounceName)
			VAR card3Val = IF(ISBLANK(liftPP), "-", IF(liftPP > 0, "+", "") & FORMAT(liftPP, "0.00") & " pp")
			VAR card3Sub = IF(ISBLANK(liftPP), "-", FORMAT(bBase, "0.0%") & " " & UNICHAR(8594) & " " & FORMAT(bVar, "0.0%"))
			VAR card4Val = IF(ISBLANK(bZ), "-", FORMAT(bZ, "0.00"))
			VAR card4Sub = IF(ISBLANK(bZ), "-", IF(bZ >= 2.58, "p < 0.01 " & UNICHAR(183) & " 99% conf.", IF(bZ >= 1.96, "p < 0.05 " & UNICHAR(183) & " 95% conf.", "Not stat. sig.")))
			VAR card5Val = IF(ISBLANK(chkComp), "-", FORMAT(chkComp, "0.0%"))
			VAR card5Sub = "billing-2 session rate"
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden !important; background: transparent !important;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  ::-webkit-scrollbar { display: none !important; width: 0 !important; height: 0 !important; }
			
			  /* --extra = height boost to cover the visual's lower padding; tweak 0-16px */
			  .kpi-grid { --extra: 10px;
			    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px;
			    width: 100%; height: calc(100% + var(--extra)); overflow: hidden; }
			
			  .kpi-card {
			    position: relative; overflow: hidden; min-width: 0; height: 100%;
			    padding: 12px 16px; border-radius: 12px;
			    display: flex; align-items: center; justify-content: space-between; gap: 10px;
			    background: linear-gradient(160deg, #FFFFFF 0%, #F8FAFC 100%);
			    border: 1px solid #E2E8F0;
			    box-shadow: 0 1px 2px rgba(15,23,42,.05), 0 6px 16px -6px rgba(15,23,42,.10);
			    opacity: 0; animation: rise .55s cubic-bezier(.2,.8,.2,1) forwards;
			    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
			  }
			  .kpi-card:nth-child(1) { animation-delay: .00s; }
			  .kpi-card:nth-child(2) { animation-delay: .07s; }
			  .kpi-card:nth-child(3) { animation-delay: .14s; }
			  .kpi-card:nth-child(4) { animation-delay: .21s; }
			  .kpi-card:nth-child(5) { animation-delay: .28s; }
			  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
			
			  /* gradient accent bar */
			  .kpi-card::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px;
			    background: linear-gradient(90deg, var(--acc), var(--acc2)); }
			  /* soft corner glow */
			  .kpi-card::after { content: ''; position: absolute; right: -30px; top: -30px; width: 110px; height: 110px;
			    border-radius: 50%; background: radial-gradient(circle, var(--soft) 0%, transparent 70%);
			    opacity: .9; pointer-events: none; transition: transform .35s ease; }
			
			  .kpi-card:hover { transform: translateY(-3px); border-color: var(--line);
			    box-shadow: 0 2px 4px rgba(15,23,42,.06), 0 14px 28px -8px var(--glow); }
			  .kpi-card:hover::after { transform: scale(1.35); }
			
			  .kpi-txt { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
			  .kpi-label { display: flex; align-items: center; gap: 6px; font-size: 10px; color: #64748B; font-weight: 700;
			    text-transform: uppercase; letter-spacing: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			  .kpi-label::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--acc);
			    box-shadow: 0 0 0 3px var(--soft); }
			  .kpi-value { font-size: clamp(24px, 2.5vw, 34px); font-weight: 800; line-height: 1.05; letter-spacing: -1px;
			    font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 6px 0 6px;
			    background: linear-gradient(135deg, #0F172A 30%, var(--acc) 130%);
			    -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
			  .kpi-sub { align-self: flex-start; max-width: 100%; font-size: 10px; font-weight: 700; letter-spacing: .2px;
			    color: var(--acc); background: var(--soft); border: 1px solid var(--line);
			    padding: 2px 8px; border-radius: 999px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			
			  .kpi-ico { position: relative; z-index: 1; flex: none; width: 42px; height: 42px; border-radius: 12px;
			    display: flex; align-items: center; justify-content: center; color: #FFFFFF;
			    background: linear-gradient(135deg, var(--acc), var(--acc2));
			    box-shadow: 0 6px 14px -4px var(--glow);
			    transition: transform .25s ease; }
			  .kpi-card:hover .kpi-ico { transform: scale(1.1) rotate(-6deg); }
			  .kpi-ico svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.2;
			    stroke-linecap: round; stroke-linejoin: round; }
			
			  @media (max-width: 1400px) {
			    .kpi-card { padding: 10px 12px; border-radius: 10px; }
			    .kpi-ico { width: 32px; height: 32px; border-radius: 9px; }
			    .kpi-ico svg { width: 16px; height: 16px; }
			  }
			</style>
			<div class='kpi-grid'>
			  <div class='kpi-card' style='--acc:#059669;--acc2:#34D399;--soft:#D1FAE5;--line:#A7F3D0;--glow:rgba(5,150,105,.35);'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>Best Lander CVR</div>
			      <div class='kpi-value'>" & card1Val & "</div>
			      <div class='kpi-sub'>" & card1Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#0D9488;--acc2:#2DD4BF;--soft:#CCFBF1;--line:#99F6E4;--glow:rgba(13,148,136,.35);'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>Lowest Bounce Rate</div>
			      <div class='kpi-value'>" & card2Val & "</div>
			      <div class='kpi-sub'>" & card2Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><polyline points='23 6 13.5 15.5 8.5 10.5 1 18'/><polyline points='17 6 23 6 23 12'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#1D4ED8;--acc2:#60A5FA;--soft:#DBEAFE;--line:#BFDBFE;--glow:rgba(29,78,216,.35);'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>Billing-2 Absolute Lift</div>
			      <div class='kpi-value'>" & card3Val & "</div>
			      <div class='kpi-sub'>" & card3Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><line x1='12' y1='19' x2='12' y2='5'/><polyline points='5 12 12 5 19 12'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#4F46E5;--acc2:#A78BFA;--soft:#E0E7FF;--line:#C7D2FE;--glow:rgba(79,70,229,.35);'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>Billing Test Z-Score</div>
			      <div class='kpi-value'>" & card4Val & "</div>
			      <div class='kpi-sub'>" & card4Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><polyline points='8 12.5 11 15.5 16 9'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#D97706;--acc2:#FBBF24;--soft:#FEF3C7;--line:#FDE68A;--glow:rgba(217,119,6,.35);'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>Checkout Completion</div>
			      <div class='kpi-value'>" & card5Val & "</div>
			      <div class='kpi-sub'>" & card5Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'/><polyline points='22 4 12 14.01 9 11.01'/></svg></div>
			  </div>
			</div>"
		displayFolder: 05 Page 3 - CRO Lab
		lineageTag: f038361e-5ff2-4d3a-996c-5f97b69aa856

	measure 'VIZ-03 SESSIONS' = [Lander Sessions]
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 5b6a7c8d-9e0f-4123-b456-7a8b9c0d1e2f

	measure 'VIZ-03 BOUNCE' = [Lander Bounce Rate]
		formatString: 0.0%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 6c7d8e9f-0a1b-4234-c567-8b9c0d1e2f3a

	measure 'VIZ-03 CVR' = [Lander CVR]
		formatString: 0.00%
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 7d8e9f0a-1b2c-4345-d678-9c0d1e2f3a4b

	measure 'VIZ-03 ORDERS' = [Lander Orders]
		formatString: #,0
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 8e9f0a1b-2c3d-4456-e789-0d1e2f3a4b5c

	measure 'VIZ-03 VERDICT' =
			VAR CurrentLander = SELECTEDVALUE(website_sessions[Landing Page])
			VAR CurrentSessions = [VIZ-03 SESSIONS]
			VAR CurrentOrders = [VIZ-03 ORDERS]
			VAR CurrentCVR = [VIZ-03 CVR]
			VAR CurrentBounce = [VIZ-03 BOUNCE]
			VAR IsSingleLander = HASONEVALUE(website_sessions[Landing Page])
			
			-- Baseline metrics (/home in current filter context)
			VAR BaseSessions = CALCULATE([VIZ-03 SESSIONS], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			VAR BaseOrders = CALCULATE([VIZ-03 ORDERS], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			VAR BaseCVR = DIVIDE(BaseOrders, BaseSessions)
			VAR BaseBounce = CALCULATE([VIZ-03 BOUNCE], website_sessions[Landing Page] = "/home", ALLSELECTED(website_sessions[Landing Page]))
			
			-- Two-proportion Z-test for A/B testing
			VAR p1 = BaseCVR
			VAR p2 = CurrentCVR
			VAR n1 = BaseSessions
			VAR n2 = CurrentSessions
			VAR p_pool = DIVIDE(BaseOrders + CurrentOrders, BaseSessions + CurrentSessions)
			VAR se = SQRT(p_pool * (1 - p_pool) * (DIVIDE(1, n1) + DIVIDE(1, n2)))
			VAR z_score = DIVIDE(p2 - p1, se)
			VAR lift = DIVIDE(p2 - p1, p1)
			VAR delta_bounce = CurrentBounce - BaseBounce
			
			RETURN
				IF(
					NOT IsSingleLander || ISBLANK(CurrentSessions) || CurrentSessions = 0,
					BLANK(),
					IF(
						CurrentLander = "/home",
						"Baseline",
						SWITCH(
							TRUE(),
							-- Low sample size test (underpowered)
							n2 < 10000 && ABS(z_score) < 1.96, "Short test",
							-- Strong statistical champion: z >= 2.58 (p < 0.01), substantial lift >= 20%, lower bounce
							z_score >= 2.58 && lift >= 0.20 && delta_bounce <= 0.01, "Champion",
							-- Statistically significant winner (z >= 1.96, p < 0.05)
							z_score >= 1.96, "Won, scaled",
							-- Statistically significant loser (z <= -1.96, p < 0.05)
							z_score <= -1.96, "Lost",
							-- Adequately powered, but no significant difference from baseline
							"Neutral / Tied"
						)
					)
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 9f0a1b2c-3d4e-4567-f890-1e2f3a4b5c6d

	measure 'VIZ-03 VERDICT Color' =
			VAR V = [VIZ-03 VERDICT]
			RETURN
				SWITCH(
					V,
					"Champion", "#059669",
					"Won, scaled", "#1D4ED8",
					"Baseline", "#475569",
					"Lost", "#E11D48",
					"Short test", "#4F46E5",
					"Neutral / Tied", "#475569",
					BLANK()
				)
		displayFolder: 05 Page 3 - CRO Lab\VIZ-03 Lander Scoreboard
		lineageTag: 0a1b2c3d-4e5f-4678-0901-2e3f4a5b6c7d

	measure 'VIZ-03 LANDER Color' =
			VAR S = [VIZ-03 SESSIONS]
