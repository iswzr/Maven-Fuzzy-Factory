					4, totalRefunds,
					BLANK()
				)
		formatString: -\$#,0.00;-\$#,0.00;-\$#,0.00
		displayFolder: 08 Page 6 - Financial\Margin Bridge
		lineageTag: 55aa4d6e-c9c2-449b-ab83-dd32e278a7d3

	measure 'CVR Lift Value' =
			IF(
				ISFILTERED(_Param_CVR_Tuning[Label]),
				SELECTEDVALUE(_Param_CVR_Tuning[Value], 0.10),
				VAR p = SELECTEDVALUE(_Param_ScenarioPreset[Preset], "Custom sliders")
				RETURN
					SWITCH(
						p,
						"Conservative", 0.05,
						"Base", 0.10,
						"Stretch", 0.20,
						0.10
					)
			)
		formatString: +0%;-0%;0%
		displayFolder: 09 Page 7 - What-If
		lineageTag: a7b1c2d3-e4f5-4678-90ab-cdef12345670

	measure 'XSell Uplift Value' =
			IF(
				ISFILTERED(_Param_Attach_Tuning[Label]),
				SELECTEDVALUE(_Param_Attach_Tuning[Value], 0.08),
				VAR p = SELECTEDVALUE(_Param_ScenarioPreset[Preset], "Custom sliders")
				RETURN
					SWITCH(
						p,
						"Conservative", 0.03,
						"Base", 0.08,
						"Stretch", 0.15,
						0.08
					)
			)
		formatString: +0 "pp";-0 "pp";0 "pp"
