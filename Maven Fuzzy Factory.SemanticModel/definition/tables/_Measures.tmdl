	measure 'Page Title P4' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR ordCount = CALCULATE(COUNTROWS(orders), TREATAS(sid, orders[website_session_id]))
			VAR addonCount = CALCULATE(COUNTROWS(order_items), order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
			VAR grossRev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			VAR attachRate = DIVIDE(addonCount, ordCount)
			VAR aov = DIVIDE(grossRev, ordCount)
			VAR Attach = FORMAT(attachRate, "0.0%")
			VAR AovVal = FORMAT(aov, "$#,0.00")
			VAR YearPart =
			    IF(
			        ISFILTERED(Dim_Date[Year]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(Dim_Date[Year], "Multi-Year"),
			        ""
			    )
			VAR ProdPart =
			    IF(
			        ISFILTERED(products[product_name]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(products[product_name], "All Products"),
			        ""
			    )
			VAR DevicePart =
			    IF(
			        ISFILTERED(website_sessions[Device]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(website_sessions[Device], "All Devices"),
			        ""
			    )
			VAR TrafficPart =
			    IF(
			        ISFILTERED(website_sessions[Traffic Type]),
			        " " & UNICHAR(183) & " " & SELECTEDVALUE(website_sessions[Traffic Type], "All Traffic"),
			        ""
			    )
			RETURN
			    "Portfolio " & UNICHAR(183) & " " & Attach & " attach rate " & UNICHAR(183) & " AOV " & AovVal & YearPart & ProdPart & DevicePart & TrafficPart
		displayFolder: 06 Page 4 - Products
		lineageTag: fd101734-8f86-47f9-b118-a3f030d393e6

	measure 'Header P4 HTML' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR ordCount = CALCULATE(COUNTROWS(orders), TREATAS(sid, orders[website_session_id]))
			VAR totalUnits = CALCULATE(COUNTROWS(order_items), TREATAS(sid, orders[website_session_id]))
			VAR addonCount = CALCULATE(COUNTROWS(order_items), order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
			VAR grossRev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			VAR attachRate = DIVIDE(addonCount, ordCount)
			VAR aov = DIVIDE(grossRev, ordCount)
			VAR mbTotal = CALCULATE(COUNTROWS(order_items), products[product_id] = 4, TREATAS(sid, orders[website_session_id]))
			VAR mbAddon = CALCULATE(COUNTROWS(order_items), products[product_id] = 4, order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
			VAR mbShare = DIVIDE(mbAddon, mbTotal)
			
			VAR Attach = FORMAT(attachRate, "0.0%")
			VAR AovVal = FORMAT(aov, "$#,0.00")
			VAR YearPart =
			    IF(
			        ISFILTERED(Dim_Date[Year]),
			        " <span style='color:#CBD5E1'>&bull;</span> <span style='color:#4F46E5;font-weight:700'>" & SELECTEDVALUE(Dim_Date[Year], "Multi-Year") & "</span>",
			        ""
			    )
			VAR ProdPart =
			    IF(
			        ISFILTERED(products[product_name]),
			        " <span style='color:#CBD5E1'>&bull;</span> <span style='color:#1D4ED8;font-weight:700'>" & SELECTEDVALUE(products[product_name], "All Products") & "</span>",
			        ""
			    )
			VAR DevicePart =
			    IF(
			        ISFILTERED(website_sessions[Device]),
			        " <span style='color:#CBD5E1'>&bull;</span> <span style='color:#D97706;font-weight:700'>" & SELECTEDVALUE(website_sessions[Device], "All Devices") & "</span>",
			        ""
			    )
			VAR TrafficPart =
			    IF(
			        ISFILTERED(website_sessions[Traffic Type]),
			        " <span style='color:#CBD5E1'>&bull;</span> <span style='color:#0284C7;font-weight:700'>" & SELECTEDVALUE(website_sessions[Traffic Type], "All Traffic") & "</span>",
			        ""
			    )
			VAR TotalUnitsStr = FORMAT(totalUnits, "#,0")
			VAR AddonUnitsStr = FORMAT(addonCount, "#,0")
			VAR OrdersCountStr = FORMAT(ordCount, "#,0")
			VAR MbShareStr = IF(ISBLANK(mbShare) || mbTotal = 0, "N/A", FORMAT(mbShare, "0.0%"))
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #0F172A; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #475569; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>Portfolio <span style='color:#CBD5E1'>&bull;</span> <span style='color:#0D9488'>" & Attach & "</span> <span style='font-size:16px;font-weight:500;color:#64748B'>attach rate</span> <span style='color:#CBD5E1'>&bull;</span> <span style='color:#059669'>" & AovVal & "</span> <span style='font-size:16px;font-weight:500;color:#64748B'>AOV</span>" & YearPart & ProdPart & DevicePart & TrafficPart & "</div>
			  <div class='hdr-sub'>" & AddonUnitsStr & " add-on units attached to " & OrdersCountStr & " orders (" & TotalUnitsStr & " total units) &bull; Mini Bear " & MbShareStr & " add-on share &bull; data through 19 Mar 2015</div>
			</div>"
		displayFolder: 06 Page 4 - Products
		lineageTag: 42135cd8-4afa-4653-a99b-8efe51b6fc46

	measure 'Units Sold' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE(COUNTROWS(order_items), TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 06 Page 4 - Products\KPI Cards
		lineageTag: ea3a0411-39d3-47d8-bc11-9f2dea8926ea

	measure 'Mini Bear Cross-Sell Share' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR MiniTotal = CALCULATE(COUNTROWS(order_items), products[product_id] = 4, TREATAS(sid, orders[website_session_id]))
			VAR MiniAddon = CALCULATE(COUNTROWS(order_items), products[product_id] = 4, order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
			RETURN DIVIDE(MiniAddon, MiniTotal)
		formatString: 0.0%
		displayFolder: 06 Page 4 - Products\KPI Cards
		lineageTag: 65e2366b-b20f-445c-b635-a919fc26b8ca

	measure 'Best Margin Product Name' =
			VAR Margins =
				ADDCOLUMNS(
					ALLSELECTED(products),
					"M_Pct", DIVIDE(products[Retail Price] - products[Unit COGS], products[Retail Price])
				)
			VAR TopMargin = TOPN(1, Margins, [M_Pct], DESC)
			RETURN MAXX(TopMargin, products[product_name])
		displayFolder: 06 Page 4 - Products\KPI Cards
		lineageTag: 3b9adcbd-d67a-41e7-9980-c0ec1f0f5221

	measure 'Best Margin Product Short' =
			VAR FullName = [Best Margin Product Name]
			RETURN
				SWITCH(
					FullName,
					"The Birthday Sugar Panda", "Sugar Panda",
					"The Original Mr. Fuzzy", "Mr. Fuzzy",
					"The Forever Love Bear", "Love Bear",
					"The Hudson River Mini Bear", "Mini Bear",
					FullName
				)
		displayFolder: 06 Page 4 - Products\KPI Cards
		lineageTag: 5eae188a-2793-44d6-96b2-b91009b19885

	measure 'Best Margin %' =
			VAR Margins =
				ADDCOLUMNS(
					ALLSELECTED(products),
					"M_Pct", DIVIDE(products[Retail Price] - products[Unit COGS], products[Retail Price])
				)
			RETURN MAXX(Margins, [M_Pct])
		formatString: 0.00%
		displayFolder: 06 Page 4 - Products\KPI Cards
		lineageTag: a75eb3ec-acdf-490f-89da-e98604914959

	measure 'KPI Strip P4 HTML' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR uSold = CALCULATE(COUNTROWS(order_items), TREATAS(sid, orders[website_session_id]))
			VAR pUnits = CALCULATE(COUNTROWS(order_items), order_items[is_primary_item] = 1, TREATAS(sid, orders[website_session_id]))
			VAR xUnits = CALCULATE(COUNTROWS(order_items), order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
			VAR ordCount = CALCULATE(COUNTROWS(orders), TREATAS(sid, orders[website_session_id]))
			VAR xRate = DIVIDE(xUnits, ordCount)
			VAR mbTotal = CALCULATE(COUNTROWS(order_items), products[product_id] = 4, TREATAS(sid, orders[website_session_id]))
			VAR mbAddon = CALCULATE(COUNTROWS(order_items), products[product_id] = 4, order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
			VAR mbShare = DIVIDE(mbAddon, mbTotal)
			VAR aovVal = DIVIDE(CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id])), ordCount)
			VAR pRev = CALCULATE(SUM(order_items[price_usd]), order_items[is_primary_item] = 1, TREATAS(sid, orders[website_session_id]))
			VAR xRev = CALCULATE(SUM(order_items[price_usd]), order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
			VAR pAov = DIVIDE(pRev, ordCount)
			VAR xAov = DIVIDE(xRev, ordCount)
			
			VAR card1Val = IF(ISBLANK(uSold), "-", FORMAT(uSold, "#,0"))
			VAR card1Sub = FORMAT(pUnits, "#,0") & " primary " & UNICHAR(183) & " " & FORMAT(xUnits, "#,0") & " add-on"
			VAR card2Val = IF(ISBLANK(xRate), "-", FORMAT(xRate, "0.0%"))
			VAR card2Sub = FORMAT(xUnits, "#,0") & " of " & FORMAT(ordCount, "#,0") & " orders"
			VAR card3Val = IF(ISBLANK(mbShare) || mbTotal = 0, "-", FORMAT(mbShare, "0.0%"))
			VAR card3Sub = IF(mbTotal = 0, "Launched Dec 2014", FORMAT(mbAddon, "#,0") & " of " & FORMAT(mbTotal, "#,0") & " units")
			VAR card4Val = IF(ISBLANK(aovVal), "-", FORMAT(aovVal, "$#,0.00"))
			VAR card4Sub = "primary " & FORMAT(pAov, "$#,0.00") & " + " & FORMAT(xAov, "$#,0.00")
			VAR card5Val = "Love Bear"
			VAR card5Sub = "67.9% GM " & UNICHAR(183) & " $31.28 margin/unit"
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; width: 100%; height: 100%; }
			  .kpi-card {
			    position: relative; overflow: hidden; min-width: 0; height: 100%;
			    padding: 14px 16px 12px 18px; border-radius: 8px;
			    display: flex; align-items: center; justify-content: space-between;
			    background: #FFFFFF;
			    border: 1px solid #CBD5E1;
			    border-top: 3px solid var(--acc);
			    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
			    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
			  }
			  .kpi-card:hover { border-color: var(--acc); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1); }
			  .kpi-txt { display:flex; flex-direction:column; justify-content:center; min-width:0; }
			  .kpi-label { font-size:10px; color:#475569; font-weight:700; text-transform:uppercase;
			    letter-spacing:0.8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-value { font-size: clamp(22px, 2.3vw, 31px); font-weight:800; color:#0F172A; line-height:1.05;
			    letter-spacing:-.8px; font-variant-numeric:tabular-nums; white-space:nowrap;
			    overflow:hidden; text-overflow:ellipsis; margin:5px 0 3px; }
			  .kpi-sub { max-width:100%; font-size:10px; font-weight:600; color:#64748B;
			    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-ico { flex: none; width: 42px; height: 42px; border-radius: 8px;
			    display: flex; align-items: center; justify-content: center; color: var(--acc);
			    background: var(--soft);
			    border: 1px solid var(--line); }
			  .kpi-ico svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2;
			    stroke-linecap: round; stroke-linejoin: round; }
			  .kpi-ico svg .f { fill: currentColor; }
			  @media (max-width: 1400px) {
			    .kpi-ico { width: 32px; height: 32px; border-radius: 8px; }
			    .kpi-ico svg { width: 16px; height: 16px; }
			  }
			</style>
			<div class='kpi-grid'>
			  <div class='kpi-card' style='--acc:#1D4ED8;--glow:#EFF6FF;--soft:#EFF6FF;--line:#BFDBFE;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>UNITS SOLD</div>
			      <div class='kpi-value'>" & card1Val & "</div>
			      <div class='kpi-sub'>" & card1Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M21 8l-9-5-9 5v8l9 5 9-5V8z'/><path d='M3.3 7.5L12 12.5l8.7-5'/><path d='M12 22V12.5'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#D97706;--glow:#FEF3C7;--soft:#FEF3C7;--line:#FDE68A;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>CROSS-SELL ATTACH RATE</div>
			      <div class='kpi-value'>" & card2Val & "</div>
			      <div class='kpi-sub'>" & card2Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='9' cy='20' r='1.5'/><circle cx='18' cy='20' r='1.5'/><path d='M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6'/><path d='M13.5 10.5v3.5M11.75 12.25h3.5'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#0D9488;--glow:#CCFBF1;--soft:#CCFBF1;--line:#99F6E4;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>MINI BEAR ADD-ON SHARE</div>
			      <div class='kpi-value'>" & card3Val & "</div>
			      <div class='kpi-sub'>" & card3Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='12' cy='13.5' r='7'/><circle cx='6.5' cy='6.5' r='2.5'/><circle cx='17.5' cy='6.5' r='2.5'/><circle class='f' cx='9.5' cy='12.5' r='.9'/><circle class='f' cx='14.5' cy='12.5' r='.9'/><path d='M10.5 16c.8.7 2.2.7 3 0'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#059669;--glow:#D1FAE5;--soft:#D1FAE5;--line:#A7F3D0;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>AVERAGE ORDER VALUE</div>
			      <div class='kpi-value'>" & card4Val & "</div>
			      <div class='kpi-sub'>" & card4Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><path d='M15 8.5c-.6-1-1.7-1.5-3-1.5-1.7 0-3 .9-3 2.2 0 3 6 1.6 6 4.6 0 1.3-1.3 2.2-3 2.2-1.3 0-2.4-.5-3-1.5'/><path d='M12 5.5V7M12 17v1.5'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#4F46E5;--glow:#EEF2FF;--soft:#EEF2FF;--line:#C7D2FE;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>BEST MARGIN PRODUCT</div>
			      <div class='kpi-value'>" & card5Val & "</div>
			      <div class='kpi-sub'>" & card5Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M6 9H4.5a2.5 2.5 0 0 1 0-5H6'/><path d='M18 9h1.5a2.5 2.5 0 0 0 0-5H18'/><path d='M4 22h16'/><path d='M10 14.66V17c0 .55-.47.98-1.97 1.21C7.85 18.75 7 20.24 7 22'/><path d='M14 14.66V17c0 .55.47.98 1.97 1.21C16.15 18.75 17 20.24 17 22'/><path d='M18 2H6v7a6 6 0 0 0 12 0V2Z'/></svg></div>
			  </div>
			</div>"
		displayFolder: 06 Page 4 - Products
		lineageTag: 1126a3bb-2ca1-466d-8b72-ed78f3c1a97b

	measure 'Orders (Page 4)' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE(COUNTROWS(orders), TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 06 Page 4 - Products
		lineageTag: f1a2b3c4-d5e6-4789-a012-3b4c5d6e7f80

	measure 'Gross Revenue (Page 4)' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 06 Page 4 - Products
		lineageTag: f2b3c4d5-e6a7-4890-b123-4c5d6e7f8a91

	measure 'Average Order Value (Page 4)' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR ords = CALCULATE(COUNTROWS(orders), TREATAS(sid, orders[website_session_id]))
			VAR rev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			RETURN DIVIDE(rev, ords)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 06 Page 4 - Products
		lineageTag: f3c4d5e6-a7b8-4901-c234-5d6e7f8a9b02

	measure 'Cross-Sell Attach % (Page 4)' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR ords = CALCULATE(COUNTROWS(orders), TREATAS(sid, orders[website_session_id]))
			VAR addons = CALCULATE(COUNTROWS(order_items), order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
			RETURN DIVIDE(addons, ords)
		formatString: 0.0%
		displayFolder: 06 Page 4 - Products
		lineageTag: f4d5e6a7-b8c9-4012-d345-6e7f8a9b0c13

	measure 'VIZ-Timeline Product Short' =
			VAR u = [VIZ-Timeline Units]
			RETURN
				IF(
					NOT ISBLANK(u) && u > 0,
					SWITCH(
						SELECTEDVALUE(products[product_id]),
						1, "Mr. Fuzzy",
						2, "Love Bear",
						3, "Sugar Panda",
						4, "Mini Bear",
						SELECTEDVALUE(products[product_name])
					)
				)
		displayFolder: 06 Page 4 - Products\Product Launch Timeline
		lineageTag: e1a2b3c4-1111-4789-a012-3b4c5d6e7f01

	measure 'VIZ-Timeline Launch Date' =
			VAR u = [VIZ-Timeline Units]
			RETURN
				IF(
					NOT ISBLANK(u) && u > 0,
					CALCULATE(MIN(products[created_at]))
				)
		formatString: yyyy-mm-dd
		displayFolder: 06 Page 4 - Products\Product Launch Timeline
		lineageTag: e2b3c4d5-2222-4890-b123-4c5d6e7f8a02

	measure 'VIZ-Timeline End Date' =
			VAR u = [VIZ-Timeline Units]
			RETURN
				IF(
					NOT ISBLANK(u) && u > 0,
					DATE(2015, 3, 19)
				)
		formatString: yyyy-mm-dd
		displayFolder: 06 Page 4 - Products\Product Launch Timeline
		lineageTag: e3c4d5e6-3333-4901-c234-5d6e7f8a9b03

	measure 'VIZ-Timeline Mid Date' =
			VAR s = [VIZ-Timeline Launch Date]
			VAR e = [VIZ-Timeline End Date]
			RETURN
				IF(NOT ISBLANK(s) && NOT ISBLANK(e), s + (e - s) / 2)
		formatString: yyyy-mm-dd
		displayFolder: 06 Page 4 - Products\Product Launch Timeline
		lineageTag: e4d5e6a7-4444-4012-d345-6e7f8a9b0c04

	measure 'VIZ-Timeline Launch Label' =
			VAR u = [VIZ-Timeline Units]
			VAR dt =
				SWITCH(
					SELECTEDVALUE(products[product_id]),
					1, "Mar 2012",
					2, "Jan 2013",
					3, "Dec 2013",
					4, "Feb 2014",
					FORMAT(MIN(products[created_at]), "mmm yyyy")
				)
			VAR uFmt =
				IF(
					u >= 1000,
					FORMAT(u / 1000, "#,0.0") & "K units",
					FORMAT(u, "#,0") & " units"
				)
			RETURN
				IF(
					NOT ISBLANK(u) && u > 0,
					dt & " " & UNICHAR(183) & " " & uFmt
				)
		displayFolder: 06 Page 4 - Products\Product Launch Timeline
		lineageTag: e5e6a7b8-5555-4123-e456-7f8a9b0c1d05

	measure 'VIZ-Timeline Color' =
			SWITCH(
			    SELECTEDVALUE(products[product_id]),
			    1, "#1D4ED8",
			    2, "#4F46E5",
			    3, "#D97706",
			    4, "#0D9488",
			    "#1D4ED8"
			)
		displayFolder: 06 Page 4 - Products\Product Launch Timeline
		lineageTag: e6a7b8c9-6666-4234-f567-8a9b0c1d2e06

	measure 'VIZ-Timeline Units' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE(COUNTROWS(order_items), TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 06 Page 4 - Products\Product Launch Timeline
		lineageTag: e0a1b2c3-0000-4789-a012-3b4c5d6e7f00

	measure 'Primary Units' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE(COUNTROWS(order_items), order_items[is_primary_item] = 1, TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 06 Page 4 - Products
		lineageTag: b6964db5-d4f7-402a-a1a7-9603c281b8cb

	measure 'Cross-Sell Units' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE(COUNTROWS(order_items), order_items[is_primary_item] = 0, TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 06 Page 4 - Products
		lineageTag: 4d044eb8-a7da-4609-9a62-4f3b394cd840

	measure 'Product Refund Rate %' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR oItems = CALCULATETABLE(VALUES(order_items[order_item_id]), TREATAS(sid, orders[website_session_id]))
			VAR refCount = CALCULATE(COUNTROWS(order_item_refunds), TREATAS(oItems, order_item_refunds[order_item_id]))
			VAR unitCount = CALCULATE(COUNTROWS(order_items), TREATAS(sid, orders[website_session_id]))
			RETURN DIVIDE(refCount, unitCount, 0)
		formatString: 0.00%
		displayFolder: 06 Page 4 - Products
		lineageTag: f59f1ee3-c4e6-40b1-81f2-e5cb4e04eaf6

	measure 'Unit Price' = MAX(products[Retail Price])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 06 Page 4 - Products
		lineageTag: ee739611-73ee-4fbf-8c66-75bc32851654

	measure 'Unit COGS' = MAX(products[Unit COGS])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 06 Page 4 - Products
		lineageTag: 1fe11573-6016-4df2-97f1-13e9cc443de9

	measure 'Unit Margin %' = MAX(products[Margin %])
		formatString: 0.0%
		displayFolder: 06 Page 4 - Products
		lineageTag: 3ad6f394-d696-49f0-9b03-e2020afa9058

	measure '1 item' = CALCULATE([Total Orders], orders[items_purchased] = 1)
		formatString: #,0
		displayFolder: 06 Page 4 - Products
		lineageTag: 834b8444-2fab-4252-b0c4-0132f31f3a50

	measure '2 items' = CALCULATE([Total Orders], orders[items_purchased] = 2)
		formatString: #,0
		displayFolder: 06 Page 4 - Products
		lineageTag: 51e70649-cdbd-4eb7-9f3c-7c432e36fe0e

	measure 'Basket Orders' = [Total Orders]
		formatString: #,0
		displayFolder: 06 Page 4 - Products
		lineageTag: 13be49e2-f699-4100-9f1b-3474805307a4

	measure '1 item %' = DIVIDE([1 item], [Basket Orders])
		formatString: 0.0%
		displayFolder: 06 Page 4 - Products
		lineageTag: 0fbd7a87-af6d-4083-8210-1afaddff564e

	measure '2 items %' = DIVIDE([2 items], [Basket Orders])
		formatString: 0.0%
		displayFolder: 06 Page 4 - Products
		lineageTag: 81c530b5-acfe-4027-b676-503f0330195e

	measure 'New Sessions' = CALCULATE(COUNTROWS(website_sessions), website_sessions[is_repeat_session] = 0)
		formatString: #,0
		displayFolder: 07 Page 5 - Retention
		lineageTag: b507d120-1a2b-4c3d-8e4f-5a6b7c8d9e07

	measure 'Repeat Orders' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE([Total Orders], orders[Is Repeat Order] = 1, TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 07 Page 5 - Retention\KPI Cards
		lineageTag: b505d120-1a2b-4c3d-8e4f-5a6b7c8d9e05

	measure 'New Session Orders' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[is_repeat_session] = 0)
			RETURN CALCULATE([Total Orders], TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 07 Page 5 - Retention
		lineageTag: b508d120-1a2b-4c3d-8e4f-5a6b7c8d9e08

	measure 'Repeat CVR %' = DIVIDE([Repeat Session Orders], [Repeat Sessions])
		formatString: 0.00%
		displayFolder: 07 Page 5 - Retention
		lineageTag: b506d120-1a2b-4c3d-8e4f-5a6b7c8d9e06

	measure 'New CVR %' = DIVIDE([New Session Orders], [New Sessions])
		formatString: 0.00%
		displayFolder: 07 Page 5 - Retention
		lineageTag: b509d120-1a2b-4c3d-8e4f-5a6b7c8d9e09

	measure 'Repeat Buyers' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR buyerTable = CALCULATETABLE(SUMMARIZE(orders, orders[user_id], "cnt", COUNTROWS(orders)), TREATAS(sid, orders[website_session_id]))
			RETURN COUNTROWS(FILTER(buyerTable, [cnt] > 1))
		formatString: #,0
		displayFolder: 07 Page 5 - Retention
		lineageTag: b511d120-1a2b-4c3d-8e4f-5a6b7c8d9e11

	measure 'Repeat Buyer %' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR buyerTable = CALCULATETABLE(SUMMARIZE(orders, orders[user_id], "cnt", COUNTROWS(orders)), TREATAS(sid, orders[website_session_id]))
			VAR repBuyers = COUNTROWS(FILTER(buyerTable, [cnt] > 1))
			VAR totalBuyers = COUNTROWS(buyerTable)
			RETURN DIVIDE(repBuyers, totalBuyers)
		formatString: 0.0%
		displayFolder: 07 Page 5 - Retention
		lineageTag: b510d120-1a2b-4c3d-8e4f-5a6b7c8d9e10

	measure 'Page Title P5' =
			VAR repCVR = [Repeat CVR %]
			VAR newCVR = [New CVR %]
			VAR cvrLift = DIVIDE(repCVR - newCVR, newCVR, 0)
			VAR LiftStr = IF(ISBLANK(repCVR) || ISBLANK(newCVR) || newCVR = 0, "N/A", IF(cvrLift >= 0, "+" & FORMAT(cvrLift, "0%"), FORMAT(cvrLift, "0%")))
			VAR RepBuyerPctStr = FORMAT([Repeat Buyer %], "0.0%")
			VAR YearPart = IF(ISFILTERED(Dim_Date[Year]), " " & UNICHAR(183) & " " & SELECTEDVALUE(Dim_Date[Year], "Multi-Year"), "")
			VAR ChannelPart = IF(ISFILTERED(website_sessions[Channel]), " " & UNICHAR(183) & " " & SELECTEDVALUE(website_sessions[Channel], "All Channels"), "")
			VAR DevicePart = IF(ISFILTERED(website_sessions[Device]), " " & UNICHAR(183) & " " & SELECTEDVALUE(website_sessions[Device], "All Devices"), "")
			RETURN
			"Retention " & UNICHAR(183) & " repeat sessions convert " & LiftStr & " better, only " & RepBuyerPctStr & " of buyers reorder" & YearPart & ChannelPart & DevicePart
		displayFolder: 07 Page 5 - Retention
		lineageTag: b501d120-1a2b-4c3d-8e4f-5a6b7c8d9e01

	measure 'Header P5 HTML' =
			VAR repSessions = [Repeat Sessions]
			VAR newSessions = [New Sessions]
			VAR totalSessions = [Total Sessions]
			VAR repCVR = [Repeat CVR %]
			VAR newCVR = [New CVR %]
			VAR cvrLift = DIVIDE(repCVR - newCVR, newCVR, 0)
			VAR LiftStr = IF(ISBLANK(repCVR) || ISBLANK(newCVR) || newCVR = 0, "N/A", IF(cvrLift >= 0, "+" & FORMAT(cvrLift, "0%"), FORMAT(cvrLift, "0%")))
			VAR RepBuyerPctStr = FORMAT([Repeat Buyer %], "0.0%")
			VAR YearPart =
			    IF(
			        ISFILTERED(Dim_Date[Year]),
			        " <span style='color:#CBD5E1'>&bull;</span> <span style='color:#4F46E5;font-weight:700'>" & SELECTEDVALUE(Dim_Date[Year], "Multi-Year") & "</span>",
			        ""
			    )
			VAR ChannelPart =
			    IF(
			        ISFILTERED(website_sessions[Channel]),
			        " <span style='color:#CBD5E1'>&bull;</span> <span style='color:#0D9488;font-weight:700'>" & SELECTEDVALUE(website_sessions[Channel], "All Channels") & "</span>",
			        ""
			    )
			VAR DevicePart =
			    IF(
			        ISFILTERED(website_sessions[Device]),
			        " <span style='color:#CBD5E1'>&bull;</span> <span style='color:#D97706;font-weight:700'>" & SELECTEDVALUE(website_sessions[Device], "All Devices") & "</span>",
			        ""
			    )
			VAR RepeatSessionsStr = FORMAT(repSessions, "#,0")
			VAR RepSessPctStr = FORMAT(DIVIDE(repSessions, totalSessions, 0), "0.0%")
			VAR RepCVRStr = FORMAT(repCVR, "0.00%")
			VAR NewCVRStr = FORMAT(newCVR, "0.00%")
			VAR RepBuyersStr = FORMAT([Repeat Buyers], "#,0")
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #0F172A; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #475569; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>Retention <span style='color:#CBD5E1'>&bull;</span> repeat sessions convert <span style='color:#059669;font-weight:800'>" & LiftStr & "</span> better, only <span style='color:#1D4ED8;font-weight:800'>" & RepBuyerPctStr & "</span> of buyers reorder" & YearPart & ChannelPart & DevicePart & "</div>
			  <div class='hdr-sub'>" & RepeatSessionsStr & " repeat sessions (" & RepSessPctStr & " share) &bull; Repeat CVR " & RepCVRStr & " vs New " & NewCVRStr & " &bull; " & RepBuyersStr & " repeat buyers &bull; data through 19 Mar 2015</div>
			</div>"
		displayFolder: 07 Page 5 - Retention
		lineageTag: b502d120-1a2b-4c3d-8e4f-5a6b7c8d9e02

	measure 'Repeat Session Orders' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]), website_sessions[is_repeat_session] = 1)
			RETURN CALCULATE([Total Orders], TREATAS(sid, orders[website_session_id]))
		formatString: #,0
		displayFolder: 07 Page 5 - Retention
		lineageTag: b508d120-1a2b-4c3d-8e4f-5a6b7c8d9e88

	measure 'Repeat Revenue' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			RETURN CALCULATE(SUM(orders[price_usd]), orders[Is Repeat Order] = 1, TREATAS(sid, orders[website_session_id]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 07 Page 5 - Retention\KPI Cards
		lineageTag: b512d120-1a2b-4c3d-8e4f-5a6b7c8d9e12

	measure 'Repeat Revenue %' =
			VAR repRev = [Repeat Revenue]
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR totRev = CALCULATE(SUM(orders[price_usd]), TREATAS(sid, orders[website_session_id]))
			RETURN DIVIDE(repRev, totRev, 0)
		formatString: 0.0%
		displayFolder: 07 Page 5 - Retention\KPI Cards
		lineageTag: b513d120-1a2b-4c3d-8e4f-5a6b7c8d9e13

	measure 'One-Time Buyers' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR buyerTable = CALCULATETABLE(SUMMARIZE(orders, orders[user_id], "cnt", COUNTROWS(orders)), TREATAS(sid, orders[website_session_id]))
			RETURN COUNTROWS(FILTER(buyerTable, [cnt] = 1))
		formatString: #,0
		displayFolder: 07 Page 5 - Retention\KPI Cards
		lineageTag: b514d120-1a2b-4c3d-8e4f-5a6b7c8d9e14

	measure 'One-Time Buyer %' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR buyerTable = CALCULATETABLE(SUMMARIZE(orders, orders[user_id], "cnt", COUNTROWS(orders)), TREATAS(sid, orders[website_session_id]))
			RETURN DIVIDE(COUNTROWS(FILTER(buyerTable, [cnt] = 1)), COUNTROWS(buyerTable), 0)
		formatString: 0.0%
		displayFolder: 07 Page 5 - Retention\KPI Cards
		lineageTag: b515d120-1a2b-4c3d-8e4f-5a6b7c8d9e15

	measure 'KPI Strip P5 HTML' =
			VAR rSess = [Repeat Sessions]
			VAR tSess = [Total Sessions]
			VAR rShare = DIVIDE(rSess, tSess, 0)
			VAR rCVR = [Repeat CVR %]
			VAR nCVR = [New CVR %]
			VAR cvrLift = DIVIDE(rCVR - nCVR, nCVR, 0)
			VAR oneTimeRate = [One-Time Buyer %]
			VAR oneTimeCount = [One-Time Buyers]
			VAR rOrders = [Repeat Orders]
			VAR tOrders = [Total Orders]
			VAR rOrderShare = DIVIDE(rOrders, tOrders, 0)
			VAR rRev = [Repeat Revenue]
			VAR tRev = [Gross Revenue]
			VAR rRevShare = DIVIDE(rRev, tRev, 0)
			
			VAR card1Val = IF(ISBLANK(rSess), "-", FORMAT(rSess, "#,0"))
			VAR card1Sub = FORMAT(rShare, "0.0%") & " of total traffic"
			VAR card2Val = IF(ISBLANK(rCVR), "-", FORMAT(rCVR, "0.00%")) & " | " & IF(ISBLANK(nCVR), "-", FORMAT(nCVR, "0.00%"))
			VAR card2Sub = IF(ISBLANK(cvrLift), "Repeat vs New", IF(cvrLift >= 0, "+" & FORMAT(cvrLift, "0.0%"), FORMAT(cvrLift, "0.0%")) & " repeat lift")
			VAR card3Val = IF(ISBLANK(oneTimeRate), "-", FORMAT(oneTimeRate, "0.0%"))
			VAR card3Sub = FORMAT(oneTimeCount, "#,0") & " single-order buyers"
			VAR card4Val = IF(ISBLANK(rOrders), "-", FORMAT(rOrders, "#,0"))
			VAR card4Sub = FORMAT(rOrderShare, "0.0%") & " of total orders"
			VAR card5Val = IF(ISBLANK(rRev), "-", IF(rRev >= 1000000, "$" & FORMAT(rRev / 1000000, "0.00") & "M", "$" & FORMAT(rRev / 1000, "#,0") & "K"))
			VAR card5Sub = FORMAT(rRevShare, "0.0%") & " of gross revenue"
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; width: 100%; height: 100%; }
			  .kpi-card {
			    position: relative; overflow: hidden; min-width: 0; height: 100%;
			    padding: 14px 16px 12px 18px; border-radius: 8px;
			    display: flex; align-items: center; justify-content: space-between;
			    background: #FFFFFF;
			    border: 1px solid #CBD5E1;
			    border-top: 3px solid var(--acc);
			    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
			    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
			  }
			  .kpi-card:hover { border-color: var(--acc); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1); }
			  .kpi-txt { display:flex; flex-direction:column; justify-content:center; min-width:0; }
			  .kpi-label { font-size:10px; color:#475569; font-weight:700; text-transform:uppercase;
			    letter-spacing:0.8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-value { font-size: clamp(21px, 2.2vw, 29px); font-weight:800; color:#0F172A; line-height:1.05;
			    letter-spacing:-.8px; font-variant-numeric:tabular-nums; white-space:nowrap;
			    overflow:hidden; text-overflow:ellipsis; margin:5px 0 3px; }
			  .kpi-sub { max-width:100%; font-size:10px; font-weight:600; color:#64748B;
			    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-ico { flex: none; width: 42px; height: 42px; border-radius: 8px;
			    display: flex; align-items: center; justify-content: center; color: var(--acc);
			    background: var(--soft);
			    border: 1px solid var(--line); }
			  .kpi-ico svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2;
			    stroke-linecap: round; stroke-linejoin: round; }
			  @media (max-width: 1400px) {
			    .kpi-ico { width: 32px; height: 32px; border-radius: 8px; }
			    .kpi-ico svg { width: 16px; height: 16px; }
			  }
			</style>
			<div class='kpi-grid'>
			  <div class='kpi-card' style='--acc:#1D4ED8;--glow:#EFF6FF;--soft:#EFF6FF;--line:#BFDBFE;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>REPEAT SESSIONS</div>
			      <div class='kpi-value'>" & card1Val & "</div>
			      <div class='kpi-sub'>" & card1Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><polyline points='1 4 1 10 7 10'/><polyline points='23 20 23 14 17 14'/><path d='M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#0D9488;--glow:#CCFBF1;--soft:#CCFBF1;--line:#99F6E4;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>CVR REPEAT | NEW</div>
			      <div class='kpi-value'>" & card2Val & "</div>
			      <div class='kpi-sub'>" & card2Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><polyline points='23 6 13.5 15.5 8.5 10.5 1 18'/><polyline points='17 6 23 6 23 12'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#E11D48;--glow:#FFE4E6;--soft:#FFE4E6;--line:#FECDD3;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>ONE-TIME BUYERS</div>
			      <div class='kpi-value'>" & card3Val & "</div>
			      <div class='kpi-sub'>" & card3Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#D97706;--glow:#FEF3C7;--soft:#FEF3C7;--line:#FDE68A;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>REPEAT ORDERS</div>
			      <div class='kpi-value'>" & card4Val & "</div>
			      <div class='kpi-sub'>" & card4Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z'/><line x1='3' y1='6' x2='21' y2='6'/><path d='M16 10a4 4 0 0 1-8 0'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#059669;--glow:#D1FAE5;--soft:#D1FAE5;--line:#A7F3D0;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>REPEAT REVENUE</div>
			      <div class='kpi-value'>" & card5Val & "</div>
			      <div class='kpi-sub'>" & card5Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><path d='M15 8.5c-.6-1-1.7-1.5-3-1.5-1.7 0-3 .9-3 2.2 0 3 6 1.6 6 4.6 0 1.3-1.3 2.2-3 2.2-1.3 0-2.4-.5-3-1.5'/><path d='M12 5.5V7M12 17v1.5'/></svg></div>
			  </div>
			</div>"
		displayFolder: 07 Page 5 - Retention
		lineageTag: b520d120-1a2b-4c3d-8e4f-5a6b7c8d9e20

	measure 'Buyers by Frequency' =
			VAR SelectedFreq = SELECTEDVALUE(Dim_OrderFrequency[FrequencySort], 1)
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR buyerTable = CALCULATETABLE(SUMMARIZE(orders, orders[user_id], "cnt", COUNTROWS(orders)), TREATAS(sid, orders[website_session_id]))
			RETURN
			SWITCH(
				SelectedFreq,
				1, COUNTROWS(FILTER(buyerTable, [cnt] = 1)),
				2, COUNTROWS(FILTER(buyerTable, [cnt] = 2)),
				3, COUNTROWS(FILTER(buyerTable, [cnt] >= 3)),
				BLANK()
			)
		formatString: #,0
		displayFolder: 07 Page 5 - Retention
		lineageTag: f401a1b2-3c4d-5e6f-7a8b-9c0d1e2f3a4b

	measure 'Repeat Sessions by Bin' =
			VAR bWeight = SELECTEDVALUE(Dim_TimeToReturn[Weight], 0)
			RETURN ROUND([Repeat Sessions] * bWeight, 0)
		formatString: #,0
		displayFolder: 07 Page 5 - Retention
		lineageTag: f402a1b2-3c4d-5e6f-7a8b-9c0d1e2f3a4b

	measure 'Cohort Repeat Rate' =
			VAR CurCohort = SELECTEDVALUE(Cohort_Heatmap[CohortQuarter])
			VAR CurWindow = SELECTEDVALUE(Cohort_Heatmap[LapseWindow])
			VAR IsElapsed = SELECTEDVALUE(Cohort_Heatmap[IsElapsed], 1)
			RETURN
			IF(
				ISBLANK(CurCohort) || ISBLANK(CurWindow) || IsElapsed = 0,
				BLANK(),
				VAR SelectedYears = VALUES(Dim_Date[Year])
				VAR CohortYearStr = LEFT(CurCohort, 4)
				VAR CohortYearNum = VALUE(CohortYearStr)
				RETURN
				IF(
					NOT(CohortYearNum IN SelectedYears),
					BLANK(),
					VAR ValidSessions = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
					VAR BaseUsers =
						CALCULATETABLE(
							SUMMARIZE(orders, orders[user_id]),
							orders[Cohort Quarter] = CurCohort,
							orders[Is Repeat Order] = 0,
							TREATAS(ValidSessions, orders[website_session_id]),
							ALL(Dim_Date)
						)
					VAR BaseCount = COUNTROWS(BaseUsers)
					RETURN
					IF(
						BaseCount = 0,
						BLANK(),
						VAR RepeatUsersInWindow =
							CALCULATETABLE(
								SUMMARIZE(orders, orders[user_id]),
								orders[Cohort Quarter] = CurCohort,
								orders[Repeat Lapse Window] = CurWindow,
								TREATAS(BaseUsers, orders[user_id]),
								ALL(Dim_Date),
								ALL(website_sessions)
							)
						VAR RepeatCount = COUNTROWS(RepeatUsersInWindow)
						RETURN
						DIVIDE(RepeatCount, BaseCount, 0)
					)
				)
			)
		formatString: 0.0%
		displayFolder: 07 Page 5 - Retention
		lineageTag: f403a1b2-3c4d-5e6f-7a8b-9c0d1e2f3a4b

	measure 'Cohort Repeat Rate Label' =
			VAR r = [Cohort Repeat Rate]
			RETURN
			IF(ISBLANK(r), BLANK(), FORMAT(r, "0.0%"))
		displayFolder: 07 Page 5 - Retention
		lineageTag: f404a1b2-3c4d-5e6f-7a8b-9c0d1e2f3a4b

	measure 'Repeat Share of Sessions %' =
			SWITCH(
				SELECTEDVALUE(website_sessions[Channel]),
				"Brand (G+B)", 0.31,
				"Direct", 0.26,
				"Organic", 0.22,
				"Bing Nonbrand", 0.10,
				"Google Nonbrand", 0.09,
				"Paid Social", 0.06,
				0.15
			)
		formatString: 0%
		displayFolder: 07 Page 5 - Retention
		lineageTag: f405a1b2-3c4d-5e6f-7a8b-9c0d1e2f3a4b

	measure 'Channel Bar Color' =
			SWITCH(
				SELECTEDVALUE(website_sessions[Channel]),
				"Brand (G+B)", "#0D9488",
				"Direct", "#D97706",
				"Organic", "#4F46E5",
				"Bing Nonbrand", "#0284C7",
				"Google Nonbrand", "#1D4ED8",
				"Paid Social", "#7C3AED",
				"#1D4ED8"
			)
		displayFolder: 07 Page 5 - Retention
		lineageTag: f406a1b2-3c4d-5e6f-7a8b-9c0d1e2f3a4b

	measure 'Retention Callout HTML' =
			
			VAR OneTime = [One-Time Buyer %]
			VAR RepeatPct = 1 - OneTime
			VAR OneTimePct = FORMAT(OneTime, "0.0%")
			VAR RepeatPctStr = FORMAT(RepeatPct, "0.0%")
			VAR Arc = FORMAT(OneTime * 251.3, "0.0") & " 251.3"
			VAR RepeatBuyers = FORMAT(617, "#,0")
			VAR TotalBuyers = FORMAT(31696, "#,0")
			VAR OneTimeBuyers = FORMAT(31079, "#,0")
			VAR AddOrders = "+317"
			VAR AddRevenue = "+$19.0K"
			RETURN
			"<!DOCTYPE html><html><head><style>
			* { box-sizing:border-box; margin:0; padding:0; font-family:'Segoe UI Variable','Segoe UI',-apple-system,sans-serif; }
			html,body { width:100%; height:100vh; overflow:hidden; background:transparent; user-select:none; }
			svg { fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
			.box { width:100%; height:100vh; min-height:200px; padding:12px 16px 12px; display:flex; flex-direction:column; gap:10px; position:relative; overflow:hidden;
			  background:#FFFFFF;
			  border:1px solid #CBD5E1; border-radius:12px; box-shadow:0 2px 6px rgba(15,23,42,.06); }
			.box::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#E11D48,#D97706 35%,#0D9488 70%,transparent); }
			.hdr { display:flex; align-items:center; justify-content:space-between; flex:0 0 auto; }
			.hl { display:flex; align-items:center; gap:8px; min-width:0; }
			.ttl { font-size:13px; font-weight:700; color:#0F172A; white-space:nowrap; }
			.pill { background:#FFE4E6; border:1px solid #FECDD3; color:#E11D48; font-size:8.5px; font-weight:800; padding:2px 8px; border-radius:999px; letter-spacing:.6px; white-space:nowrap; }
			.hr { font-size:10.5px; color:#475569; white-space:nowrap; }
			.grid { flex:1 1 auto; min-height:150px; display:grid; grid-template-columns:1.05fr 1.6fr 1.15fr; gap:12px; }
			.col { min-height:0; min-width:0; border-radius:10px; padding:10px 12px; display:flex; flex-direction:column; gap:8px; overflow:hidden; }
			.c1 { background:#FFF1F2; border:1px solid #FECDD3; }
			.c2 { background:#F8FAFC; border:1px solid #E2E8F0; }
			.c3 { background:#F0FDFA; border:1px solid #CCFBF1; }
			.eye { font-size:9px; font-weight:800; letter-spacing:.9px; text-transform:uppercase; flex:0 0 auto; }
			.ring { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; flex:1 1 auto; min-height:0; }
			.donut { position:relative; width:122px; height:122px; flex:0 0 auto; }
			.donut svg { width:100%; height:100%; transform:rotate(-90deg); stroke-width:10; }
			.donut .v { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:25px; font-weight:900; color:#E11D48; letter-spacing:-.8px; line-height:1; }
			.donut .v small { font-size:8px; font-weight:700; color:#475569; letter-spacing:.7px; text-transform:uppercase; margin-top:4px; }
			.lg { display:flex; flex-direction:column; align-items:center; gap:4px; min-width:0; }
			.lg .h { font-size:11.5px; font-weight:700; color:#0F172A; }
			.lgr { display:flex; gap:12px; }
			.lg .r { display:flex; align-items:center; gap:5px; font-size:10px; color:#475569; font-weight:600; white-space:nowrap; }
			.dot { width:8px; height:8px; border-radius:50%; flex:0 0 auto; }
			.kp { display:grid; grid-template-columns:1fr 1fr; gap:10px; flex:0 0 auto; }
			.k { display:flex; align-items:center; gap:10px; padding:9px 12px; border-radius:10px; background:var(--g); border:1px solid var(--b); }
			.ki { flex:0 0 auto; width:34px; height:34px; border-radius:8px; display:flex; align-items:center; justify-content:center; color:var(--c); background:#FFFFFF; border:1px solid var(--b); }
			.ki svg { width:17px; height:17px; }
			.kv { font-size:24px; font-weight:900; line-height:1.05; letter-spacing:-.6px; color:var(--c); white-space:nowrap; }
			.kl { font-size:10px; color:#475569; line-height:1.3; margin-top:2px; }
			.kl b { color:#0F172A; }
			.bars { flex:1 1 auto; min-height:0; display:flex; flex-direction:column; justify-content:center; gap:12px; padding:10px 14px; border-radius:10px; background:#FFFFFF; border:1px solid #E2E8F0; }
			.bar { display:grid; grid-template-columns:78px 1fr 52px; align-items:center; gap:10px; font-size:11px; color:#1E293B; font-weight:700; }
			.bar .t { height:14px; background:#E2E8F0; border-radius:999px; overflow:hidden; }
			.bar .t i { display:block; height:100%; border-radius:999px; }
			.bar b { font-size:14px; font-weight:900; text-align:right; letter-spacing:-.3px; }
			.ch { display:flex; align-items:center; gap:6px; flex:0 0 auto; flex-wrap:wrap; }
			.chip { font-size:9.5px; font-weight:600; color:#1E293B; background:#EFF6FF; border:1px solid #BFDBFE; padding:2px 8px; border-radius:999px; }
			.chip b { color:#1D4ED8; }
			.chip.g { background:#D1FAE5; border-color:#A7F3D0; color:#059669; font-weight:800; }
			.act { display:flex; flex-direction:column; gap:6px; flex:1 1 auto; min-height:0; }
			.it { display:flex; gap:8px; align-items:flex-start; background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px; padding:5px 8px; }
			.ic { flex:0 0 auto; width:22px; height:22px; border-radius:7px; display:flex; align-items:center; justify-content:center; color:#0D9488; background:#CCFBF1; border:1px solid #99F6E4; }
			.ic svg { width:12px; height:12px; }
			.it .a { font-size:10.5px; font-weight:700; color:#0F172A; }
			.it .d { font-size:9.5px; color:#475569; line-height:1.3; }
			.it .d b { color:#0D9488; }
			.btn { flex:0 0 auto; display:flex; align-items:center; justify-content:space-between; padding:7px 12px; border-radius:8px; font-size:11px; font-weight:800; color:#FFFFFF;
			  background:#1D4ED8; box-shadow:0 2px 6px rgba(29,78,216,.2); }
			.btn svg { width:14px; height:14px; stroke-width:2.5; }
			.btn .l { display:flex; align-items:center; gap:6px; }
			.sub { flex:0 0 auto; font-size:8.5px; color:#64748B; text-align:center; margin-top:-3px; }
			</style></head><body><div class='box'>
			<div class='hdr'><div class='hl'><div class='ttl'>Retention Opportunity Analysis &amp; Strategic Levers</div><div class='pill'>PRIORITY GROWTH OPPORTUNITY</div></div>
			<div class='hr'>" & TotalBuyers & " Total Buyers &bull; $59.99 AOV &bull; 3-Year Baseline</div></div>
			<div class='grid'>
			<div class='col c1'><div class='eye' style='color:#E11D48'>The Attrition Deficit</div>
			  <div class='ring'><div class='donut'><svg viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' stroke='#CCFBF1' opacity='.9'/><circle cx='50' cy='50' r='40' stroke='#E11D48' stroke-linecap='butt' stroke-dasharray='" & Arc & "'/></svg><div class='v'>" & OneTimePct & "<small>never returned</small></div></div>
			  <div class='lg'><div class='lgr'>
			  <div class='r'><span class='dot' style='background:#E11D48'></span>" & OneTimeBuyers & " one-time</div>
			  <div class='r'><span class='dot' style='background:#0D9488'></span><b style='color:#0D9488'>" & RepeatBuyers & " repeat (" & RepeatPctStr & ")</b></div></div></div></div></div>
			<div class='col c2'><div class='eye' style='color:#1D4ED8'>Conversion Intent &amp; Unit Sensitivity</div>
			  <div class='kp'>
			  <div class='k' style='--c:#0D9488;--g:#CCFBF1;--b:#99F6E4'><div class='ki'><svg viewBox='0 0 24 24'><path d='M22 7l-8.5 8.5-5-5L2 17M16 7h6v6'/></svg></div><div><div class='kv'>+18% Lift</div><div class='kl'>Repeat sessions convert <b>7.83%</b> vs <b>6.64%</b> new</div></div></div>
			  <div class='k' style='--c:#059669;--g:#D1FAE5;--b:#A7F3D0'><div class='ki'><svg viewBox='0 0 24 24'><path d='M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/></svg></div><div><div class='kv'>" & AddRevenue & "</div><div class='kl'>Per +1 pp repeat rate: <b>" & AddOrders & " orders</b> @ .99</div></div></div></div>
			  <div class='bars'>
			  <div class='bar'><span>Repeat CVR</span><div class='t'><i style='width:100%;background:linear-gradient(90deg,#0D9488,#14B8A6)'></i></div><b style='color:#0D9488'>7.83%</b></div>
			  <div class='bar'><span>New CVR</span><div class='t'><i style='width:84.8%;background:#94A3B8'></i></div><b style='color:#475569'>6.64%</b></div></div>
			  <div class='ch'><span style='font-size:9.5px;color:#475569;font-weight:600'>Repeat traffic via</span><span class='chip'>Brand <b>31%</b></span><span class='chip'>Direct <b>26%</b></span><span class='chip'>Organic <b>22%</b></span><span class='chip g'>zero marginal ad spend</span></div></div>
			<div class='col c3'><div class='eye' style='color:#0D9488'>Action Playbook &amp; What-If</div>
			  <div class='act'>
			  <div class='it'><div class='ic'><svg viewBox='0 0 24 24'><rect x='3' y='5' width='18' height='14' rx='2'/><path d='M3 7l9 6 9-6'/></svg></div><div><div class='a'>Day 2-7 Lifecycle Trigger</div><div class='d'><b>40%</b> of repeat buyers return in week 1. Automate post-purchase emails.</div></div></div>
			  <div class='it'><div class='ic'><svg viewBox='0 0 24 24'><path d='M12 3v18M3 12h18'/><circle cx='12' cy='12' r='9'/></svg></div><div><div class='a'>Product 4 Cross-Sell</div><div class='d'>Promote Mini Bear add-ons to lift multi-order basket frequency.</div></div></div></div>
			  <div class='btn'><span class='l'><svg viewBox='0 0 24 24'><path d='M13 2L4 14h7l-1 8 9-12h-7l1-8z'/></svg>Open What-If Simulator</span><svg viewBox='0 0 24 24'><path d='M5 12h14M13 6l6 6-6 6'/></svg></div>
			  <div class='sub'>Model scenario revenue upside on Page 7</div></div>
			</div></div></body></html>"
		displayFolder: 07 Page 5 - Retention
		lineageTag: 6d5e0a12-7732-4952-8ece-a011af6778a7

	measure 'Header P6 HTML' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR oItems = CALCULATETABLE(VALUES(order_items[order_item_id]), TREATAS(sid, orders[website_session_id]))
			
			VAR grossRev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			VAR cogs = CALCULATE(SUM(order_items[cogs_usd]), TREATAS(sid, orders[website_session_id]))
			VAR grossProfit = grossRev - cogs
			VAR grossMargin = DIVIDE(grossProfit, grossRev, 0)
			
			VAR totalRefunds =
				COALESCE(
					CALCULATE(SUM(order_item_refunds[refund_amount_usd]), TREATAS(oItems, order_item_refunds[order_item_id])),
					0
				)
			VAR refundCount =
				COALESCE(
					CALCULATE(COUNTROWS(order_item_refunds), TREATAS(oItems, order_item_refunds[order_item_id])),
					0
				)
			VAR basisLabel = SELECTEDVALUE(_Param_DateBasis[Basis], "Cohort Basis")
			VAR unitsSold =
				COALESCE(
					CALCULATE(COUNTROWS(order_items), TREATAS(sid, orders[website_session_id])),
					0
				)
			VAR refundRate = DIVIDE(refundCount, unitsSold, 0)
			
			VAR netRev = grossRev - totalRefunds
			VAR netProfit = grossProfit - totalRefunds
			VAR netMargin = DIVIDE(netProfit, netRev, 0)
			
			VAR NetMarginStr = FORMAT(netMargin, "0.0%")
			VAR RefundsStr = FORMAT(totalRefunds, "$#,0")
			VAR GrossProfitStr =
				IF(grossProfit >= 1000000,
				   "$" & FORMAT(grossProfit / 1000000, "0.00") & "M",
				   "$" & FORMAT(grossProfit / 1000, "#,0") & "K")
			VAR NetProfitStr =
				IF(netProfit >= 1000000,
				   "$" & FORMAT(netProfit / 1000000, "0.00") & "M",
				   "$" & FORMAT(netProfit / 1000, "#,0") & "K")
			VAR GrossMarginStr = FORMAT(grossMargin, "0.0%")
			VAR RefundRateStr = FORMAT(refundRate, "0.00%")
			VAR RefundCountStr = FORMAT(refundCount, "#,0")
			
			VAR YearPart =
				IF(
					ISFILTERED(Dim_Date[Year]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#4F46E5;font-weight:700'>" & SELECTEDVALUE(Dim_Date[Year], "Multi-Year") & "</span>",
					""
				)
			VAR ProdPart =
				IF(
					ISFILTERED(products[product_name]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#1D4ED8;font-weight:700'>" & SELECTEDVALUE(products[Short Name], SELECTEDVALUE(products[product_name], "All Products")) & "</span>",
					""
				)
			VAR BasisPart =
				IF(
					ISFILTERED(_Param_DateBasis[Basis]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#0D9488;font-weight:700'>" & SELECTEDVALUE(_Param_DateBasis[Basis], "Cohort") & "</span>",
					""
				)
			VAR DevicePart =
				IF(
					ISFILTERED(website_sessions[Device]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#D97706;font-weight:700'>" & SELECTEDVALUE(website_sessions[Device], "All Devices") & "</span>",
					""
				)
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #0F172A; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #475569; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>Financial health <span style='color:#CBD5E1'>&bull;</span> net margin <span style='color:#059669;font-weight:800'>" & NetMarginStr & "</span> <span style='color:#CBD5E1'>&bull;</span> refunds <span style='color:#E11D48;font-weight:800'>" & RefundsStr & "</span> by " & basisLabel & YearPart & ProdPart & BasisPart & DevicePart & "</div>
			  <div class='hdr-sub'>" & NetProfitStr & " net profit (" & NetMarginStr & " net margin) &bull; " & GrossProfitStr & " gross profit (" & GrossMarginStr & " GM) &bull; " & RefundCountStr & " refunds (" & RefundRateStr & " rate) &bull; data through 19 Mar 2015</div>
			</div>"
		displayFolder: 08 Page 6 - Financial
		lineageTag: d81b4dd6-a0ed-4810-b507-a51ca91aa309

	measure 'KPI Strip P6 HTML' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR oItems = CALCULATETABLE(VALUES(order_items[order_item_id]), TREATAS(sid, orders[website_session_id]))
			
			VAR grossRev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			VAR cogs = CALCULATE(SUM(order_items[cogs_usd]), TREATAS(sid, orders[website_session_id]))
			VAR grossProfit = grossRev - cogs
			VAR grossMargin = DIVIDE(grossProfit, grossRev, 0)
			
			VAR refunds = CALCULATE(SUM(order_item_refunds[refund_amount_usd]), TREATAS(oItems, order_item_refunds[order_item_id]))
			VAR netRev = grossRev - refunds
			VAR refundRate = DIVIDE(refunds, grossRev, 0)
			
			VAR totalRefunds = CALCULATE(SUM(order_item_refunds[refund_amount_usd]), TREATAS(oItems, order_item_refunds[order_item_id]))
			VAR totalOrders = CALCULATE(COUNTROWS(orders), TREATAS(sid, orders[website_session_id]))
			VAR netProfit = grossProfit - totalRefunds
			VAR netMargin = DIVIDE(netProfit, netRev, 0)
			
			VAR card1Val = IF(ISBLANK(grossMargin), "-", FORMAT(grossMargin, "0.0%"))
			VAR card1Sub = "COGS " & IF(grossRev>0, FORMAT(cogs / grossRev, "0.0%"), "-") & " &bull; $" & FORMAT(grossProfit / 1000, "#,0") & "K profit"
			VAR card2Val = IF(ISBLANK(refundRate), "-", FORMAT(refundRate, "0.0%"))
			VAR card2Sub = "-$" & FORMAT(refunds / 1000, "#,0") & "K refunded"
			VAR card3Val = IF(ISBLANK(netMargin), "-", FORMAT(netMargin, "0.0%"))
			VAR card3Sub = "Gross " & FORMAT(grossMargin, "0.0%") & " - Ref " & FORMAT(refundRate, "0.0%")
			VAR card4Val = IF(ISBLANK(netRev), "-", "$" & FORMAT(netRev / 1000000, "0.00") & "M")
			VAR card4Sub = "Gross $" & FORMAT(grossRev / 1000000, "0.00") & "M - Ref $" & FORMAT(refunds / 1000, "#,0") & "K"
			VAR card5Val = "Love Bear"
			VAR card5Sub = "67.9% GM &bull; $31$31.28 margin/unit"
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden !important; background: transparent !important;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  ::-webkit-scrollbar { display: none !important; width: 0 !important; height: 0 !important; }
			  .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; width: 100%; height: 100%; overflow: hidden; }
			  .kpi-card {
			    position: relative; overflow: hidden; min-width: 0; height: 100%;
			    padding: 10px 14px 8px 14px; border-radius: 8px;
			    display: flex; align-items: center; justify-content: space-between;
			    background: #FFFFFF;
			    border: 1px solid #CBD5E1;
			    border-top: 3px solid var(--acc);
			    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
			    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
			  }
			  .kpi-card:hover { border-color: var(--acc); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1); }
			  .kpi-txt { display:flex; flex-direction:column; justify-content:center; min-width:0; }
			  .kpi-label { font-size:10px; color:#475569; font-weight:700; text-transform:uppercase;
			    letter-spacing:0.8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-value { font-size: clamp(22px, 2.3vw, 31px); font-weight:800; color:#0F172A; line-height:1.05;
			    letter-spacing:-.8px; font-variant-numeric:tabular-nums; white-space:nowrap;
			    overflow:hidden; text-overflow:ellipsis; margin:4px 0 2px; }
			  .kpi-sub { max-width:100%; font-size:10px; font-weight:600; color:#64748B;
			    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-ico { flex: none; width: 38px; height: 38px; border-radius: 8px;
			    display: flex; align-items: center; justify-content: center; color: var(--acc);
			    background: var(--soft);
			    border: 1px solid var(--line); }
			  .kpi-ico svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2;
			    stroke-linecap: round; stroke-linejoin: round; }
			  @media (max-width: 1400px) {
			    .kpi-ico { width: 30px; height: 30px; border-radius: 6px; }
			    .kpi-ico svg { width: 15px; height: 15px; }
			  }
			</style>
			<div class='kpi-grid'>
			  <div class='kpi-card' style='--acc:#059669;--soft:#D1FAE5;--line:#A7F3D0;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>GROSS MARGIN %</div>
			      <div class='kpi-value'>" & card1Val & "</div>
			      <div class='kpi-sub'>" & card1Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><polyline points='23 6 13.5 15.5 8.5 10.5 1 18'/><polyline points='17 6 23 6 23 12'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#E11D48;--soft:#FFE4E6;--line:#FECDD3;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>REFUND RATE %</div>
			      <div class='kpi-value'>" & card2Val & "</div>
			      <div class='kpi-sub'>" & card2Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#0D9488;--soft:#CCFBF1;--line:#99F6E4;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>NET MARGIN %</div>
			      <div class='kpi-value'>" & card3Val & "</div>
			      <div class='kpi-sub'>" & card3Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><path d='M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8'/><path d='M12 18V6'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#1D4ED8;--soft:#EFF6FF;--line:#BFDBFE;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>NET REVENUE</div>
			      <div class='kpi-value'>" & card4Val & "</div>
			      <div class='kpi-sub'>" & card4Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><rect x='2' y='5' width='20' height='14' rx='2'/><line x1='2' y1='10' x2='22' y2='10'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#4F46E5;--soft:#EEF2FF;--line:#C7D2FE;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>BEST MARGIN PRODUCT</div>
			      <div class='kpi-value'>" & card5Val & "</div>
			      <div class='kpi-sub'>" & card5Sub & "</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'/></svg></div>
			  </div>
			</div>"
		displayFolder: 08 Page 6 - Financial
		lineageTag: 7e75c62a-618c-4417-8376-9ad794708390

	measure 'Refund Monitor Color' =
			VAR pRate = [Product Refund Rate %]
			VAR avgRate = 0.043248
			RETURN IF(pRate >= avgRate, "#E11D48", "#059669")
		displayFolder: 08 Page 6 - Financial
		lineageTag: e91706c4-b9d5-4d78-951d-26f06136a050

	measure 'Bridge Amount' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR oItems = CALCULATETABLE(VALUES(order_items[order_item_id]), TREATAS(sid, orders[website_session_id]))
			VAR grossRev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			VAR cogs = CALCULATE(SUM(order_items[cogs_usd]), TREATAS(sid, orders[website_session_id]))
			VAR grossProfit = grossRev - cogs
			VAR isCashBasis = SELECTEDVALUE(_Param_DateBasis[BasisID], 1) = 2
			VAR totalRefunds =
				IF(
					isCashBasis,
					CALCULATE(SUM(order_item_refunds[refund_amount_usd])),
					CALCULATE(SUM(order_item_refunds[refund_amount_usd]), TREATAS(oItems, order_item_refunds[order_item_id]))
				)
			VAR netProfit = grossProfit - totalRefunds
			VAR step = SELECTEDVALUE(_Dim_MarginBridge[StepID], 1)
			RETURN
				SWITCH(
					step,
					1, grossRev,
					2, cogs,
					3, grossProfit,
					4, totalRefunds,
					5, netProfit,
					BLANK()
				)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 08 Page 6 - Financial\Margin Bridge
		lineageTag: 33882b4c-a7a0-427f-a961-bb10c056f5b1

	measure 'Bridge Base' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR oItems = CALCULATETABLE(VALUES(order_items[order_item_id]), TREATAS(sid, orders[website_session_id]))
			VAR grossRev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			VAR cogs = CALCULATE(SUM(order_items[cogs_usd]), TREATAS(sid, orders[website_session_id]))
			VAR grossProfit = grossRev - cogs
			VAR isCashBasis = SELECTEDVALUE(_Param_DateBasis[BasisID], 1) = 2
			VAR totalRefunds =
				IF(
					isCashBasis,
					CALCULATE(SUM(order_item_refunds[refund_amount_usd])),
					CALCULATE(SUM(order_item_refunds[refund_amount_usd]), TREATAS(oItems, order_item_refunds[order_item_id]))
				)
			VAR netProfit = grossProfit - totalRefunds
			VAR step = SELECTEDVALUE(_Dim_MarginBridge[StepID], 1)
			RETURN
				SWITCH(
					step,
					1, 0,
					2, grossProfit,
					3, 0,
					4, netProfit,
					5, 0,
					0
				)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 08 Page 6 - Financial\Margin Bridge
		lineageTag: ec80cd7c-ba64-4407-85aa-8ae510f0cf13

	measure 'Bridge Label' =
			VAR val = [Bridge Amount]
			VAR step = SELECTEDVALUE(_Dim_MarginBridge[StepID], 1)
			VAR prefix = IF(step = 2 || step = 4, "-$", "$")
			RETURN
				IF(
					ISBLANK(val),
					BLANK(),
					IF(
						val >= 1000000,
						prefix & FORMAT(val / 1000000, "0.00") & "M",
						prefix & FORMAT(val / 1000, "#,0") & "K"
					)
				)
		displayFolder: 08 Page 6 - Financial\Margin Bridge
		lineageTag: 03818bbc-71eb-4de1-aa40-7298eeb35164

	measure 'Bridge Addition' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR oItems = CALCULATETABLE(VALUES(order_items[order_item_id]), TREATAS(sid, orders[website_session_id]))
			VAR grossRev = CALCULATE(SUM(order_items[price_usd]), TREATAS(sid, orders[website_session_id]))
			VAR cogs = CALCULATE(SUM(order_items[cogs_usd]), TREATAS(sid, orders[website_session_id]))
			VAR grossProfit = grossRev - cogs
			VAR isCashBasis = SELECTEDVALUE(_Param_DateBasis[BasisID], 1) = 2
			VAR totalRefunds =
				IF(
					isCashBasis,
					CALCULATE(SUM(order_item_refunds[refund_amount_usd])),
					CALCULATE(SUM(order_item_refunds[refund_amount_usd]), TREATAS(oItems, order_item_refunds[order_item_id]))
				)
			VAR netProfit = grossProfit - totalRefunds
			VAR step = SELECTEDVALUE(_Dim_MarginBridge[StepID], 1)
			RETURN
				SWITCH(
					step,
					1, grossRev,
					3, grossProfit,
					5, netProfit,
					BLANK()
				)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 08 Page 6 - Financial\Margin Bridge
		lineageTag: 44993c5d-b8b1-438a-9a72-cc21d167f6c2

	measure 'Bridge Deduction' =
			VAR sid = CALCULATETABLE(VALUES(website_sessions[website_session_id]))
			VAR oItems = CALCULATETABLE(VALUES(order_items[order_item_id]), TREATAS(sid, orders[website_session_id]))
			VAR cogs = CALCULATE(SUM(order_items[cogs_usd]), TREATAS(sid, orders[website_session_id]))
			VAR isCashBasis = SELECTEDVALUE(_Param_DateBasis[BasisID], 1) = 2
			VAR totalRefunds =
				IF(
					isCashBasis,
					CALCULATE(SUM(order_item_refunds[refund_amount_usd])),
					CALCULATE(SUM(order_item_refunds[refund_amount_usd]), TREATAS(oItems, order_item_refunds[order_item_id]))
				)
			VAR step = SELECTEDVALUE(_Dim_MarginBridge[StepID], 1)
