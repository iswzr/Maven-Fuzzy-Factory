	measure 'Page Title P2' = ```
			
			VAR SelectedDim = 
			    IF(
			        ISFILTERED('_Param_Dim'[DimensionName]), 
			        MAX('_Param_Dim'[DimensionName]), 
			        "Marketing Channel"
			    )
			VAR DimLabel = 
			    IF(
			        SelectedDim = "Channel" || SelectedDim = "Marketing Channel", 
			        "Marketing Channel", 
			        SelectedDim
			    )
			RETURN
			    "Acquisition " & UNICHAR(183) & " " &
			    IF(
			        ISFILTERED(Dim_Date[Year]), 
			        SELECTEDVALUE(Dim_Date[Year], "multi-year"), 
			        "2012" & UNICHAR(8211) & "2015"
			    )
			    & " " & UNICHAR(183) & " grouped by " & DimLabel
			```
