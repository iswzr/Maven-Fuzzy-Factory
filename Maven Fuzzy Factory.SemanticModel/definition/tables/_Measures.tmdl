	measure 'Unpaid Sessions' = CALCULATE([Total Sessions], KEEPFILTERS(website_sessions[Traffic Type] IN {"Organic", "Direct"}))
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition
