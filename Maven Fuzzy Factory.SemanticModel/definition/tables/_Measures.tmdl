	measure 'VIZ-06 ORDERS' =
			VAR VariantName = SELECTEDVALUE(_Dim_BillingVariant[Billing Variant])
			VAR b_sessions =
				CALCULATETABLE(
					VALUES(website_pageviews[website_session_id]),
					website_pageviews[pageview_url] = VariantName
				)
			RETURN
				CALCULATE([Total Orders], TREATAS(b_sessions, orders[website_session_id]))
		formatString: #,0
