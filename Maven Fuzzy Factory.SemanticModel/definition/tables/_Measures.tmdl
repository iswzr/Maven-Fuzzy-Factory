	measure 'Header P2 HTML' =
			VAR sess = [Total Sessions]
			VAR unpPct = [Unpaid Session %]
			VAR unpRev = [Unpaid Revenue]
			VAR unpSess = [Unpaid Sessions]
			VAR cvr = [Conversion Rate %]
			VAR mobPct = [Mobile Traffic %]
			VAR mobOrdPct = [Mobile Order %]
			VAR cvrDesk = [CVR Desktop]
			VAR cvrMob = [CVR Mobile]
			
			VAR unpPctStr = FORMAT(unpPct, "0.0%")
			VAR cvrStr = FORMAT(cvr, "0.00%")
			VAR sessStr = FORMAT(sess, "#,0")
			VAR unpRevStr = IF(unpRev >= 1000000, "$" & FORMAT(unpRev / 1000000, "0.00") & "M", "$" & FORMAT(unpRev / 1000, "#,0") & "K")
			VAR unpSessStr = FORMAT(unpSess, "#,0")
			VAR mobPctStr = FORMAT(mobPct, "0.0%")
			VAR mobOrdStr = FORMAT(mobOrdPct, "0.0%")
			VAR cvrDeskStr = FORMAT(cvrDesk, "0.00%")
			VAR cvrMobStr = FORMAT(cvrMob, "0.00%")
			
			VAR YearPart =
				IF(
					ISFILTERED(Dim_Date[Year]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#4F46E5;font-weight:700'>" & SELECTEDVALUE(Dim_Date[Year], "Multi-Year") & "</span>",
					""
				)
			VAR DimPart =
				IF(
					ISFILTERED('_Param_Dim'[DimensionName]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#0284C7;font-weight:700'>" & SELECTEDVALUE('_Param_Dim'[DimensionName]) & "</span>",
					""
				)
			VAR DevicePart =
				IF(
					ISFILTERED(website_sessions[Device]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#D97706;font-weight:700'>" & SELECTEDVALUE(website_sessions[Device], "All Devices") & "</span>",
					""
				)
			VAR TrafficPart =
				IF(
					ISFILTERED(website_sessions[Traffic Type]),
					" <span style='color:#CBD5E1'>&bull;</span> <span style='color:#1D4ED8;font-weight:700'>" & SELECTEDVALUE(website_sessions[Traffic Type], "All Traffic") & "</span>",
					""
				)
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden; background: transparent;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  .hdr-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; padding: 2px 4px; }
			  .hdr-title { font-size: 22px; font-weight: 800; color: #0F172A; letter-spacing: -0.4px; line-height: 1.15; margin-bottom: 3px; }
			  .hdr-sub { font-size: 11.5px; color: #475569; font-weight: 500; }
			</style>
			<div class='hdr-wrap'>
			  <div class='hdr-title'>Acquisition <span style='color:#CBD5E1'>&bull;</span> <span style='color:#0D9488;font-weight:800'>" & unpPctStr & "</span> <span style='font-size:16px;font-weight:500;color:#64748B'>unpaid share</span> <span style='color:#CBD5E1'>&bull;</span> <span style='color:#1D4ED8;font-weight:800'>" & cvrStr & "</span> <span style='font-size:16px;font-weight:500;color:#64748B'>CVR</span>" & YearPart & DimPart & DevicePart & TrafficPart & "</div>
			  <div class='hdr-sub'>" & sessStr & " total sessions (" & unpSessStr & " unpaid) &bull; " & unpRevStr & " unpaid revenue &bull; " & mobPctStr & " mobile traffic (" & mobOrdStr & " orders) &bull; Desktop " & cvrDeskStr & " vs Mobile " & cvrMobStr & " &bull; data through 19 Mar 2015</div>
			</div>"
		displayFolder: 04 Page 2 - Acquisition
		lineageTag: 15409b23-1d64-47c5-8bc7-cbcb4f4a4c19

	measure 'KPI Strip P2 HTML' =
			VAR sess = [Total Sessions]
			VAR unpSess = [Unpaid Sessions]
			VAR unpPct = [Unpaid Session %]
			VAR unpRev = [Unpaid Revenue]
			VAR mobPct = [Mobile Traffic %]
			VAR mobOrdPct = [Mobile Order %]
			VAR cvrDesk = [CVR Desktop]
			VAR cvrMob = [CVR Mobile]
			VAR cvrRatio = DIVIDE(cvrDesk, cvrMob, 0)
			
			VAR sessStr = FORMAT(sess, "#,0")
			VAR unpPctStr = IF(ISBLANK(unpPct) || unpPct = 0, "0.0%", FORMAT(unpPct, "0.0%"))
			VAR unpSessStr = IF(ISBLANK(unpSess) || unpSess = 0, "0", FORMAT(unpSess, "#,0"))
			VAR unpRevStr = IF(ISBLANK(unpRev) || unpRev = 0, "$0", IF(unpRev >= 1000000, "$" & FORMAT(unpRev / 1000000, "0.00") & "M", IF(unpRev >= 1000, "$" & FORMAT(unpRev / 1000, "0.0") & "K", "$" & FORMAT(unpRev, "#,0"))))
			VAR mobPctStr = IF(ISBLANK(mobPct) || mobPct = 0, "0.0%", FORMAT(mobPct, "0.0%"))
			VAR mobOrdStr = IF(ISBLANK(mobOrdPct) || mobOrdPct = 0, "0.0%", FORMAT(mobOrdPct, "0.0%"))
			VAR cvrDeskStr = IF(ISBLANK(cvrDesk) || cvrDesk = 0, "0.00%", FORMAT(cvrDesk, "0.00%"))
			VAR cvrMobStr = IF(ISBLANK(cvrMob) || cvrMob = 0, "0.00%", FORMAT(cvrMob, "0.00%"))
			VAR cvrRatioStr = IF(ISBLANK(cvrRatio) || cvrRatio = 0, "0.0x", FORMAT(cvrRatio, "0.0") & "x")
			
			RETURN
			"<style>
			  * { box-sizing: border-box; margin: 0; padding: 0; }
			  html, body { width: 100%; height: 100%; overflow: hidden !important; background: transparent !important;
			    font-family: 'Segoe UI Variable', 'Segoe UI', -apple-system, sans-serif; user-select: none; }
			  ::-webkit-scrollbar { display: none !important; width: 0 !important; height: 0 !important; }
			  .kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; width: 100%; height: 100%; overflow: hidden; }
			  .kpi-card {
			    position: relative; overflow: hidden; min-width: 0; height: 100%;
			    padding: 10px 14px 8px 14px; border-radius: 8px;
			    display: flex; align-items: center; justify-content: space-between;
			    background: #FFFFFF;
			    border: 1px solid #CBD5E1;
			    border-top: 3px solid var(--acc);
			    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
			    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
			  }
			  .kpi-card:hover { border-color: var(--acc); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1); }
			  .kpi-txt { display:flex; flex-direction:column; justify-content:center; min-width:0; }
			  .kpi-label { font-size:10px; color:#475569; font-weight:700; text-transform:uppercase;
			    letter-spacing:0.8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-value { font-size: clamp(22px, 2.3vw, 31px); font-weight:800; color:#0F172A; line-height:1.05;
			    letter-spacing:-.8px; font-variant-numeric:tabular-nums; white-space:nowrap;
			    overflow:hidden; text-overflow:ellipsis; margin:4px 0 2px; }
			  .kpi-sub { max-width:100%; font-size:10px; font-weight:600; color:#64748B;
			    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
			  .kpi-ico { flex: none; width: 38px; height: 38px; border-radius: 8px;
			    display: flex; align-items: center; justify-content: center; color: var(--acc);
			    background: var(--soft);
			    border: 1px solid var(--line); }
			  .kpi-ico svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2;
			    stroke-linecap: round; stroke-linejoin: round; }
			  @media (max-width: 1400px) {
			    .kpi-ico { width: 30px; height: 30px; border-radius: 6px; }
			    .kpi-ico svg { width: 15px; height: 15px; }
			  }
			</style>
			<div class='kpi-grid'>
			  <div class='kpi-card' style='--acc:#1D4ED8;--soft:#EFF6FF;--line:#BFDBFE;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>TOTAL SESSIONS</div>
			      <div class='kpi-value'>" & sessStr & "</div>
			      <div class='kpi-sub'>All sources &bull; 3-Yr</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#059669;--soft:#D1FAE5;--line:#A7F3D0;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>UNPAID SESSIONS %</div>
			      <div class='kpi-value'>" & unpPctStr & "</div>
			      <div class='kpi-sub'>" & unpSessStr & " free traffic (" & unpRevStr & ")</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#D97706;--soft:#FEF3C7;--line:#FDE68A;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>MOBILE TRAFFIC %</div>
			      <div class='kpi-value'>" & mobPctStr & "</div>
			      <div class='kpi-sub'>" & mobOrdStr & " of total orders</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><rect x='5' y='2' width='14' height='20' rx='2'/><line x1='12' y1='18' x2='12.01' y2='18'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#4F46E5;--soft:#EEF2FF;--line:#C7D2FE;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>DESKTOP CVR</div>
			      <div class='kpi-value'>" & cvrDeskStr & "</div>
			      <div class='kpi-sub'>" & cvrRatioStr & " mobile conversion</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><rect x='2' y='3' width='20' height='14' rx='2'/><line x1='8' y1='21' x2='16' y2='21'/><line x1='12' y1='17' x2='12' y2='21'/></svg></div>
			  </div>
			  <div class='kpi-card' style='--acc:#0D9488;--soft:#CCFBF1;--line:#99F6E4;'>
			    <div class='kpi-txt'>
			      <div class='kpi-label'>MOBILE CVR</div>
			      <div class='kpi-value'>" & cvrMobStr & "</div>
			      <div class='kpi-sub'>High-volume optimization lever</div>
			    </div>
			    <div class='kpi-ico'><svg viewBox='0 0 24 24'><path d='M13 2L3 14h9l-1 8 10-12h-9l1-8z'/></svg></div>
			  </div>
			</div>"
		displayFolder: 04 Page 2 - Acquisition
		lineageTag: 045956e6-807a-48a0-a554-34b3caf6b4ff

	measure 'Channel Orders' = [Matrix Orders]
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: e996cf63-4ee5-457c-89f8-0db4c5af2cf9

	measure 'Channel Revenue' = [Matrix Revenue]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: 70108808-f46a-436c-949e-b29f487bf3ef

	measure 'Channel CVR' = [Matrix CVR %]
		formatString: 0.00%
		displayFolder: 04 Page 2 - Acquisition\Visual 6 - Dynamic Matrix
		lineageTag: b21c9b4f-b7bc-4b8f-89ea-b65c620a7837

	measure 'Brand Sessions' = CALCULATE([Total Sessions], website_sessions[utm_campaign] = "brand")
		formatString: #,0
		displayFolder: 04 Page 2 - Acquisition
