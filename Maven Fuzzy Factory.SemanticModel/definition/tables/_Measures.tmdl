	measure 'Refund Reduction Value' =
			IF(
				ISFILTERED(_Param_Refund_Tuning[Label]),
				SELECTEDVALUE(_Param_Refund_Tuning[Value], 0.20),
				VAR p = SELECTEDVALUE(_Param_ScenarioPreset[Preset], "Custom sliders")
				RETURN
					SWITCH(
						p,
						"Conservative", 0.10,
						"Base", 0.20,
						"Stretch", 0.35,
						0.20
					)
