	partition order_items = m
		mode: import
		source =
				let
				  LocalPath = if Text.EndsWith(LocalFolderPath, "\") or Text.EndsWith(LocalFolderPath, "/") then LocalFolderPath else LocalFolderPath & "\",
				  SourceBinary = if DataSourceType = "GitHub" then Web.Contents("https://raw.githubusercontent.com/iswzr/Maven-Fuzzy-Factory/main/order_items.csv") else File.Contents(LocalPath & "order_items.csv"),
				  Source = Csv.Document(SourceBinary, [Delimiter = ",", Columns = 7, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"order_item_id", Int64.Type}, {"created_at", type datetime}, {"order_id", Int64.Type}, {"product_id", Int64.Type}, {"is_primary_item", Int64.Type}, {"price_usd", type number}, {"cogs_usd", type number}}),
				  #"Added Order Date" = Table.AddColumn(#"Changed column type", "Order Date", each DateTime.Date([created_at]), type date),
				  #"Added Item Role" = Table.AddColumn(#"Added Order Date", "Item Role", each if [is_primary_item] = 1 then "Primary Item" else "Cross-Sell Item", type text),
				  #"Added Margin $" = Table.AddColumn(#"Added Item Role", "Margin $", each [price_usd] - [cogs_usd], type number),
				  #"Added Margin %" = Table.AddColumn(#"Added Margin $", "Margin %", each if [price_usd] = 0 or [price_usd] = null then 0 else ([price_usd] - [cogs_usd]) / [price_usd], type number)
				in
				  #"Added Margin %"

	annotation PBI_ResultType = Table

