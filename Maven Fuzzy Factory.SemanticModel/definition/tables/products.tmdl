		sourceColumn: Short Name
		sortByColumn: product_id

		annotation SummarizationSetBy = Automatic

	partition products = m
		mode: import
		source =
				let
				  LocalPath = if Text.EndsWith(LocalFolderPath, "\") or Text.EndsWith(LocalFolderPath, "/") then LocalFolderPath else LocalFolderPath & "\",
				  SourceBinary = if DataSourceType = "GitHub" then Web.Contents("https://raw.githubusercontent.com/iswzr/Maven-Fuzzy-Factory/main/data/products.csv") else File.Contents(LocalPath & "data\products.csv"),
				  Source = Csv.Document(SourceBinary, [Delimiter = ",", Columns = 3, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"product_id", Int64.Type}, {"created_at", type datetime}, {"product_name", type text}}),
				  #"Added Retail Price" = Table.AddColumn(#"Changed column type", "Retail Price", each if [product_id] = 1 then 49.99 else if [product_id] = 2 then 59.99 else if [product_id] = 3 then 45.99 else 29.99, type number),
				  #"Added Unit COGS" = Table.AddColumn(#"Added Retail Price", "Unit COGS", each if [product_id] = 1 then 19.49 else if [product_id] = 2 then 22.49 else if [product_id] = 3 then 14.49 else 9.49, type number),
				  #"Added Margin $" = Table.AddColumn(#"Added Unit COGS", "Margin $", each [Retail Price] - [Unit COGS], type number),
				  #"Added Margin %" = Table.AddColumn(#"Added Margin $", "Margin %", each [#"Margin $"] / [Retail Price], type number),
				  #"Added Product Role" = Table.AddColumn(#"Added Margin %", "Product Role", each if [product_id] = 1 then "Flagship Launch Bear" else if [product_id] = 2 then "Premium Valentine's" else if [product_id] = 3 then "Birthday Gift" else "Cross-Sell Add-on", type text),
				  #"Added Short Name" = Table.AddColumn(#"Added Product Role", "Short Name", each if [product_id] = 1 then "Mr. Fuzzy" else if [product_id] = 2 then "Love Bear" else if [product_id] = 3 then "Sugar Panda" else "Mini Bear", type text)
				in
				  #"Added Short Name"

	annotation PBI_ResultType = Table

