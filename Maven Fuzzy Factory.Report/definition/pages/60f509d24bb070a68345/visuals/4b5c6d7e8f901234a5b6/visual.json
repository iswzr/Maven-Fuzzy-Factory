            \"gridColor\": \"#1A2342\", \"gridDash\": [3, 3], \"labelFontSize\": 10, \"labelPadding\": 8}},\n        \"x2\": {\"field\": \"maxEnd\"}\n      }\n    },\n    {\n      \"name\": \"gantt_pills\",\n      \"mark\": {\"type\": \"bar\", \"cornerRadius\": 8, \"height\": {\"band\": 0.62}, \"opacity\": 0.95, \"strokeWidth\": 0},\n      \"encoding\": {\n        \"x\": {\"field\": \"VIZ-04 START DATE\", \"type\": \"temporal\"},\n        \"x2\": {\"field\": \"VIZ-04 END DATE\"},\n        \"color\": {\"field\": \"VIZ-04 COLOR\", \"type\": \"nominal\", \"scale\": null, \"legend\": null},\n        \"stroke\": {\"condition\": {\"test\": \"datum.cvr === datum.maxCvr\", \"value\": \"#FFFFFF\"}, \"value\": null},\n        \"strokeWidth\": {\"condition\": {\"test\": \"datum.cvr === datum.maxCvr\", \"value\": 1.5}, \"value\": 0},\n        \"tooltip\": [\n          {\"field\": \"Landing Page\", \"title\": \"Landing Page\"},\n          {\"field\": \"VIZ-04 START DATE\", \"title\": \"Launch\", \"type\": \"temporal\", \"format\": \"%b %d, %Y\"},\n          {\"field\": \"VIZ-04 END DATE\", \"title\": \"Retired\", \"type\": \"temporal\", \"format\": \"%b %d, %Y\"},\n          {\"field\": \"days\", \"title\": \"Active (days)\", \"type\": \"quantitative\", \"format\": \",d\"},\n          {\"field\": \"VIZ-04 CVR LABEL\", \"title\": \"CVR\"},\n          {\"field\": \"VIZ-04 SESSIONS\", \"title\": \"Sessions\", \"type\": \"quantitative\", \"format\": \",d\"}\n        ]\n      }\n    },\n    {\n      \"name\": \"cvr_labels\",\n      \"mark\": {\"type\": \"text\", \"align\": \"center\", \"baseline\": \"middle\", \"fontSize\": 12, \"fontWeight\": 800, \"color\": \"#0B1020\"},\n      \"encoding\": {\n        \"x\": {\"field\": \"VIZ-04 MID DATE\", \"type\": \"temporal\"},\n        \"text\": {\"field\": \"lbl\"}\n      }\n    }\n  ]\n}'"
