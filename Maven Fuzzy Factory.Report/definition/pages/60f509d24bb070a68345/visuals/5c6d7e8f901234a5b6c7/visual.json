            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\"name\": \"dataset\"},\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"padding\": {\"left\": 0, \"right\": 8, \"top\": 4, \"bottom\": 0},\n  \"autosize\": {\"type\": \"fit\", \"contains\": \"padding\"},\n  \"config\": {\n    \"view\": {\"stroke\": null},\n    \"font\": \"Segoe UI\",\n    \"background\": \"transparent\"\n  },\n  \"transform\": [\n    {\"calculate\": \"parseFloat(datum[''VIZ-05 DROP OFF LABEL''])\", \"as\": \"drop\"},\n    {\"joinaggregate\": [{\"op\": \"max\", \"field\": \"drop\", \"as\": \"maxDrop\"}]},\n    {\"calculate\": \"datum.drop === datum.maxDrop\", \"as\": \"isWorst\"}\n  ],\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"StepName\", \"type\": \"nominal\",\n      \"sort\": {\"field\": \"StepNumber\"},\n      \"scale\": {\"paddingInner\": 0.22, \"paddingOuter\": 0.05},\n      \"axis\": {\"title\": null, \"domain\": false, \"ticks\": false, \"labelColor\": \"#E6E9F2\",\n               \"labelFontSize\": 12, \"labelFontWeight\": 500, \"labelPadding\": 12}\n    }\n  },\n  \"layer\": [\n    {\n      \"name\": \"track\",\n      \"mark\": {\"type\": \"bar\", \"cornerRadius\": 8, \"height\": {\"band\": 0.8}, \"color\": \"#141C38\", \"opacity\": 0.7},\n      \"encoding\": {\n        \"x\": {\"datum\": 1.0, \"type\": \"quantitative\", \"scale\": {\"domain\": [0, 1.62]}, \"axis\": null},\n        \"x2\": {\"datum\": 0}\n      }\n    },\n    {\n      \"name\": \"funnel_bars\",\n      \"mark\": {\"type\": \"bar\", \"cornerRadius\": 8, \"height\": {\"band\": 0.8}},\n      \"encoding\": {\n        \"x\": {\"field\": \"VIZ-05 SESSIONS % OF TOTAL\", \"type\": \"quantitative\", \"axis\": null},\n        \"color\": {\"field\": \"VIZ-05 BAR COLOR\", \"type\": \"nominal\", \"scale\": null, \"legend\": null},\n        \"stroke\": {\"condition\": {\"test\": \"datum.isWorst\", \"value\": \"#FFFFFF\"}, \"value\": null},\n        \"strokeWidth\": {\"condition\": {\"test\": \"datum.isWorst\", \"value\": 1.5}, \"value\": 0},\n        \"tooltip\": [\n          {\"field\": \"StepName\", \"title\": \"Funnel Step\"},\n          {\"field\": \"VIZ-05 SESSIONS\", \"title\": \"Sessions\", \"type\": \"quantitative\", \"format\": \",d\"},\n          {\"field\": \"VIZ-05 STEP CVR LABEL\", \"title\": \"Step Conversion\"},\n          {\"field\": \"VIZ-05 DROP OFF LABEL\", \"title\": \"Drop-off\"},\n          {\"field\": \"VIZ-05 SESSIONS % OF TOTAL\", \"title\": \"% of Sessions\", \"type\": \"quantitative\", \"format\": \".1%\"}\n        ]\n      }\n    },\n    {\n      \"name\": \"in_bar_pct\",\n      \"mark\": {\"type\": \"text\", \"align\": \"right\", \"baseline\": \"middle\", \"dx\": -8, \"fontSize\": 11, \"fontWeight\": 700, \"color\": \"#0B1020\"},\n      \"transform\": [{\"filter\": \"datum[''VIZ-05 SESSIONS % OF TOTAL''] > 0.2\"}],\n      \"encoding\": {\n        \"x\": {\"field\": \"VIZ-05 SESSIONS % OF TOTAL\", \"type\": \"quantitative\"},\n        \"text\": {\"field\": \"VIZ-05 SESSIONS % OF TOTAL\", \"type\": \"quantitative\", \"format\": \".0%\"}\n      }\n    },\n    {\n      \"name\": \"session_volume_labels\",\n      \"mark\": {\"type\": \"text\", \"align\": \"right\", \"baseline\": \"middle\", \"fontSize\": 12, \"fontWeight\": 700, \"color\": \"#E6E9F2\"},\n      \"encoding\": {\n        \"x\": {\"datum\": 1.28, \"type\": \"quantitative\"},\n        \"text\": {\"field\": \"VIZ-05 SESSIONS LABEL\"}\n      }\n    },\n    {\n      \"name\": \"cvr_labels\",\n      \"mark\": {\"type\": \"text\", \"align\": \"right\", \"baseline\": \"middle\", \"fontSize\": 12, \"fontWeight\": 600},\n      \"encoding\": {\n        \"x\": {\"datum\": 1.6, \"type\": \"quantitative\"},\n        \"color\": {\"field\": \"VIZ-05 CVR COLOR\", \"type\": \"nominal\", \"scale\": null, \"legend\": null},\n        \"text\": {\"field\": \"VIZ-05 STEP CVR LABEL\"}\n      }\n    }\n  ]\n}'"
